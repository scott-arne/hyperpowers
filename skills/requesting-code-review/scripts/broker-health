#!/usr/bin/env bash
# broker-health <state-dir> — classify one repo's codex-plugin-cc broker record.
#
# stdout: {"status":"healthy|dead|absent|unknown","reason":"..."}
#   healthy - live listener on the broker socket (definitive, record-specific probe)
#             OR socket exists + pid alive + verified broker identity (fallback)
#   dead    - positive evidence of death: sessionDir gone, socket gone, pid not alive,
#             connection refused on existing socket, or pid reused by non-broker process
#   absent  - no broker.json (normal before first companion call)
#   unknown - unparseable/unexpected schema (hands-off: never quarantined)
#
# Primary check: unix-socket connect probe (record-specific, pid-independent).
#   - Connection succeeds = healthy (live listener on THIS socket).
#   - Connection refused on existing socket = dead (positive death evidence).
#   - Sandbox denial / timeout = unverifiable -> fall back to pid checks.
#
# Fallback: pid alive + process identity via ps (when probe is unverifiable).
#
# Exit 0 for every determinate answer; exit 2 for usage/internal errors.
# Socket presence is an existence check (-e), not -S: a purged or missing
# path is the death signal either way, and plain-file fixtures stay hermetic.
#
# Environment:
#   HYPERPOWERS_BROKER_CMD_PATTERN - extended regex matching broker process
#                                    command lines (default: codex|app-server-broker|cxc-)
set -uo pipefail

dir="${1:-}"
[ -n "$dir" ] || { echo "usage: broker-health <state-dir>" >&2; exit 2; }
command -v node >/dev/null 2>&1 || { echo "broker-health: node not found" >&2; exit 2; }

emit() { printf '{"status":"%s","reason":"%s"}\n' "$1" "$2"; exit 0; }

bj="$dir/broker.json"
[ -f "$bj" ] || emit absent "no broker.json"

# Extract the three fields we need; anything unexpected -> unknown (hands-off).
parsed="$(node -e '
  try {
    const d = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    const ep = typeof d.endpoint === "string" ? d.endpoint : "";
    const sock = ep.startsWith("unix:") ? ep.slice(5) : "";
    const pid = Number.isInteger(d.pid) && d.pid > 0 ? d.pid : 0;
    const sdir = typeof d.sessionDir === "string" ? d.sessionDir : "";
    if (!sock || !pid || !sdir) process.exit(3);
    process.stdout.write(sock + "\n" + pid + "\n" + sdir);
  } catch (e) { process.exit(3); }
' "$bj" 2>/dev/null)" || emit unknown "unparseable or unexpected broker.json schema"

sock="$(printf '%s\n' "$parsed" | sed -n 1p)"
pid="$(printf '%s\n' "$parsed" | sed -n 2p)"
sdir="$(printf '%s\n' "$parsed" | sed -n 3p)"

[ -d "$sdir" ] || emit dead "sessionDir missing"
[ -e "$sock" ] || emit dead "socket missing"

# Definitive, record-specific probe: a live listener on THIS record's
# endpoint is health no matter which pid owns it; connection refused on an
# existing socket file is positive evidence of death. Sandbox contexts may
# deny unix-socket connects (EPERM/EACCES) — then fall back to pid checks.
probe="$(node -e '
  const net = require("net");
  const sock = process.argv[1];
  const done = (v) => { process.stdout.write(v); process.exit(0); };
  const c = net.connect(sock);
  const t = setTimeout(() => { c.destroy(); done("unverifiable"); }, 500);
  c.on("connect", () => { clearTimeout(t); c.destroy(); done("live"); });
  c.on("error", (e) => {
    clearTimeout(t);
    if (e && (e.code === "ECONNREFUSED" || e.code === "ENOENT")) done("refused");
    else done("unverifiable");
  });
' "$sock" 2>/dev/null)" || probe="unverifiable"

case "$probe" in
  live)    emit healthy "live listener on broker socket" ;;
  refused) emit dead "socket file present but no listener" ;;
esac
# unverifiable (sandbox denial, timeout) -> fall through to pid checks

kill -0 "$pid" 2>/dev/null || emit dead "pid $pid not alive"

# Verify process identity: pid must belong to a broker process, not a reused PID.
cmd="$(ps -p "$pid" -o command= 2>/dev/null)"
if [ -z "$cmd" ]; then
  # ps failed or returned nothing while kill -0 succeeded: sandboxed/denied context.
  emit healthy "socket present and pid $pid alive (identity unverified)"
fi

# ps succeeded: match command against broker signature.
pattern="${HYPERPOWERS_BROKER_CMD_PATTERN:-codex|app-server-broker|cxc-}"
if printf '%s' "$cmd" | grep -Eq "$pattern"; then
  emit healthy "socket present and pid $pid is a live broker process"
else
  emit dead "pid $pid reused by non-broker process"
fi
