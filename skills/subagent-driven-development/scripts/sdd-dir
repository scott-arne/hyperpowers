#!/usr/bin/env bash
# Emit the SDD workspace for a plan: the directory holding its ledger, briefs,
# reports, review packages and claims. Single source of truth for task-brief,
# review-package, sdd-state and the SKILL.md ledger guidance.
#
# With a plan argument the workspace lives inside the repository's state
# checkout, a linked worktree of the orphan branch hyperpowers/state kept
# once per clone under the user cache (sdd-common.sh, hp_ensure_checkout):
#   ${XDG_CACHE_HOME:-~/.cache}/hyperpowers/state/<key>/plans/<slug>-<hash8>/
# <key> hashes the clone's physical common git directory, so every worktree
# of the clone shares the checkout, and the workspace name derives from the
# plan's repo-relative path, so it is the same on every host. When the
# branch backend is unavailable (git worktree add failed, for example under
# a sandbox) the workspace falls back to the plain cache at
#   ${XDG_CACHE_HOME:-~/.cache}/hyperpowers/sdd/<key>/plans/<slug>-<hash8>/
# and does not travel. Without a plan argument the plain-cache root
# sdd/<key> is printed: the repository-level scratch other skills use.
#
# Why not <git-dir>/sdd: .git/ is a hardcoded protected path in Claude Code;
# writes under it prompt in every permission mode. Why not the working tree:
# the dossier must survive git clean, stash and checkout, and never be
# committed by accident. Design:
# docs/hyperpowers/specs/2026-10-20-portable-sdd-dossiers-design.md.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HP_PROG=sdd-dir
# shellcheck source=sdd-common.sh
. "$SCRIPT_DIR/sdd-common.sh"

plan_dir=""
if [ $# -ge 1 ] && [ -n "${1:-}" ]; then
  plan=$1
  [ -f "$plan" ] || {
    echo "sdd-dir: plan file does not exist: $plan" >&2
    exit 2
  }
  plan_dir=$(cd "$(dirname "$plan")" 2>/dev/null && pwd -P) || {
    echo "sdd-dir: plan file directory does not exist: $plan" >&2
    exit 2
  }
  git -C "$plan_dir" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "sdd-dir: plan file directory is not inside a git repository: $plan" >&2
    exit 2
  }
else
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "sdd-dir: not inside a git repository" >&2
    exit 2
  }
fi
# hp_materialize_plain publishes through node and hp_stamp_ok fingerprints
# the remote's URL with it, both on the path below, so a missing node is a
# refusal here rather than a creation that stops halfway.
command -v node >/dev/null 2>&1 || { echo "sdd-dir: node not found" >&2; exit 2; }

base="$(hp_cache_root)/sdd"

# Reclaim plain-cache roots idle for 14+ days, never the given key's. Left
# alone the cache grows one root per repository instance forever, and editors
# that follow agent-touched files hold a watcher per scratch file. Reclaim is
# two-phase, because a writer on the previous plugin that still holds a kept
# import copy's ledger open cannot be excluded: nothing is deleted on the
# pass that finds a root idle. A root passes under three names. `<key>` is
# live. `<key>.claiming-<pid>` is a claim in progress: the pass renames the
# root there (atomic) and re-checks the staged tree, which still carries the
# mtimes it had — an import that got in first touches the root before it
# renames its source aside, so a fresh root, a descendant written during the
# window, or its backup (`plans/*.importing-*`) puts the tree back under
# `<key>`. Only then is the tree touched, which restarts the clock, and
# renamed to `<key>.reclaiming-<pid>`: the stamp precedes that name, so no
# concurrent call ever reads a quarantine as having been quiet for its 14
# days. A `.claiming-*` left by a crash between the two renames is adopted
# on a later pass — touched and renamed to the `.reclaiming-` form — so the
# crashed claim still gets its quiet days. A later call deletes a
# `.reclaiming-*` root once nothing under it, the directory itself included,
# is newer than 14 days, after one more rename-aside and re-check. So a late
# append refreshes the tree and buys 14 more days, and a root another
# repository's call reclaimed by mistake is recoverable for 14 days under its
# `.reclaiming-*` name. A root is idle only when nothing under it is newer
# than 14 days either, so a kept import copy (`plans/*.imported-<UTC>-<pid>`)
# a slower session still appends to is never claimed. An import that arrives
# after a rename finds no root and fails cleanly with nothing lost. Best
# effort: pruning must never break the contract that stdout is the path.
reclaim_plain() {
  local r pid staged claimed gone
  for r in "$base"/*/; do
    r=${r%/}
    [ -d "$r" ] && [ ! -L "$r" ] || continue
    [ "${r##*/}" != "$1" ] || continue
    case "${r##*/}" in
      *.reclaiming-*)
        # Phase two: the copy a previous pass claimed, quiet ever since.
        ls -d "$r"/plans/*.importing-* >/dev/null 2>&1 && continue
        [ -z "$(find "$r" -mtime -14 2>/dev/null | head -n 1)" ] || continue
        gone="$r.gone-$$"
        if [ -e "$gone" ] || [ -L "$gone" ]; then continue; fi
        mv "$r" "$gone" 2>/dev/null || continue
        if [ -n "$(find "$gone" -mtime -14 2>/dev/null | head -n 1)" ] || ls -d "$gone"/plans/*.importing-* >/dev/null 2>&1; then
          # A session in the other repository can recreate <key> while this
          # pass walks the staged tree; BSD mv would nest the staged root
          # inside the new one, where no lookup finds it again.
          if [ -e "$r" ] || [ -L "$r" ]; then
            echo "sdd-dir: the cache root staged at $gone could not be put back at $r, which is occupied again; move it back by hand" >&2
          else
            mv "$gone" "$r" 2>/dev/null || echo "sdd-dir: the cache root staged at $gone could not be put back at $r; move it back by hand" >&2
          fi
          continue
        fi
        rm -rf "$gone" 2>/dev/null || true
        [ ! -e "$gone" ] || echo "sdd-dir: could not delete the reclaimed cache root at $gone" >&2
        ;;
      *.claiming-*)
        # A claim that crashed between its two renames: the tree was already
        # found idle and re-checked, so it is adopted as a quarantine with a
        # fresh stamp rather than re-examined. Only a claim whose owner is
        # gone is adopted: while that call runs, the tree is its to promote
        # or to put back for an importer that got in, and moving it would
        # take that choice away.
        pid=${r##*.claiming-}
        case "$pid" in ''|*[!0-9]*) continue ;; esac
        hp_pid_gone "$pid" || continue
        claimed="${r%.claiming-*}.reclaiming-$$"
        if [ -e "$claimed" ] || [ -L "$claimed" ]; then continue; fi
        touch "$r" 2>/dev/null || true
        mv "$r" "$claimed" 2>/dev/null || true
        ;;
      *)
        # Phase one: claim an idle root, delete nothing.
        ls -d "$r"/plans/*.importing-* >/dev/null 2>&1 && continue
        [ -n "$(find "$r" -maxdepth 0 -mtime +14 2>/dev/null)" ] || continue
        [ -z "$(find "$r" -mtime -14 2>/dev/null | head -n 1)" ] || continue
        staged="$r.claiming-$$"
        if [ -e "$staged" ] || [ -L "$staged" ]; then continue; fi
        mv "$r" "$staged" 2>/dev/null || continue
        if [ "${HYPERPOWERS_TEST_RECLAIM_RACE:-}" = "$r" ]; then
          # Test hook: an importer that touched the root and renamed its source
          # aside just before the claim.
          mkdir -p "$staged/plans/x.importing-1"; touch "$staged"
        elif [ "${HYPERPOWERS_TEST_RECLAIM_RACE:-}" = "touch:$r" ]; then
          # Test hook: the same importer one step earlier, the root touched
          # and its source not yet renamed aside.
          touch "$staged"
        elif [ "${HYPERPOWERS_TEST_RECLAIM_RACE:-}" = "occupy:$r" ]; then
          # Test hook: the same importer, and a session in the other
          # repository that recreated the live root while this pass walked
          # the staged tree.
          mkdir -p "$staged/plans/x.importing-1"; touch "$staged"
          mkdir -p "$r"; : > "$r/writer"
        fi
        # The staged tree still carries its own mtimes, so the re-check reads
        # the signals an importer leaves: a fresh root, a descendant written
        # during the window, or its backup.
        if [ -z "$(find "$staged" -maxdepth 0 -mtime +14 2>/dev/null)" ] || [ -n "$(find "$staged" -mindepth 1 -mtime -14 2>/dev/null | head -n 1)" ] || ls -d "$staged"/plans/*.importing-* >/dev/null 2>&1; then
          if [ -e "$r" ] || [ -L "$r" ]; then
            echo "sdd-dir: the cache root staged at $staged could not be put back at $r, which is occupied again; move it back by hand" >&2
          else
            mv "$staged" "$r" 2>/dev/null || echo "sdd-dir: the cache root staged at $staged could not be put back at $r; move it back by hand" >&2
          fi
          continue
        fi
        claimed="$r.reclaiming-$$"
        if [ -e "$claimed" ] || [ -L "$claimed" ]; then continue; fi
        # The stamp goes on before the name phase two acts on, so a
        # concurrent call cannot read this quarantine as an aged one.
        touch "$staged" 2>/dev/null || true
        mv "$staged" "$claimed" 2>/dev/null || true
        ;;
    esac
  done
}

if [ -z "$plan_dir" ]; then
  key=$(hp_key .)
  dir="$base/$key"
  mkdir -p "$dir"
  touch "$dir"
  reclaim_plain "$key"
  printf '%s\n' "$dir"
  exit 0
fi

key=$(hp_key "$plan_dir") || { echo "sdd-dir: could not derive the repository key for: $plan" >&2; exit 2; }
ws=$(hp_plan_ws_name "$plan") || { echo "sdd-dir: plan file must be a regular file inside the repository, not a symlink: $plan" >&2; exit 2; }
ensure=$(hp_ensure_checkout "$plan_dir") || exit 2
backend=${ensure%% *}
root=${ensure#* }
dir="$root/plans/$ws"
# A fetched branch can carry a symbolic link where the workspace or its
# parent should be; every path below follows links, so refuse first.
if ! hp_contained "$root" "plans/$ws"; then
  echo "sdd-dir: refusing to resolve a workspace through a symbolic link under $root; remove the link and run sdd-state sync" >&2
  exit 2
fi
# And inside it: Setup and the implementers write the ledger, the reports
# and the claims by path, so one link in the workspace would take those
# writes out of the cache.
refuse_ws_links() {
  local found
  [ -d "$dir" ] || return 0
  found=$(find "$dir" -type l 2>/dev/null) || found=""
  [ -n "$found" ] || return 0
  echo "sdd-dir: refusing to resolve a workspace that holds a symbolic link at ${found%%$'\n'*}; remove the link and run sdd-state sync" >&2
  return 2
}
refuse_ws_links || exit 2
# The workspace directory is created under the repository lock, and only
# when it is missing, so the branch-backend fast path takes no lock and an
# unlocked mkdir can never resurrect a path finish has just renamed aside.
# Writes under the plain backend take the same lock; a failed
# materialization leaves no half-built workspace.
if [ "$backend" = plain ] || [ ! -d "$dir" ]; then
  hp_lock "$plan_dir" || exit 2
  # The branch can move between the check above and the lock.
  if ! hp_contained "$root" "plans/$ws"; then
    hp_unlock
    echo "sdd-dir: refusing to resolve a workspace through a symbolic link under $root; remove the link and run sdd-state sync" >&2
    exit 2
  fi
  if [ "$backend" = plain ]; then
    # The plain root may not exist yet; touch alone would create a file.
    mkdir -p "$root" || { hp_unlock; exit 2; }
    touch "$root"
    rc=0; hp_materialize_plain "$plan_dir" "$ws" "$dir" || rc=$?
    if [ "$rc" -ne 0 ]; then
      hp_unlock
      # A refusal has already named itself; only a silent failure needs a line.
      [ "$rc" -ne 1 ] || echo "sdd-dir: could not materialize the branch workspace into the plain cache" >&2
      exit 2
    fi
  fi
  # A removal interrupted after its rename-aside left the dossier at
  # plans/.removing-<ws>-<pid>; it comes back before an empty workspace
  # could take its place.
  for t in "$root/plans/.removing-$ws-"*; do
    [ -d "$t" ] && [ ! -d "$dir" ] || continue
    mv "$t" "$dir" 2>/dev/null || true
  done
  mkdir -p "$dir" || { hp_unlock; exit 2; }
  # A materialized or restored workspace is checked once more under the
  # lock: it is a tree this host did not write.
  refuse_ws_links || { hp_unlock; exit 2; }
  hp_unlock
  [ "$backend" != plain ] || echo "sdd-dir: backend=plain for this repository; the dossier will not travel from this host" >&2
fi

# Pull a workspace an older plugin left in the plain cache into place. A
# failed import stops here: no caller may work in a workspace whose legacy
# ledger is still elsewhere. Import's stderr stays visible: it reports an
# abandoned or kept legacy copy there.
import_line=$(bash "$SCRIPT_DIR/sdd-state" import "$plan") || {
  echo "sdd-dir: importing a legacy workspace failed; run: sdd-state import $plan" >&2
  exit 2
}
# A skipped import is not a failure, but it leaves a legacy workspace whose
# ledger lines are not in the one this caller is about to work in: say so,
# because nothing else would.
case "$import_line" in
  status=skipped*) echo "sdd-dir: a legacy workspace was left where it is: $import_line" >&2 ;;
esac

# Keep the plan repository's plain root fresh: it holds pointers for other
# repositories and the no-argument scratch, and another repository's reclaim
# would otherwise take it after 14 idle days. The reclaim itself runs last,
# after the cwd key below has been touched, so a pointer-only key is never
# taken with it.
mkdir -p "$base/$key" 2>/dev/null || true
touch "$base/$key" 2>/dev/null || true

# A plan run from another repository's checkout: leave a pointer under the
# cwd's key in the plain cache, so the compaction notice finds the ledger
# without a state branch being created in the hosting repository.
if git rev-parse --git-dir >/dev/null 2>&1; then
  cwd_key=$(hp_key .)
  if [ "$cwd_key" != "$key" ]; then
    cwd_plans="$base/$cwd_key/plans"
    mkdir -p "$cwd_plans" 2>/dev/null || true
    touch "$base/$cwd_key" 2>/dev/null || true
    pointer="${cwd_plans}/${ws}+${key:0:8}"
    if [ ! -e "$pointer" ] || [ -L "$pointer" ]; then
      ln -sfn "$dir" "$pointer" 2>/dev/null || true
    fi
    # Dangling pointers left by finished workspaces are pruned; one whose
    # target an interrupted import renamed aside is kept for import to
    # recover, wherever hp_kept_copy_exists finds the copy. The pointer is
    # that import's only handle: pruning it here would leave the next import
    # nothing to find.
    for p in "$cwd_plans"/*; do
      [ -L "$p" ] && [ ! -e "$p" ] || continue
      t=$(readlink "$p")
      hp_kept_copy_exists "$t" && continue
      rm -f "$p" 2>/dev/null || true
    done
  fi
fi

reclaim_plain "$key"

printf '%s\n' "$dir"
