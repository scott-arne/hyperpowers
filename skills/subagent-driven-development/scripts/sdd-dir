#!/usr/bin/env bash
# Emit the SDD scratch directory for this repo instance, off any protected
# path. Single source of truth for task-brief, review-package, and the
# SKILL.md ledger guidance.
#
# Why not <git-dir>/sdd: .git/ is a hardcoded protected path in Claude Code.
# Writes under it prompt in every permission mode except bypassPermissions,
# and that check runs BEFORE permission rules and PreToolUse hooks — so
# neither an allow-glob nor a hook can suppress it. SDD is write-intensive,
# so that meant a prompt per scratch file. Relocating off .git/ lets the
# normal permission machinery cover the writes.
#
# The dir is keyed by a stable hash of the absolute git-dir. That preserves
# the two properties the old `git rev-parse --git-path sdd` idiom gave for
# free: per-repo-instance isolation, and per-worktree distinctness (linked
# worktrees have distinct absolute git-dirs). It lives under the user cache,
# so it is never inside the working tree and cannot be accidentally
# committed. Hashing uses `git hash-object` rather than shasum/sha256sum
# because the latter's name differs across platforms while git is already a
# hard dependency here.
set -euo pipefail

# The repository that owns the plan keys the workspace when a plan is given,
# so a plan invoked from another repository's checkout (a cross-repo plan)
# still maps to one workspace. Without a plan argument the cwd's repository
# keys, as before.
plan_dir=""
if [ $# -ge 1 ] && [ -n "${1:-}" ]; then
  plan=$1
  plan_dir=$(cd "$(dirname "$plan")" 2>/dev/null && pwd -P) || {
    echo "sdd-dir: plan file directory does not exist: $plan" >&2
    exit 2
  }
  git -C "$plan_dir" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "sdd-dir: plan file directory is not inside a git repository: $plan" >&2
    exit 2
  }
else
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "sdd-dir: not inside a git repository" >&2
    exit 2
  }
fi
repo_git() {
  if [ -n "$plan_dir" ]; then git -C "$plan_dir" "$@"; else git "$@"; fi
}

key=$(printf '%s' "$(repo_git rev-parse --absolute-git-dir)" | repo_git hash-object --stdin)
base="${XDG_CACHE_HOME:-$HOME/.cache}/hyperpowers/sdd"
dir="${base}/${key}"

# Optional PLAN_FILE argument scopes the workspace to one plan. The slug is
# the plan basename plus an 8-char hash of the normalized repo-relative
# path: basename alone collides (two plans named plan.md in different
# directories must not share a ledger). No-arg mode is unchanged — it is
# the repo-instance dir other skills use as a generic cache root.
repo_dir="$dir"
if [ -n "$plan_dir" ]; then
  abs="${plan_dir}/$(basename "$plan")"
  toplevel=$(repo_git rev-parse --show-toplevel)
  rel=${abs#"$toplevel"/}
  slug=$(basename "$plan")
  slug=${slug%.*}
  hash8=$(printf '%s' "$rel" | repo_git hash-object --stdin | cut -c1-8)
  plans_root="${dir}/plans"
  dir="${plans_root}/${slug}-${hash8}"
fi

mkdir -p "$dir"
# Refresh the current workspace's mtime and, in plan mode, the repo cache root.
# Invariant: every sdd-dir invocation freshens both the current workspace AND
# its repo cache root, so neither leaf-level nor repo-level sibling GC can see
# an active workspace as idle; the by-name exclusion remains defense in depth.
touch "$dir"
if [ "$dir" != "$repo_dir" ]; then
  touch "$repo_dir"
fi

# A plan run from another repository's checkout keeps its one workspace under
# the plan repository's key, but a reader that only knows the cwd (the
# compaction notice in hooks/session-start scans the cwd key's plans/) would
# not find it there. Leave a pointer under the cwd key: a symlink carrying the
# workspace's own name. The cwd key is hashed with plain git on purpose, so it
# matches what the hook derives for the same cwd. Only a path that is free or
# already a symlink is taken; a real directory of that name belongs to the cwd
# repository's own plan and is never replaced. The cwd key directory is
# touched as well, so the repo-level reclaim below never takes a pointer-only
# key with it. Dangling pointers left by reclaimed workspaces are pruned
# alongside. Best effort, like the reclaim below: stdout stays exactly the
# dir path.
if [ -n "$plan_dir" ] && git rev-parse --git-dir >/dev/null 2>&1; then
  cwd_key=$(printf '%s' "$(git rev-parse --absolute-git-dir)" | git hash-object --stdin)
  if [ "$cwd_key" != "$key" ]; then
    cwd_plans="${base}/${cwd_key}/plans"
    mkdir -p "$cwd_plans" 2>/dev/null || true
    touch "${base}/${cwd_key}" 2>/dev/null || true
    pointer="${cwd_plans}/$(basename "$dir")"
    if [ ! -e "$pointer" ] || [ -L "$pointer" ]; then
      ln -sfn "$dir" "$pointer" 2>/dev/null || true
    fi
    find "$cwd_plans" -mindepth 1 -maxdepth 1 -type l ! -exec test -e {} \; -delete 2>/dev/null || true
  fi
fi

# Reclaim sibling scratch dirs idle for 14+ days. Left alone the cache grows
# one dir per repo instance forever, and editors that follow agent-touched
# files (Zed's agent panel, for one) hold a filesystem watcher per scratch
# file — enough accumulation has exhausted macOS FSEvent streams in practice.
# A dir's mtime refreshes whenever a file is added or removed inside it, so
# 14 idle days means the run is long finished. The current key is excluded:
# mkdir -p does not bump mtime on an existing dir, so a repo resumed after a
# long pause would otherwise lose its live ledger. Best-effort by design —
# pruning must never break the contract that stdout is exactly the dir path.
find "$base" -mindepth 1 -maxdepth 1 -type d ! -name "$key" -mtime +14 \
  -exec rm -rf {} + 2>/dev/null || true

# Plan-level GC backstop: stale sibling plan workspaces are pruned on the
# same 14-idle-day rule. Scoped to the plans/ subdir only — never non-plan
# cache content under the repo dir — and never the current plan's dir.
if [ -n "${plans_root:-}" ]; then
  find "$plans_root" -mindepth 1 -maxdepth 1 -type d ! -name "$(basename "$dir")" -mtime +14 \
    -exec rm -rf {} + 2>/dev/null || true
fi

printf '%s\n' "$dir"
