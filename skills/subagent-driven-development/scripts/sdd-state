#!/usr/bin/env bash
# sdd-state — lifecycle helper for the SDD state branch, the durable home of
# a plan's dossier (ledger, reports, claims). Design and contracts:
# docs/hyperpowers/specs/2026-10-20-portable-sdd-dossiers-design.md.
#
# Usage:
#   sdd-state sync PLAN_FILE [--assume-absent]      (or: sync --repo DIR [--assume-absent])
#   sdd-state verify PLAN_FILE [--code-repo DIR]
#   sdd-state snapshot PLAN_FILE [-m MSG]
#   sdd-state handoff PLAN_FILE [--push] [--plan-untracked-ok] [--code-dirty-ok] [--code-repo DIR]
#   sdd-state finish PLAN_FILE --session SID [--force] [--code-repo DIR]
#   sdd-state import PLAN_FILE
#   sdd-state prune [--days N] [--apply] --repo DIR
#   sdd-state claim PLAN_FILE (N|final) --session SID [--takeover] [--release] [--code-repo DIR]
#   sdd-state deps PLAN_FILE [--check] [--ledger FILE] [--from FILE] [--code-repo DIR]
#   sdd-state register PLAN_FILE --session SID --integration BRANCH [--code-repo DIR]
#   sdd-state next PLAN_FILE --session SID [--code-repo DIR]
#   sdd-state lease PLAN_FILE (--release|--closing) --session SID [--code-repo DIR]
#
# stdout: one line of space-separated key=value pairs, status= first; sync
# adds a second line "merge=<command>" on diverged.
# exit: 0 ok | 1 offline, offline-no-state, push-failed | 2 usage or internal
#       (needs-sync, foreign branch, no-workspace, import-failed) |
#       3 diverged, busy, remote-finished |
#       4 claim held by another session | 5 scan-failed | 6 open-claims |
#       7 plain backend (handoff) | 8 plan-not-committed |
#       9 wrong-repo, code-missing, plan-stale | 10 code-dirty | 11 detached-head | 12 shallow-source
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HP_PROG=sdd-state
# shellcheck source=sdd-common.sh
. "$SCRIPT_DIR/sdd-common.sh"

# Set by remove_verified when it leaves a verified copy at its tomb.
TOMB=""
# Set once a leftover entry under plans/ has been named on stderr, so the
# caller's three attempts do not repeat the same diagnosis.
NAMED_LEFTOVER=0
# The same, for a copy an interrupted removal stranded beside a workspace
# that is occupied again.
NAMED_TOMB=0

usage() {
  printf '%s\n' \
    'usage: sdd-state <subcommand> ...' \
    '  sync PLAN_FILE [--assume-absent]   |   sync --repo DIR [--assume-absent]' \
    '  verify PLAN_FILE [--code-repo DIR]' \
    '  snapshot PLAN_FILE [-m MSG]' \
    '  handoff PLAN_FILE [--push] [--plan-untracked-ok] [--code-dirty-ok] [--code-repo DIR]' \
    '  finish PLAN_FILE --session SID [--force] [--code-repo DIR]' \
    '  import PLAN_FILE' \
    '  prune [--days N] [--apply] --repo DIR' \
    '  claim PLAN_FILE (N|final) --session SID [--takeover] [--release] [--code-repo DIR]' \
    '  deps PLAN_FILE [--check] [--ledger FILE] [--from FILE] [--code-repo DIR]' \
    '  register PLAN_FILE --session SID --integration BRANCH [--code-repo DIR]' \
    '  next PLAN_FILE --session SID [--code-repo DIR]' \
    '  lease PLAN_FILE (--release|--closing) --session SID [--code-repo DIR]' >&2
  exit 2
}

PLAN=""; PLAN_DIR=""; REPO=""; WS=""; SLUG=""; BRANCH=""; REMOTE=""; CO=""; BACKEND=""; ROOT=""; WSDIR=""

# Resolve PLAN_FILE without touching the checkout: sync fetches first.
# REPO and REMOTE are consumed by the sync, verify and handoff subcommands.
# shellcheck disable=SC2034
resolve_plan_basic() {
  PLAN=$1
  PLAN_DIR=$(hp_plan_dir "$PLAN") || { echo "sdd-state: plan file is not inside a git repository: $PLAN" >&2; exit 2; }
  REPO=$(hp_physical_dir "$(git -C "$PLAN_DIR" rev-parse --show-toplevel)")
  WS=$(hp_plan_ws_name "$PLAN")
  SLUG=${WS%-*}
  BRANCH=$(hp_state_branch "$PLAN_DIR")
  REMOTE=$(hp_state_remote "$PLAN_DIR")
  CO=$(hp_checkout_path "$PLAN_DIR")
}
# Resolve and make sure the checkout (or the plain root) exists.
resolve_plan() {
  local ensure
  resolve_plan_basic "$1"
  # The grammar is one status line on stdout for every outcome; the library
  # has already said on stderr why the checkout could not be created.
  ensure=$(hp_ensure_checkout "$PLAN_DIR") || { echo "status=error"; exit 2; }
  BACKEND=${ensure%% *}
  ROOT=${ensure#* }
  WSDIR="$ROOT/plans/$WS"
}
ledger_path() { printf '%s/progress.md\n' "$WSDIR"; }
# One encoding for every path-valued stdout field: a space becomes %20.
enc() { printf '%s' "$1" | sed 's/ /%20/g'; }
# --code-repo DIR, or the cwd's toplevel: the repository that owns the
# integration branch when the plan lives elsewhere. Exits 2 as verify does.
code_repo_arg() { # <value or empty> [<ledger>] -> physical path; refuses a repository whose root is not the recorded code root
  local code=$1 ledger=${2:-} line want
  if [ -z "$code" ]; then
    code=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "sdd-state: not inside a code repository; pass --code-repo DIR" >&2; echo "status=error"; exit 2; }
  fi
  code=$(hp_physical_dir "$code") || { echo "sdd-state: no such directory: $code" >&2; echo "status=error"; exit 2; }
  if [ -n "$ledger" ] && [ -f "$ledger" ]; then
    line=$(plan_line_of "$ledger")
    if [ -n "$line" ]; then
      want=$(plan_field "$line" code-root)
      if [ "$(root_of "$code" | cut -c1-7)" != "$want" ]; then echo "status=wrong-repo expected=$want"; exit 9; fi
    fi
  fi
  printf '%s\n' "$code"
}
# Reversible, unlike enc: percent first, then space, so "a b" and "a%20b"
# stay distinct specs.
enc_spec() { printf '%s' "$1" | sed 's/%/%25/g; s/ /%20/g'; }
# <ledger> -> "integration=.. code-root=.. plan-ref=.. plan-root=.. spec=.." from the newest plan line, or nothing.
# The line on disk keeps the spec path as written; the spec= value is
# enc_spec-encoded here so that plan_field, which splits on spaces, stays exact.
plan_line_of() {
  local raw
  raw=$(sed -n '/^plan: integration [^ ]* code-root [^ ]* plan-ref [^ ]* plan-root [^ ]* spec /p' "$1" 2>/dev/null | tail -n 1)
  [ -n "$raw" ] || return 0
  printf '%s spec=%s\n' \
    "$(printf '%s' "$raw" | sed 's/^plan: integration \([^ ]*\) code-root \([^ ]*\) plan-ref \([^ ]*\) plan-root \([^ ]*\) spec .*$/integration=\1 code-root=\2 plan-ref=\3 plan-root=\4/')" \
    "$(enc_spec "$(printf '%s' "$raw" | sed 's/^plan: integration [^ ]* code-root [^ ]* plan-ref [^ ]* plan-root [^ ]* spec //')")"
}
plan_field() { printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -n 1; }
spec_of_plan() { sed -n 's/^\*\*Spec:\*\*[[:space:]]*//p' "$1" | head -n 1; }
ws8_of() { printf '%s' "$1" | sed 's/.*-//'; }
owner_record() { # <sid> [<task branch> <from sha>]
  local top b
  # Test hook: a failed owner write, so the fail-closed paths are provable.
  [ -z "${HYPERPOWERS_TEST_FAIL_OWNER_WRITE:-}" ] || return 1
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$(pwd -P)
  b=$(git branch --show-current 2>/dev/null)
  [ -n "$b" ] || b="detached@$(git rev-parse --short=7 HEAD 2>/dev/null || echo none)"
  # checkout= is the session's own branch, for the board; branch= is the
  # task branch the claim owns, the name the spec gives it.
  printf 'session=%s\nworktree=%s\ncheckout=%s\nhost=%s\ntime=%s\n' "$1" "$top" "$b" "$(hostname)" "$(hp_utc_now)"
  # The task branch is part of the claim: written before the rename, so a
  # crash between the rename and the branch creation leaves the retry its
  # intended name and base.
  [ -z "${2:-}" ] || printf 'branch=%s\nfrom=%s\n' "$2" "$3"
}
# Completion is a ledger line that begins with the marker; an amendment or scan
# line that merely mentions "Task N: complete" must not satisfy a dependency.
ledger_task_complete() { grep -Eq "^[[:space:]*_>-]*Task $2: complete([^[:alnum:]_]|\$)" "$1" 2>/dev/null; }
claim_task_branch_name() { # <integration> <ws8> <N> [<k>] -> <integration>.<ws8>.task-<N>[.<k>]
  printf '%s.%s.task-%s%s' "$1" "$2" "$3" "${4:+.$4}"
}
write_activity() { # <sid>
  local dest="$WSDIR/activity/$1" t
  # The session id is caller input and the activity directory arrives with a
  # fetched state branch, so containment is checked at the write point, leaf
  # included. The timestamp goes through an exclusively created temporary
  # file: a fixed temporary name would follow a planted link or collide with
  # a session whose id ends in the suffix.
  hp_contained "$ROOT" "plans/$WS/activity/$1" || return 1
  mkdir -p "$WSDIR/activity" || return 1
  t=$(mktemp "$WSDIR/activity/.$1.XXXXXX") || return 1
  { printf '%s\n' "$(hp_utc_now)" > "$t" && mv -f "$t" "$dest"; } || { rm -f "$t"; return 1; }
}

# --- deps --------------------------------------------------------------------
# The authoritative plan is the blob at the plan ref's head in the plan
# repository, never a worktree's copy: two sessions on two task branches
# would otherwise read two graphs. With a plan line the ref is the line's
# and must carry the file (an error otherwise, never a fallback); before
# registration it is the current branch when that carries the file, and the
# file itself only then.
# Prints "<blob sha> <path of a temporary copy>"; the caller removes the copy.
authoritative_plan_blob() {
  local ledger ref rel blob tmp name
  ledger=$(ledger_path); rel=$(hp_plan_rel "$PLAN")
  ref=$(plan_ref_of_ledger "$ledger")
  tmp=$(mktemp "${TMPDIR:-/tmp}/sdd-plan.XXXXXX") || return 2
  name=""
  if [ -n "$ref" ]; then
    git -C "$REPO" cat-file -e "refs/heads/$ref:$rel" 2>/dev/null || { rm -f "$tmp"; echo "sdd-state: the plan ref $ref does not carry $rel" >&2; return 2; }
    name=$ref
  else
    name=$(git -C "$REPO" branch --show-current 2>/dev/null)
    if [ -n "$name" ] && git -C "$REPO" cat-file -e "refs/heads/$name:$rel" 2>/dev/null; then :; else name=""; fi
  fi
  if [ -n "$name" ]; then
    # Resolve the id once and read the content from that immutable object, so
    # a ref moved between the two steps cannot pair one plan with another's id.
    blob=$(git -C "$REPO" rev-parse --verify "refs/heads/$name:$rel") || { rm -f "$tmp"; return 2; }
    # Test seam: HYPERPOWERS_TEST_WRITER_AT=deps-after-resolve:<sha> moves the
    # branch to <sha> after the id is resolved and before the content is read.
    case "${HYPERPOWERS_TEST_WRITER_AT:-}" in deps-after-resolve:*) git -C "$REPO" update-ref "refs/heads/$name" "${HYPERPOWERS_TEST_WRITER_AT#*:}" ;; esac
    git -C "$REPO" cat-file blob "$blob" > "$tmp" || { rm -f "$tmp"; return 2; }
  else
    cp "$PLAN" "$tmp" || { rm -f "$tmp"; return 2; }
    blob=$(git -C "$REPO" hash-object "$tmp")
  fi
  printf '%s %s\n' "$blob" "$tmp"
}
cmd_deps() {
  local plan="" check=0 ledger="" from="" code="" pair blob tmp graph rc out n ref
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      --ledger) [ $# -ge 2 ] || usage; ledger=$2; shift 2 ;;
      --from) [ $# -ge 2 ] || usage; from=$2; shift 2 ;;
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) [ -z "$plan" ] || usage; plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] || usage
  resolve_plan "$plan"
  [ -n "$ledger" ] || ledger=$(ledger_path)
  code=$(code_repo_arg "$code" "$ledger") || { rc=$?; [ -z "$code" ] || printf '%s\n' "$code"; return "$rc"; }
  ref=$(plan_ref_of_ledger "$ledger"); [ -n "$ref" ] || ref=$(git -C "$REPO" branch --show-current 2>/dev/null)
  if [ -n "$from" ]; then
    [ -f "$from" ] || { echo "sdd-state: no such file: $from" >&2; echo "status=error"; return 2; }
    # One absolute path for the hash and the parse: git -C "$REPO" would
    # otherwise resolve a relative --from against the plan repository while the
    # parser reads it from the caller's directory.
    from=$(cd "$(dirname "$from")" 2>/dev/null && pwd -P)/$(basename "$from")
    tmp=$from; blob=$(git -C "$REPO" hash-object "$from") || { echo "status=error"; return 2; }
  else
    pair=$(authoritative_plan_blob) || { echo "status=error"; return 2; }
    blob=${pair%% *}; tmp=${pair#* }
  fi
  if ! graph=$(hp_plan_graph "$tmp"); then [ -n "$from" ] || rm -f "$tmp"; echo "status=invalid plan=${blob:0:7}"; return 2; fi
  if [ "$check" -eq 0 ]; then
    [ -n "$from" ] || rm -f "$tmp"
    n=$(printf '%s\n' "$graph" | grep -c .)
    echo "status=deps plan=${blob:0:7} tasks=$n"; printf '%s\n' "$graph"; return 0
  fi
  out=$(hp_plan_overlaps "$tmp" "$ledger" "$(dirname "$ledger")/amends" "$REPO" "$ref"); rc=$?
  [ -n "$from" ] || rm -f "$tmp"
  [ "$rc" -ne 2 ] || { echo "status=error"; return 2; }
  if [ "$rc" -eq 0 ]; then echo "status=clean plan=${blob:0:7}"; return 0; fi
  n=$(printf '%s\n' "$out" | grep -c .)
  echo "status=conflicts plan=${blob:0:7} count=$n"; printf '%s\n' "$out"; return 1
}

# --- register ----------------------------------------------------------------
# A session's first act on a plan. The check (siblings of the same spec share
# the integration branch, the plan ref and the plan root; the branch is not
# closing; an existing line matches) and the write happen under both
# repositories' locks, so two Setups cannot both pass and write conflicting
# lines.
cmd_register() {
  local plan="" sid="" integration="" code="" ledger line spec espec same_repo plan_ref plan_root code_root d other ospec field lease rc mine cur
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
      --integration) [ $# -ge 2 ] || usage; integration=$2; shift 2 ;;
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) [ -z "$plan" ] || usage; plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] && [ -n "$sid" ] && [ -n "$integration" ] || usage
  resolve_plan "$plan"
  ledger=$(ledger_path)
  [ -f "$ledger" ] || { echo "sdd-state: no ledger at $ledger; Setup creates it before registering" >&2; echo "status=error"; return 2; }
  code=$(code_repo_arg "$code" "$ledger") || { rc=$?; [ -z "$code" ] || printf '%s\n' "$code"; return "$rc"; }
  spec=$(spec_of_plan "$PLAN"); espec=$(enc_spec "$spec")
  # A first registration names the plan ref after the current branch, so the
  # plan repository must be on one then; a later session starts detached at
  # the integration head and takes the plan ref from the plan line instead.
  cur=$(git -C "$REPO" branch --show-current 2>/dev/null)
  # A shallow clone's oldest commit is a fetch boundary, so the identity
  # recorded now would differ after an unshallow; handoff refuses the same way.
  # Linked worktrees of one repository have different roots but one key, the
  # test the lock pair uses, so the key decides whether the layout is split.
  same_repo=0; [ "$(hp_key "$code")" = "$(hp_key "$REPO")" ] && same_repo=1
  if [ "$(git -C "$code" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then echo "status=shallow-source repo=code"; return 12; fi
  if [ "$same_repo" -eq 0 ] && [ "$(git -C "$REPO" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then echo "status=shallow-source repo=plan"; return 12; fi
  plan_root=$(root_of "$REPO"); code_root=$(root_of "$code")
  hp_lock_pair "$PLAN_DIR" "$code" || return 2
  recover_apply || { hp_unlock; echo "status=error"; return 2; }
  # The ledger is appended to below; a workspace or ledger swapped for a link
  # since the checkout was made must not receive the write.
  hp_contained "$ROOT" "plans/$WS/progress.md" || { hp_unlock; echo "status=error"; return 2; }
  if [ "${HYPERPOWERS_TEST_PAUSE_AT:-}" = register-before-write ]; then
    : > "$CO/.register-before-write-paused"
    while [ -e "$CO/.register-before-write-pause" ]; do sleep 0.1; done
    rm -f "$CO/.register-before-write-paused"
  fi
  # The closing check comes first: a branch being torn down admits nothing,
  # not even a session of a plan already registered on it.
  lease=$(hp_lease_key "$PLAN_DIR" "$integration")
  if [ -f "$lease" ] && [ "$(sed -n 's/^closing=//p' "$lease")" = 1 ]; then hp_unlock; echo "status=branch-closing"; return 15; fi
  line=$(plan_line_of "$ledger")
  if [ -n "$line" ]; then
    # A re-registration must match the whole recorded identity: a session
    # arriving from another checkout of the plan repository, or with another
    # spec header, is not this plan's session.
    hp_unlock
    plan_ref=$(plan_field "$line" plan-ref)
    [ "$(plan_field "$line" integration)" = "$integration" ] || { echo "status=wrong-branch expected=$(plan_field "$line" integration)"; return 9; }
    [ "$(plan_field "$line" code-root)" = "${code_root:0:7}" ] || { echo "status=wrong-repo expected=$(plan_field "$line" code-root)"; return 9; }
    # Detached, on the plan ref, or on one of this plan's task branches: a
    # resumed session sits on any of the three.
    case "$cur" in ""|"$plan_ref"|"$integration.$(ws8_of "$WS").task-"*) ;; *) echo "status=wrong-branch expected=$plan_ref repo=plan"; return 9 ;; esac
    [ "$(plan_field "$line" plan-root)" = "${plan_root:0:7}" ] || { echo "status=wrong-repo expected=$(plan_field "$line" plan-root) repo=plan"; return 9; }
    [ "$(plan_field "$line" spec)" = "$espec" ] || { echo "sdd-state: the plan line names spec $(plan_field "$line" spec), the plan file names $espec" >&2; echo "status=error"; return 2; }
    echo "status=registered integration=$integration plan-ref=$plan_ref"; return 0
  fi
  [ -n "$cur" ] || { hp_unlock; echo "status=detached-head repo=plan"; return 11; }
  plan_ref=$cur
  for d in "$ROOT"/plans/*/; do
    [ -f "$d/progress.md" ] || continue
    [ "${d%/}" != "$WSDIR" ] || continue
    other=$(plan_line_of "$d/progress.md"); [ -n "$other" ] || continue
    ospec=$(plan_field "$other" spec); [ "$ospec" = "$espec" ] || continue
    for field in integration plan-ref plan-root; do
      case "$field" in integration) mine=$integration ;; plan-ref) mine=$plan_ref ;; plan-root) mine=${plan_root:0:7} ;; esac
      if [ "$(plan_field "$other" "$field")" != "$mine" ]; then
        hp_unlock; echo "status=spec-branch-mismatch expected=$(plan_field "$other" integration) plan=$(enc "$(basename "${d%/}")")"; return 9
      fi
    done
  done
  # With one repository the plan ref is the integration branch itself, so a
  # mistyped --integration would record a line that verify then rejects.
  if [ "$same_repo" -eq 1 ] && [ "$cur" != "$integration" ]; then hp_unlock; echo "status=wrong-branch expected=$cur"; return 9; fi
  if ! git -C "$code" rev-parse -q --verify "refs/heads/$integration^{commit}" >/dev/null 2>&1; then
    hp_unlock; echo "sdd-state: the integration branch $integration does not exist in $code" >&2; echo "status=error"; return 2
  fi
  printf 'plan: integration %s code-root %s plan-ref %s plan-root %s spec %s\n' "$integration" "${code_root:0:7}" "$plan_ref" "${plan_root:0:7}" "$spec" >> "$ledger" || { hp_unlock; echo "status=error"; return 2; }
  hp_unlock
  echo "status=registered integration=$integration plan-ref=$plan_ref"
}

# --- snapshot ----------------------------------------------------------------
cmd_snapshot() {
  local plan="" msg="" out rc n
  while [ $# -gt 0 ]; do
    case "$1" in
      -m) [ $# -ge 2 ] || usage; msg=$2; shift 2 ;;
      -*) usage ;;
      *) plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] || usage
  resolve_plan "$plan"
  if [ "$BACKEND" != branch ]; then echo "status=plain"; return 0; fi
  [ -d "$WSDIR" ] || { echo "status=none"; return 0; }
  [ -n "$msg" ] || msg="sdd $SLUG: snapshot $(hp_utc_now)"
  hp_lock "$PLAN_DIR" || return 2
  recover_apply || { hp_unlock; echo "status=error"; return 2; }
  hp_contained "$CO" "plans/$WS" || { hp_unlock; echo "status=error"; return 2; }
  out=$(hp_commit_paths "$CO" "$BRANCH" "$msg" "plans/$WS"); rc=$?
  hp_unlock
  [ "$rc" -eq 0 ] || { echo "status=error"; return 2; }
  if [ "$out" = none ]; then echo "status=none"; return 0; fi
  n=$(git -C "$CO" show --name-only --format= "$out" | grep -c .)
  echo "status=snapshot sha=${out:0:7} files=$n"
}

# --- claim -------------------------------------------------------------------
# The record is prepared in a temporary directory and published with one
# rename(2), through node because a shell mv on macOS moves a directory into
# an existing target instead of failing. A loser never sees a claim without
# its owner file. Publication and takeover run under the repository lock,
# the same lock finish holds while it reads the claims and removes the
# workspace, so a claim can never slip in between those two steps.
cmd_claim() {
  local plan="" n="" sid="" takeover=0 release=0 code="" claims target tmp rc owner since wt prev
  local graph pair blob deps d waiting line again pass integ ref from k prev_ref tb branch_out lease have
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
      --takeover) takeover=1; shift ;;
      --release) release=1; shift ;;
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) if [ -z "$plan" ]; then plan=$1; elif [ -z "$n" ]; then n=$1; else usage; fi; shift ;;
    esac
  done
  [ -n "$plan" ] && [ -n "$n" ] && [ -n "$sid" ] || usage
  case "$n" in final) ;; ''|*[!0-9]*) usage ;; esac
  # A release gives up the final claim and the lease; it is no takeover and
  # means nothing for a numbered task.
  [ "$release" -eq 0 ] || { [ "$n" = final ] && [ "$takeover" -eq 0 ]; } || usage
  command -v node >/dev/null 2>&1 || { echo "sdd-state: node not found" >&2; return 2; }
  resolve_plan "$plan"
  claims="$WSDIR/claims"; target="$claims/task-$n"
  [ "$n" != final ] || target="$claims/final"
  # Everything below runs under the repository lock, the same lock finish
  # holds while it reads the claims and removes the workspace: a claim can
  # never slip in between those steps, and never resurrect a finished one.
  # Every write is checked: a claim is reported only once its owner record
  # is durable and names this session, because a caller that believes it
  # owns a task it does not own duplicates work.
  # A claim with a plan line writes a code ref, so it holds both repositories'
  # locks in the pair's order; without one it writes only state. A
  # --code-repo is validated whenever it is given, so a mistyped directory is
  # refused rather than silently ignored.
  claim_take_locks() {
    integ=""
    if [ -n "$line" ]; then
      integ=$(plan_field "$line" integration)
      code=$(code_repo_arg "$code" "$WSDIR/progress.md") || { rc=$?; [ -z "$code" ] || printf '%s\n' "$code"; return "$rc"; }
      hp_lock_pair "$PLAN_DIR" "$code" || return 2
    else
      if [ -n "$code" ]; then
        code=$(code_repo_arg "$code" "$WSDIR/progress.md") || { rc=$?; [ -z "$code" ] || printf '%s\n' "$code"; return "$rc"; }
      fi
      hp_lock "$PLAN_DIR" || return 2
    fi
  }
  # Creates the task branch at its base and records it, idempotently. A fresh
  # claim (strict) accepts only an absent branch or one exactly at its base,
  # because anything else is a leftover of an abandoned run; the owner's retry
  # also keeps a branch that has moved past its base, the work it made.
  claim_finish_branch() { # [strict]
    local have
    branch_out=""
    [ -n "$ref" ] || { branch_out=" branch=none"; return 0; }
    if have=$(git -C "$code" rev-parse -q --verify "refs/heads/$ref^{commit}" 2>/dev/null); then
      if [ "$have" != "$from" ]; then
        if [ "${1:-}" = strict ]; then echo "sdd-state: $ref already exists at ${have:0:7}, not at its base ${from:0:7}; it is a leftover of an abandoned run" >&2; return 1; fi
        git -C "$code" merge-base --is-ancestor "$from" "$have" 2>/dev/null || { echo "sdd-state: $ref exists at ${have:0:7}, not at or past its recorded base ${from:0:7}" >&2; return 1; }
      fi
    else
      git -C "$code" branch "$ref" "$from" >/dev/null || return 1
    fi
    if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = claim-after-branch ]; then hp_unlock; exit 99; fi
    hp_contained "$ROOT" "plans/$WS/progress.md" || return 1
    grep -q "^Task $n: branch $ref from ${from:0:7}$" "$WSDIR/progress.md" || printf 'Task %s: branch %s from %s\n' "$n" "$ref" "${from:0:7}" >> "$WSDIR/progress.md" || return 1
    write_activity "$sid" || return 1
    branch_out=" branch=$ref from=${from:0:7}"
  }
  # The owner's own record names the task branch only when it also names its
  # base: records written before task branches existed carry the session's
  # checked-out branch under branch= and no from=, and carry no task branch.
  claim_finish_own() {
    ref=$(sed -n 's/^branch=//p' "$target/owner" 2>/dev/null); from=$(sed -n 's/^from=//p' "$target/owner" 2>/dev/null)
    if [ -n "$ref" ] && [ -n "$from" ]; then claim_finish_branch; else ref=""; from=""; branch_out=" branch=none"; fi
  }
  # The plan line is only settled once recovery has run: finishing an
  # interrupted sync can bring in a registered ledger. Locks are taken for the
  # line as it stands, recovery runs under them, and the line is read again;
  # a claim that went on with one lock would publish a branchless record on a
  # registered plan, which the owner's retry could not repair.
  claim_held() {
    # Read the holder's record while the lock still excludes takeovers and
    # finish, so the fields come from one record.
    owner=$(sed -n 's/^session=//p' "$target/owner" 2>/dev/null)
    since=$(sed -n 's/^time=//p' "$target/owner" 2>/dev/null)
    wt=$(sed -n 's/^worktree=//p' "$target/owner" 2>/dev/null)
    if [ -z "$owner" ]; then hp_unlock; echo "status=error"; return 2; fi
    if [ "$owner" = "$sid" ]; then
      # The owner's retry completes whatever a crash left undone.
      claim_finish_own || { hp_unlock; echo "status=error"; return 2; }
      hp_unlock; echo "status=held task=$n owner=$owner own=1${branch_out}"; return 0
    fi
    hp_unlock
    echo "status=held task=$n owner=$owner since=$since worktree=$(enc "$wt")"
    return 4
  }
  # The final claim, for the session that runs the plan's final train. It is
  # published once every task of the authoritative plan has a completion line
  # and no task claim is open; then the branch lease is taken, the file
  # hp_lease_key names beside the plan repository's lock, which serializes
  # the finals of every plan on the integration branch. Without a plan line
  # (a plan that predates registration) there is no branch to lease, and only
  # claims/final is published. Runs under the locks the loop below settled.
  claim_final() {
    local c lowner="" lplan="" own_lease=0 lease_prev=0 took=0 missing="" t open lease_out rec
    lease=""
    c=$(hp_checkout_path "$PLAN_DIR") || { hp_unlock; echo "status=error"; return 2; }
    if [ "$release" -eq 1 ]; then
      # Only this session's own claim is removed; the lease is found by its
      # identity, so the release works whichever of the two is already gone.
      hp_contained "$ROOT" "plans/$WS/claims/final" || { hp_unlock; echo "status=error"; return 2; }
      if [ -d "$target" ] && [ "$(sed -n 's/^session=//p' "$target/owner" 2>/dev/null | head -n 1)" = "$sid" ]; then
        rm -rf "$target"
        [ ! -e "$target" ] || { hp_unlock; echo "status=error"; return 2; }
      fi
      lease=$(lease_find "$WS" "$sid") || { hp_unlock; echo "status=error"; return 2; }
      if [ -n "$lease" ]; then rm -f "$lease" || { hp_unlock; echo "status=error"; return 2; }; fi
      hp_unlock; echo "status=released"; return 0
    fi
    # As for a numbered claim, a plan absent from both the ref and the working
    # tree has no graph only while there is no plan line; the open claims are
    # then all that can hold final back.
    graph=""
    if [ -n "$line" ]; then pair=$(authoritative_plan_blob) || pair=""; else pair=$(authoritative_plan_blob 2>/dev/null) || pair=""; fi
    if [ -n "$pair" ]; then
      blob=${pair%% *}; tmp=${pair#* }
      graph=$(hp_plan_graph "$tmp"); rc=$?; rm -f "$tmp"
      [ "$rc" -eq 0 ] || { hp_unlock; echo "status=invalid plan=${blob:0:7}"; return 2; }
    elif [ -n "$line" ] || [ -e "$PLAN" ]; then
      hp_unlock; echo "status=error"; return 2
    fi
    for t in $(printf '%s\n' "$graph" | sed -n 's/^task=\([0-9][0-9]*\) .*/\1/p'); do
      ledger_task_complete "$WSDIR/progress.md" "$t"; rc=$?
      if [ "$rc" -eq 1 ]; then missing="$missing,$t"; elif [ "$rc" -ne 0 ]; then hp_unlock; echo "status=error"; return 2; fi
    done
    open=$(open_claims); [ -z "$open" ] || missing="$missing,$open"
    if [ -n "$missing" ]; then hp_unlock; echo "status=blocked task=final waiting=$(printf '%s\n' "${missing#,}" | tr ',' '\n' | sort -nu | paste -sd, -)"; return 7; fi
    if [ -d "$target" ]; then
      owner=$(sed -n 's/^session=//p' "$target/owner" 2>/dev/null | head -n 1)
      since=$(sed -n 's/^time=//p' "$target/owner" 2>/dev/null | head -n 1)
      if [ "$takeover" -eq 0 ] && [ -z "$owner" ]; then hp_unlock; echo "sdd-state: claim owner unreadable or without a session: $target/owner" >&2; echo "status=error"; return 2; fi
      if [ "$takeover" -eq 0 ] && [ "$owner" != "$sid" ]; then hp_unlock; echo "status=held task=final owner=$owner since=$since"; return 4; fi
    fi
    if [ -n "$line" ]; then
      { lease=$(hp_lease_key "$PLAN_DIR" "$integ") && lease_path_ok "$c" "$lease"; } || { hp_unlock; echo "status=error"; return 2; }
    fi
    if [ -n "$lease" ] && [ -f "$lease" ]; then
      lowner=$(sed -n 's/^session=//p' "$lease" | head -n 1); lplan=$(sed -n 's/^plan=//p' "$lease" | head -n 1)
      # A lease that names no holder is no free lease; only a takeover may
      # replace it.
      if { [ -z "$lowner" ] || [ -z "$lplan" ]; } && [ "$takeover" -eq 0 ]; then
        hp_unlock; echo "sdd-state: lease unreadable or without session= or plan=: $lease" >&2; echo "status=error"; return 2
      fi
      if [ "$lowner" = "$sid" ] && [ "$lplan" = "$WS" ]; then
        own_lease=1
      elif [ "$takeover" -eq 0 ]; then
        # This plan's own claim is published first, so the second finisher
        # keeps its place and retries for the lease. Its activity is written
        # too: a session that waits for the lease is alive, and a board that
        # read it as idle would invite a takeover of the claim it holds.
        [ -d "$target" ] || publish_final_claim || { hp_unlock; echo "status=error"; return 2; }
        write_activity "$sid" || { hp_unlock; echo "status=error"; return 2; }
        hp_unlock; echo "status=held task=final lease=$lowner plan=$(enc "$lplan")"; return 4
      else
        took=1; lease_prev=1
      fi
    fi
    lease_out=none; [ -z "$lease" ] || lease_out=$(basename "$lease")
    # The holder's repeat leaves both records exactly as they are, the lease's
    # closing= included. A takeover by the holder itself is the same repeat:
    # rewriting the lease would reopen a branch its own closing has marked.
    if { [ "$own_lease" -eq 1 ] && { [ ! -d "$target" ] || [ "$owner" = "$sid" ]; }; } || { [ -z "$lease" ] && [ -d "$target" ] && [ "$owner" = "$sid" ]; }; then
      [ -d "$target" ] || publish_final_claim || { hp_unlock; echo "status=error"; return 2; }
      write_activity "$sid" || { hp_unlock; echo "status=error"; return 2; }
      hp_unlock; echo "status=held task=final owner=$sid own=1 lease=$lease_out"; return 0
    fi
    if [ -d "$target" ] && [ "$owner" != "$sid" ]; then
      # Only a takeover reaches here with another owner. New record first
      # (invisible until the rename), then the history line, then the atomic
      # replacement; a failure anywhere leaves the old owner.
      { hp_contained "$ROOT" "plans/$WS/claims/final/owner.new" && hp_contained "$ROOT" "plans/$WS/claims/final/owner.history"; } || { hp_unlock; echo "status=error"; return 2; }
      if ! owner_record "$sid" > "$target/owner.new"; then rm -f "$target/owner.new"; hp_unlock; echo "status=error"; return 2; fi
      if ! printf -- '--- superseded at %s\n%s\n' "$(hp_utc_now)" "$(cat "$target/owner" 2>/dev/null)" >> "$target/owner.history"; then rm -f "$target/owner.new"; hp_unlock; echo "status=error"; return 2; fi
      if ! mv -f "$target/owner.new" "$target/owner"; then rm -f "$target/owner.new"; hp_unlock; echo "status=error"; return 2; fi
      took=1
    elif [ ! -d "$target" ]; then
      publish_final_claim || { hp_unlock; echo "status=error"; return 2; }
    fi
    if [ "$(sed -n 's/^session=//p' "$target/owner" 2>/dev/null | head -n 1)" != "$sid" ]; then hp_unlock; echo "status=error"; return 2; fi
    if [ -n "$lease" ] && [ "$own_lease" -eq 0 ]; then
      rec=$(printf 'session=%s\nhost=%s\nplan=%s\nbranch=%s\ntime=%s\nclosing=0' "$sid" "$(hostname)" "$WS" "$integ" "$(hp_utc_now)")
      if [ "$lease_prev" -eq 1 ]; then
        lease_supersede "$c" "$lease" "$rec" || { hp_unlock; echo "status=error"; return 2; }
      else
        lease_write "$c" "$lease" "$rec" || { hp_unlock; echo "status=error"; return 2; }
      fi
    fi
    # The claim stands once published; a failed activity write is reported,
    # and the holder's retry answers held.
    write_activity "$sid" || { hp_unlock; echo "status=error"; return 2; }
    hp_unlock
    if [ "$took" -eq 1 ]; then echo "status=claimed task=final lease=$lease_out takeover=1"; else echo "status=claimed task=final lease=$lease_out"; fi
  }
  # claims/final by the same single rename as a task claim. A target that
  # exists already (EEXIST) is no failure: the caller reads its owner.
  publish_final_claim() {
    local tmpl prc
    hp_contained "$ROOT" "plans/$WS/claims" || return 1
    mkdir -p "$claims" || return 1
    tmpl=$(mktemp -d "$claims/.tmp-XXXXXX") || return 1
    owner_record "$sid" > "$tmpl/owner" || { rm -rf "$tmpl"; return 1; }
    node -e 'const fs=require("fs");try{fs.renameSync(process.argv[1],process.argv[2]);}catch(e){process.exit(e.code==="ENOTEMPTY"||e.code==="EEXIST"?4:2);}' "$tmpl" "$target"; prc=$?
    [ "$prc" -eq 0 ] || rm -rf "$tmpl"
    [ "$prc" -eq 0 ] || [ "$prc" -eq 4 ]
  }
  # A takeover of final after finish has removed the workspace: the holder
  # stopped before releasing the branch lease, and every other plan on the
  # integration branch waits behind it. The lease is found by this plan's
  # workspace alone, because the stopped session's identity is what the
  # caller lacks, and moves to the caller with the prior record kept beside
  # it. Its closing= is kept, so a branch the holder had marked closing is
  # not reopened to sibling registrations by the takeover. Nothing else is
  # published: recreating the workspace would undo the finish. Runs under
  # the plan repository's lock, which every lease operation also holds.
  claim_final_orphan() {
    local c lowner lbranch lclosing rec
    c=$(hp_checkout_path "$PLAN_DIR") || { hp_unlock; echo "status=error"; return 2; }
    lease=$(lease_find "$WS") || { hp_unlock; echo "status=error"; return 2; }
    if [ -z "$lease" ]; then hp_unlock; echo "status=no-workspace task=final"; return 2; fi
    lowner=$(sed -n 's/^session=//p' "$lease" | head -n 1)
    if [ "$lowner" = "$sid" ]; then hp_unlock; echo "status=held task=final owner=$sid own=1 lease=$(basename "$lease")"; return 0; fi
    lbranch=$(sed -n 's/^branch=//p' "$lease" | head -n 1)
    [ -n "$lbranch" ] || { hp_unlock; echo "sdd-state: the lease $lease names no branch" >&2; echo "status=error"; return 2; }
    lclosing=$(sed -n 's/^closing=//p' "$lease" | head -n 1); [ "$lclosing" = 1 ] || lclosing=0
    rec=$(printf 'session=%s\nhost=%s\nplan=%s\nbranch=%s\ntime=%s\nclosing=%s' "$sid" "$(hostname)" "$WS" "$lbranch" "$(hp_utc_now)" "$lclosing")
    lease_supersede "$c" "$lease" "$rec" || { hp_unlock; echo "status=error"; return 2; }
    hp_unlock; echo "status=claimed task=final lease=$(basename "$lease") takeover=1"
  }
  line=$(plan_line_of "$WSDIR/progress.md"); ref=""; from=""; pass=0
  while :; do
    pass=$((pass + 1))
    if [ "$pass" -gt 3 ]; then echo "sdd-state: the plan line has not settled after three passes" >&2; echo "status=error"; return 2; fi
    claim_take_locks || return $?
    recover_apply || { hp_unlock; echo "status=error"; return 2; }
    again=$(plan_line_of "$WSDIR/progress.md")
    [ "$again" != "$line" ] || break
    hp_unlock
    if [ -n "$line" ]; then echo "sdd-state: the plan line changed while the claim took its locks" >&2; echo "status=error"; return 2; fi
    line=$again
  done
  if [ ! -f "$WSDIR/progress.md" ]; then
    if [ "$n" = final ] && [ "$takeover" -eq 1 ]; then claim_final_orphan; return $?; fi
    hp_unlock; echo "status=no-workspace task=$n"; return 2
  fi
  # final is no numbered task: none of the checks below apply to it.
  if [ "$n" = final ]; then claim_final; return $?; fi
  ledger_task_complete "$WSDIR/progress.md" "$n"; rc=$?
  if [ "$rc" -eq 0 ]; then hp_unlock; echo "status=done task=$n"; return 0; fi
  if [ "$rc" -ne 1 ]; then hp_unlock; echo "status=error"; return 2; fi
  # An existing claim answers held exactly as it always has, even if a plan
  # amendment has since added a predecessor: the dependency check guards
  # publication, and only a takeover publishes a new record. A takeover by
  # the owner itself is the owner's retry, not a publication.
  if [ -d "$target" ] && { [ "$takeover" -eq 0 ] || [ "$(sed -n 's/^session=//p' "$target/owner" 2>/dev/null)" = "$sid" ]; }; then
    claim_held; return $?
  fi
  # Every parse error refuses the claim, registered or not: a plan with an
  # invalid graph would let two sessions claim dependent tasks together. Two
  # carve-outs keep plans that never had a graph claimable as before, and
  # apply only without a plan line: a plan absent from both the ref and the
  # working tree, and a plan with no task headings at all (an empty graph,
  # so there is nothing to violate).
  claim_quiet() { if [ -n "$line" ]; then "$@"; else "$@" 2>/dev/null; fi; }
  deps=none
  if pair=$(claim_quiet authoritative_plan_blob); then
    blob=${pair%% *}; tmp=${pair#* }
    graph=$(hp_plan_graph "$tmp"); rc=$?; rm -f "$tmp"
    if [ "$rc" -ne 0 ]; then hp_unlock; echo "status=invalid plan=${blob:0:7}"; return 2; fi
    if [ -n "$graph" ] || [ -n "$line" ]; then
      deps=$(printf '%s\n' "$graph" | sed -n "s/^task=$n depends=//p")
      [ -n "$deps" ] || { hp_unlock; echo "sdd-state: task $n is not in the plan" >&2; echo "status=error"; return 2; }
    fi
  elif [ -n "$line" ] || [ -e "$PLAN" ]; then
    hp_unlock; echo "status=error"; return 2
  fi
  waiting=""
  if [ "$deps" != none ]; then
    for d in $(printf '%s' "$deps" | tr ',' ' '); do
      ledger_task_complete "$WSDIR/progress.md" "$d" || waiting="$waiting,$d"
    done
  fi
  if [ -n "$waiting" ]; then hp_unlock; echo "status=blocked task=$n waiting=${waiting#,} plan=${blob:0:7}"; return 7; fi
  if [ -n "$line" ]; then
    lease=$(hp_lease_key "$PLAN_DIR" "$integ")
    if [ -f "$lease" ] && [ "$(sed -n 's/^closing=//p' "$lease")" = 1 ]; then hp_unlock; echo "status=branch-closing"; return 15; fi
    from=$(git -C "$code" rev-parse -q --verify "refs/heads/$integ^{commit}" 2>/dev/null) || { hp_unlock; echo "sdd-state: the integration branch $integ does not exist in $code" >&2; echo "status=error"; return 2; }
    ref=$(claim_task_branch_name "$integ" "$(ws8_of "$WS")" "$n")
  fi
  hp_contained "$ROOT" "plans/$WS/claims" || { hp_unlock; echo "status=error"; return 2; }
  mkdir -p "$claims" || { hp_unlock; echo "status=error"; return 2; }
  # A task branch that is not exactly at its base is a leftover of an
  # abandoned run; refusing it here, before the record is published, keeps
  # the claim from owning commits it never made. A takeover's branch takes the
  # smallest unused suffix, so it never meets this.
  if [ -n "$ref" ] && ! { [ "$takeover" -eq 1 ] && [ -d "$target" ]; } && have=$(git -C "$code" rev-parse -q --verify "refs/heads/$ref^{commit}" 2>/dev/null) && [ "$have" != "$from" ]; then
    hp_unlock; echo "sdd-state: $ref already exists at ${have:0:7}, not at its base ${from:0:7}; it is a leftover of an abandoned run" >&2; echo "status=error"; return 2
  fi
  if [ "$takeover" -eq 1 ] && [ -d "$target" ]; then
    if [ -n "$ref" ]; then
      prev_ref=""
      [ -z "$(sed -n 's/^from=//p' "$target/owner" 2>/dev/null)" ] || prev_ref=$(sed -n 's/^branch=//p' "$target/owner" 2>/dev/null)
      k=2; while git -C "$code" rev-parse -q --verify "refs/heads/$ref.$k" >/dev/null 2>&1; do k=$((k + 1)); done
      if [ -n "$prev_ref" ] && tb=$(git -C "$code" rev-parse -q --verify "refs/heads/$prev_ref^{commit}" 2>/dev/null); then from=$tb; fi
      ref="$ref.$k"
    fi
    # New record first (invisible until the rename), then the history line,
    # then the atomic replacement; a failure anywhere leaves the old owner.
    if ! owner_record "$sid" "$ref" "$from" > "$target/owner.new"; then rm -f "$target/owner.new"; hp_unlock; echo "status=error"; return 2; fi
    prev=$(cat "$target/owner" 2>/dev/null)
    if ! printf -- '--- superseded at %s\n%s\n' "$(hp_utc_now)" "$prev" >> "$target/owner.history"; then rm -f "$target/owner.new"; hp_unlock; echo "status=error"; return 2; fi
    if ! mv -f "$target/owner.new" "$target/owner"; then rm -f "$target/owner.new"; hp_unlock; echo "status=error"; return 2; fi
    if [ "$(sed -n 's/^session=//p' "$target/owner" 2>/dev/null)" != "$sid" ]; then hp_unlock; echo "status=error"; return 2; fi
    claim_finish_branch strict || { hp_unlock; echo "status=error"; return 2; }
    hp_unlock
    echo "status=claimed task=$n takeover=1${branch_out}"; return 0
  fi
  tmp=$(mktemp -d "$claims/.tmp-XXXXXX") || { hp_unlock; echo "status=error"; return 2; }
  if ! owner_record "$sid" "$ref" "$from" > "$tmp/owner"; then rm -rf "$tmp"; hp_unlock; echo "status=error"; return 2; fi
  node -e 'const fs=require("fs");try{fs.renameSync(process.argv[1],process.argv[2]);}catch(e){process.exit(e.code==="ENOTEMPTY"||e.code==="EEXIST"?4:2);}' "$tmp" "$target"; rc=$?
  if [ "$rc" -eq 0 ]; then
    if [ "$(sed -n 's/^session=//p' "$target/owner" 2>/dev/null)" != "$sid" ]; then hp_unlock; echo "status=error"; return 2; fi
    if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = claim-after-rename ]; then hp_unlock; exit 99; fi
    claim_finish_branch strict || { hp_unlock; echo "status=error"; return 2; }
    hp_unlock; echo "status=claimed task=$n${branch_out}"; return 0
  fi
  rm -rf "$tmp"
  if [ "$rc" -ne 4 ]; then hp_unlock; echo "status=error"; return 2; fi
  claim_held; return $?
}
# --- next --------------------------------------------------------------------
# Classifies every open task of the authoritative plan. The assignment split
# comes first: a task outside the session's assigned list is excluded
# whatever its graph state. Every allowed task is then claimable,
# own-blocked, held, or waiting, and the waiting kind is the first kind
# found in the order held, own-blocked, excluded, open over its incomplete
# predecessors, transitively. The classification is total, so the status
# below is defined for every ledger. Bash 3.2 has no associative arrays, so
# the three maps are variables named by task number. The key is spliced into
# an eval, so both helpers refuse anything but digits themselves instead of
# trusting the plan parser to have kept the id clean.
map_set() { # map_set DEP 5 "1,3"
  case "$2" in ''|*[!0-9]*) echo "sdd-state: not a task number: $2" >&2; return 2 ;; esac
  eval "MAP_$1_$2=\$3"
}
map_get() { # map_get DEP 5
  case "$2" in ''|*[!0-9]*) echo "sdd-state: not a task number: $2" >&2; return 2 ;; esac
  eval "printf '%s' \"\${MAP_$1_$2:-}\""
}
cmd_next() {
  local plan="" sid="" code="" rc out
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) [ -z "$plan" ] || usage; plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] && [ -n "$sid" ] || usage
  resolve_plan "$plan"
  # Recovery comes first: a sync that crashed while introducing this plan's
  # workspace leaves no ledger on disk until the apply is finished, and the
  # workspace check below would call that state no-workspace. The lock also
  # covers the classification, which reads the ledger and the claims, so a
  # stale working-tree ledger cannot offer a task the recovered assignment
  # line excludes.
  hp_lock "$PLAN_DIR" || { echo "status=error"; return 2; }
  recover_apply || { hp_unlock; echo "status=error"; return 2; }
  if [ ! -f "$WSDIR/progress.md" ]; then hp_unlock; echo "status=no-workspace"; return 2; fi
  out=$(code_repo_arg "$code" "$WSDIR/progress.md") || {
    rc=$?; hp_unlock
    [ -z "$out" ] || printf '%s\n' "$out"
    return "$rc"
  }
  code=$out
  out=$(next_classify "$sid"); rc=$?
  hp_unlock
  printf '%s\n' "$out"
  return "$rc"
}
# <sid> -> the status line, from the resolved plan's state alone. The board
# calls this directly rather than the subcommand, so a board run from a cwd
# that is no repository still computes the frontier.
next_classify() {
  local sid=$1 pair blob tmp graph t deps cls assigned="" line n_list mine_list own_list held_list wait_list excl_list waitown_list remaining held_all open_any=0 p rc owner
  pair=$(authoritative_plan_blob) || { echo "status=error"; return 2; }
  blob=${pair%% *}; tmp=${pair#* }
  graph=$(hp_plan_graph "$tmp"); rc=$?; rm -f "$tmp"
  [ "$rc" -eq 0 ] || { echo "status=invalid plan=${blob:0:7}"; return 2; }
  # A fixed-string prefix match: an id with a regex metacharacter must not
  # match another session's assignment line.
  assigned=$(SID=$sid awk 'BEGIN { p = "session " ENVIRON["SID"] ": tasks " } index($0, p) == 1 { l = substr($0, length(p) + 1); gsub(/ /, "", l); found = l } END { print found }' "$WSDIR/progress.md" 2>/dev/null)
  # A plan with no task headings leaves nothing to claim.
  [ -n "$graph" ] || { echo "status=none reason=complete"; return 0; }
  while IFS= read -r line; do
    t=${line#task=}; t=${t%% *}; deps=${line#*depends=}
    map_set DEP "$t" "$deps" && map_set CLASS "$t" "" && map_set OWNER "$t" "" || { echo "status=invalid plan=${blob:0:7}"; return 2; }
    # An unreadable ledger is an error, never "not complete": reading it as
    # open work would offer finished tasks to a session.
    ledger_task_complete "$WSDIR/progress.md" "$t"; rc=$?
    if [ "$rc" -eq 0 ]; then map_set CLASS "$t" complete; continue; fi
    if [ "$rc" -ne 1 ]; then echo "sdd-state: cannot read $WSDIR/progress.md" >&2; echo "status=error"; return 2; fi
    open_any=1
    if [ -e "$WSDIR/claims/task-$t" ]; then
      # A claim directory whose owner cannot be read is no claim at all to
      # this code, yet claim refuses the task, so it must not be offered.
      owner=$(sed -n 's/^session=//p' "$WSDIR/claims/task-$t/owner" 2>/dev/null | head -n 1)
      if [ -z "$owner" ]; then echo "sdd-state: claim owner unreadable or without a session: $WSDIR/claims/task-$t/owner" >&2; echo "status=error"; return 2; fi
      map_set OWNER "$t" "$owner"
    fi
  done <<< "$graph"
  [ "$open_any" -eq 1 ] || { echo "status=none reason=complete"; return 0; }
  allowed() { [ -z "$assigned" ] && return 0; case ",$assigned," in *",$1,"*) return 0 ;; esac; return 1; }
  # Classes resolve recursively through the predecessors; a valid graph has
  # no cycle, so the recursion ends.
  classify() { # <task> -> sets CLASS[task]
    local task=$1 kinds="" p pc owner
    [ -z "$(map_get CLASS "$task")" ] || return 0
    if ! allowed "$task"; then map_set CLASS "$task" excluded; return 0; fi
    if [ "$(map_get DEP "$task")" != none ]; then
      for p in $(map_get DEP "$task" | tr ',' ' '); do
        classify "$p"; pc=$(map_get CLASS "$p")
        [ "$pc" != complete ] || continue
        case "$pc" in held|waiting-on-held) kinds="$kinds held" ;; own-blocked|waiting-on-own-blocked) kinds="$kinds own" ;; excluded|waiting-on-excluded) kinds="$kinds excluded" ;; *) kinds="$kinds open" ;; esac
      done
    fi
    owner=$(map_get OWNER "$task")
    if [ -n "$owner" ] && [ "$owner" != "$sid" ]; then map_set CLASS "$task" held; return 0; fi
    if [ -z "$kinds" ]; then map_set CLASS "$task" claimable; return 0; fi
    if [ -n "$owner" ]; then map_set CLASS "$task" own-blocked; return 0; fi
    case " $kinds " in *" held "*) map_set CLASS "$task" waiting-on-held ;; *" own "*) map_set CLASS "$task" waiting-on-own-blocked ;; *" excluded "*) map_set CLASS "$task" waiting-on-excluded ;; *) map_set CLASS "$task" waiting-on-open ;; esac
  }
  n_list=""; mine_list=""; own_list=""; held_list=""; wait_list=""; excl_list=""; waitown_list=""; remaining=""; held_all=""
  while IFS= read -r line; do
    t=${line#task=}; t=${t%% *}
    [ "$(map_get CLASS "$t")" != complete ] || continue
    classify "$t"
    cls=$(map_get CLASS "$t")
    if [ -n "$(map_get OWNER "$t")" ] && [ "$(map_get OWNER "$t")" != "$sid" ]; then held_all="${held_all:+$held_all,}$t@$(map_get OWNER "$t")"; fi
    case "$cls" in
      claimable) if [ "$(map_get OWNER "$t")" = "$sid" ]; then mine_list="${mine_list:+$mine_list,}$t"; else n_list="${n_list:+$n_list,}$t"; fi ;;
      own-blocked) own_list="${own_list:+$own_list,}$t" ;;
      held) held_list="${held_list:+$held_list,}$t@$(map_get OWNER "$t")" ;;
      waiting-on-held) wait_list="${wait_list:+$wait_list,}$t" ;;
      waiting-on-own-blocked) waitown_list="${waitown_list:+$waitown_list,}$t" ;;
      waiting-on-excluded|waiting-on-open) excl_list="${excl_list:+$excl_list,}$t" ;;
      excluded) remaining="${remaining:+$remaining,}$t" ;;
    esac
  done <<< "$graph"
  # This session's own claims lead, each group in heading order.
  n_list="$mine_list${mine_list:+${n_list:+,}}$n_list"
  if [ -n "$n_list" ]; then echo "status=next tasks=$n_list own-blocked=${own_list:-none} plan=${blob:0:7}"; return 0; fi
  if [ -n "$own_list" ] || [ -n "$waitown_list" ]; then
    t=${own_list%%,*}; [ -n "$t" ] || t=${waitown_list%%,*}
    wait_list=""
    for p in $(map_get DEP "$t" | tr ',' ' '); do
      [ "$(map_get CLASS "$p")" != complete ] || continue
      if [ -n "$(map_get OWNER "$p")" ] && [ "$(map_get OWNER "$p")" != "$sid" ]; then wait_list="${wait_list:+$wait_list,}$p@$(map_get OWNER "$p")"; else wait_list="${wait_list:+$wait_list,}$p"; fi
    done
    echo "status=none reason=own-blocked task=$t waiting=$wait_list"; return 0
  fi
  if [ -n "$assigned" ] && [ -z "$held_list" ] && [ -z "$wait_list" ] && [ -z "$excl_list" ]; then echo "status=none reason=assigned-complete remaining=${remaining:-none}"; return 0; fi
  if [ -z "$excl_list" ]; then echo "status=none reason=held held=$held_list waiting=${wait_list:-none}"; return 0; fi
  echo "status=none reason=blocked waiting=$excl_list excluded=${remaining:-none} held=${held_all:-none}"
}

# --- import ------------------------------------------------------------------
# Move a workspace an older plugin (or a plain-backend run) left in the plain
# cache into place. Candidates resolve to their physical referents; the copy
# is staged beside the destination, compared with the source by manifest, and
# only then installed and the source replaced by a symlink. A failure leaves
# the source untouched and no ledger in the destination, so the next call
# retries instead of reporting ledger-exists.
IDENTITY_PREFIX="# SDD ledger $(printf '\xe2\x80\x94') plan: "
rewrite_identity_line() { # <ledger> <rel>: an absolute identity inside REPO, or ending in /<rel>, becomes <rel>
  local first path tmp
  first=$(head -n 1 "$1")
  case "$first" in
    "$IDENTITY_PREFIX"/*) path=${first#"$IDENTITY_PREFIX"} ;;
    *) return 0 ;;
  esac
  case "$path" in
    "$REPO"/*) [ "${path#"$REPO"/}" = "$2" ] || return 0 ;;
    */"$2") [ ! -e "$path" ] || return 0 ;;
    *) return 0 ;;
  esac
  tmp="$1.tmp.$$"
  if ! { printf '%s%s\n' "$IDENTITY_PREFIX" "$2"; tail -n +2 "$1"; } > "$tmp" || ! mv -f "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
}
# <dir> -> one line per entry: type, size or link target, path; sorted.
tree_manifest() {
  ( cd "$1" && find . -mindepth 1 \( -type f -o -type d -o -type l \) | LC_ALL=C sort | while IFS= read -r e; do
      if [ -L "$e" ]; then printf 'l %s %s\n' "$(readlink "$e")" "$e"
      elif [ -f "$e" ]; then printf 'f %s %s\n' "$(wc -c < "$e" | tr -d ' ')" "$e"
      else printf 'd - %s\n' "$e"; fi
    done )
}
# <manifest> <dst>: every line of <manifest> (tree_manifest output for the
# staged copy) is present in dst with the same type and size.
verify_subset() {
  local line dst_manifest
  dst_manifest=$(tree_manifest "$2")
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    grep -Fxq -- "$line" < <(printf '%s\n' "$dst_manifest") || return 1
  done < <(printf '%s\n' "$1")
  return 0
}
# <candidate>: an interrupted import leaves the source renamed aside as
# <ref>.importing-<pid> and nothing at the legacy path (or a dangling
# pointer). Put it back before the candidate is examined. Returns 0 when a
# backup was put back, so the caller can finish a cutover that had already
# published the destination. Runs under the lock.
recover_import_backup() {
  local t b
  if [ -L "$1" ]; then t=$(readlink "$1"); else t=$1; fi
  [ -e "$t" ] && return 1
  for b in "$t".importing-*; do
    [ -d "$b" ] || continue
    mv "$b" "$t" 2>/dev/null && return 0
  done
  return 1
}
# <legacy path>: set every <path>.importing-* copy aside as
# <path>.imported-<UTC>-<pid>, the name a complete import leaves. The copy
# stays beside the pointer for a session on the previous plugin that still
# holds the legacy ledger open, and the plain-cache reclaim takes it with its
# root after 14 idle days. `.imported-` is not `.importing-`:
# recover_import_backup and reclaim_plain match the latter only. A name that
# is already taken gets a counter, so BSD mv never nests one copy in another.
# Returns 0 when no .importing-* copy is left, 1 otherwise.
set_aside_imported() {
  local b kept n=0 left=0
  for b in "$1".importing-*; do
    [ -d "$b" ] || continue
    kept="$1.imported-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    while [ -e "$kept" ] || [ -L "$kept" ]; do n=$((n + 1)); kept="$1.imported-$(date -u +%Y%m%dT%H%M%SZ)-$$-$n"; done
    mv "$b" "$kept" 2>/dev/null || { echo "sdd-state: the imported source could not be set aside at $kept; it is still at $b and the next import will try again" >&2; left=1; }
  done
  return "$left"
}
# <candidate> <backup> <ref> <stage> <installed>: undo an import that failed
# after the source was renamed aside. <installed> is "" (nothing published),
# "whole" (the destination was published by one rename) or "ledger" (entries
# were installed into an existing destination). Leaves no ledger in the
# destination, puts the source back, releases the lock and prints the
# failure line; the caller returns 2. A failure after the set-aside finds no
# backup at <backup>: the source is then the newest kept copy, and it goes
# back from there, so a failed relink still leaves the source where it was.
import_abort() {
  local src
  [ -z "$4" ] || rm -rf "$4"
  case "$5" in
    whole) rm -rf "$dest" ;;
    ledger) rm -f "$dest/progress.md" ;;
  esac
  [ ! -L "$3" ] || rm -f "$3"
  src=$2
  [ -d "$src" ] || src=$(ls -d "$3".imported-* 2>/dev/null | tail -n 1)
  if [ ! -e "$3" ]; then mv "${src:-$2}" "$3" 2>/dev/null || echo "sdd-state: could not restore the legacy workspace; it is at ${src:-$2}" >&2; fi
  if [ "$1" != "$3" ] && [ ! -e "$1" ] && [ ! -L "$1" ]; then ln -s "$3" "$1" 2>/dev/null || true; fi
  hp_unlock
  echo "status=import-failed from=$(enc "$1")"
}
# <dest-ledger> <source-ledger>: 0 when the destination's ledger body (from
# its second line) is a prefix of the source's — the published copy, with
# whatever the source was appended to with since. An empty body is a prefix
# of anything, and head -c 0 is an error on BSD, so it answers first.
ledger_body_prefix() {
  local dbody
  [ -f "$1" ] && [ -f "$2" ] || return 1
  dbody=$(tail -n +2 "$1" | wc -c | tr -d ' ')
  [ "$dbody" -gt 0 ] || return 0
  cmp -s <(tail -n +2 "$1") <(tail -n +2 "$2" | head -c "$dbody")
}
# <ref> <dest>: 0 when the destination holds a published copy of the source:
# every entry of the source other than the ledger is present with the same
# type and size, and the destination's ledger body (from line 2) is a prefix
# of the source's: identical, or the source gained an append after the copy
# was taken. Sets published_prefix_size to the number of source-ledger bytes
# the destination already holds (its first line plus the shared body), so
# import_finish reconciles only the remainder. Used to finish a cutover that
# was interrupted after publication.
import_published() {
  local rest dbody head1
  rest=$(tree_manifest "$1" | grep -v ' \./progress\.md$')
  verify_subset "$rest" "$2" || return 1
  ledger_body_prefix "$2/progress.md" "$1/progress.md" || return 1
  dbody=$(tail -n +2 "$2/progress.md" | wc -c | tr -d ' ')
  head1=$(head -n 1 "$1/progress.md" | wc -c | tr -d ' ')
  published_prefix_size=$((head1 + dbody))
}
# <candidate> <backup> <ref>: reconcile a ledger append that landed in the
# source after it was copied (the ledger is append-only, so the new bytes
# are added to the destination), verify that the two ledger bodies then
# agree from their second line on and that nothing else changed, set the
# backup aside as the kept copy (set_aside_imported), and relink the legacy
# path (or the pointer) to the destination and check it resolves there.
# Reconciliation runs before the set-aside so a crash leaves the legacy path
# absent and the backup recoverable; a crash after it leaves the kept copy
# and no pointer, which the next import's candidate loop completes. Any
# failure or non-append change aborts with the source restored, and the next
# import starts over from the current source. Reads src_ledger_size and
# src_manifest_rest from the caller (both taken from the frozen copy).
# Returns 2 after import_abort on failure.
import_finish() {
  local link now
  now=$(wc -c < "$2/progress.md" 2>/dev/null | tr -d ' ')
  if [ "${now:-0}" -gt "$src_ledger_size" ]; then
    tail -c +"$((src_ledger_size + 1))" "$2/progress.md" >> "$dest/progress.md" || { import_abort "$1" "$2" "$3" "" "$installed"; return 2; }
  fi
  if ! cmp -s <(tail -n +2 "$2/progress.md" 2>/dev/null) <(tail -n +2 "$dest/progress.md") || [ "$(tree_manifest "$2" | grep -v ' \./progress\.md$')" != "$src_manifest_rest" ]; then
    echo "sdd-state: the legacy workspace changed while it was imported; nothing was moved, run import again" >&2
    import_abort "$1" "$2" "$3" "" "$installed"; return 2
  fi
  # The kept copy is made before the pointer: a crash between the two leaves
  # the destination complete, the copy beside the source's location and no
  # pointer, and the next import completes the relink (cmd_import). A copy
  # that cannot be set aside keeps the import unfinished rather than leaving
  # .importing-* beside a published pointer.
  set_aside_imported "$3" || { import_abort "$1" "$2" "$3" "" "$installed"; return 2; }
  if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = import-after-set-aside ]; then hp_unlock; exit 99; fi
  if [ -L "$1" ]; then link=$1; else link=$3; fi
  if [ -n "${HYPERPOWERS_TEST_FAIL_RELINK:-}" ] || ! ln -sfn "$dest" "$link" 2>/dev/null || [ "$(hp_physical_dir "$link" 2>/dev/null)" != "$(hp_physical_dir "$dest")" ]; then
    import_abort "$1" "$2" "$3" "" "$installed"; return 2
  fi
  hp_unlock
  if [ "${conflicts:-0}" -gt 0 ]; then echo "status=moved from=$(enc "$1") conflicts=$conflicts"; else echo "status=moved from=$(enc "$1")"; fi
  return 0
}
cmd_import() {
  # installed="" is "nothing this attempt published": the finish of a cutover
  # interrupted after publication reaches import_finish without setting it,
  # and an abort there must not remove the destination it found.
  local plan cache candidates c t ref dest dest_phys seen="" stage e name rel stage_manifest backup link rc restored installed="" conflicts=0 dbody src_ledger_size src_manifest_rest published_prefix_size legacy_root quarantine q repair
  [ $# -eq 1 ] || usage
  plan=$1
  command -v node >/dev/null 2>&1 || { echo "sdd-state: node not found" >&2; return 2; }
  resolve_plan "$plan"
  dest="$WSDIR"
  rel=$(hp_plan_rel "$plan")
  cache="$(hp_cache_root)/sdd"
  if [ "$BACKEND" = plain ]; then
    hp_lock "$PLAN_DIR" || return 2
    if ! hp_materialize_plain "$PLAN_DIR" "$WS" "$dest"; then hp_unlock; echo "status=import-failed from=$(enc "$BRANCH")"; return 2; fi
    hp_unlock
  fi
  candidates="$cache/$(hp_legacy_key "$PLAN_DIR")/plans/$WS"
  # The cwd's unsuffixed legacy workspace qualifies only when the cwd is a
  # worktree of the plan repository: another repository with a plan at the
  # same relative path owns a workspace of the same name, and a cross-
  # repository run before 6.16.0 left ambiguous copies that stay manual.
  if git rev-parse --git-dir >/dev/null 2>&1 && [ "$(hp_key .)" = "$(hp_key "$PLAN_DIR")" ]; then
    candidates="$candidates
$cache/$(hp_legacy_key .)/plans/$WS"
  fi
  # Pointers carry the plan repository's key prefix as their suffix; only
  # this repository's suffixes qualify, so another repository that happens
  # to hold a plan at the same relative path is never touched. A dangling
  # pointer qualifies too: its referent may be a backup an interrupted
  # import left aside.
  for c in "$cache"/*/plans/"$WS"+"$(hp_legacy_key "$PLAN_DIR" | cut -c1-8)" "$cache"/*/plans/"$WS"+"$(hp_key "$PLAN_DIR" | cut -c1-8)"; do
    { [ -e "$c" ] || [ -L "$c" ]; } && candidates="$candidates
$c"
  done
  if [ "$BACKEND" = branch ]; then
    candidates="$candidates
$cache/$(hp_key "$PLAN_DIR")/plans/$WS"
  fi
  # The lock is taken before any candidate is resolved or the destination is
  # read, so two importers cannot both find the destination empty.
  hp_lock "$PLAN_DIR" || return 2
  dest_phys=$(hp_physical_dir "$dest" 2>/dev/null) || dest_phys=$dest
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    if recover_import_backup "$c"; then restored=1; else restored=0; fi
    # A kept copy beside an absent candidate (or beside a dangling pointer's
    # referent, or inside the root the plain-cache reclaim has claimed since)
    # while the destination already holds a ledger is an import interrupted
    # between its set-aside and its relink: finish the relink. The copy stays
    # where it is; only the pointer moves.
    if [ ! -e "$c" ] && [ -f "$dest/progress.md" ]; then
      if [ -L "$c" ]; then t=$(readlink "$c"); else t=$c; fi
      if hp_kept_copy_exists "$t"; then
        if [ -L "$c" ]; then link=$c; else link=$t; fi
        # The reclaim can have taken the legacy root with the kept copy
        # inside it, and the pointer still belongs where the workspace was:
        # the plans directory comes back empty, holding nothing but the link.
        mkdir -p "$(dirname "$link")" 2>/dev/null || true
        if ln -sfn "$dest" "$link" 2>/dev/null && [ "$(hp_physical_dir "$link" 2>/dev/null)" = "$dest_phys" ]; then
          hp_unlock; echo "status=moved from=$(enc "$c")"; return 0
        fi
        hp_unlock; echo "status=import-failed from=$(enc "$c")"; return 2
      fi
    fi
    # A candidate with no ledger of its own, while the plain-cache reclaim
    # holds one for this workspace under the root's staging, quarantine or
    # deletion name: the dossier is still there, and passing it by would
    # start a fresh ledger beside a tree phase two deletes in 14 days. The
    # candidate need not be absent for that. On the plain backend sdd-dir
    # recreates the root and the empty workspace directory before it calls
    # import, and its no-argument form recreates the cwd key's root, so
    # after a reclaim the live candidate is usually an empty directory
    # rather than a missing one. What a quarantine holds under plans/<ws>
    # is always a workspace no import ever reached, because an import
    # renames its source aside to .importing-* or .imported-* first. A
    # candidate that does hold a ledger keeps the handling below: a
    # quarantined duplicate beside an established ledger is a split that
    # predates this check and stays manual.
    if [ -L "$c" ]; then t=$(readlink "$c"); else t=$c; fi
    case "$t" in
      */plans/*)
        legacy_root=${t%/plans/*}
        if [ ! -f "$t/progress.md" ]; then
          for q in "$legacy_root".claiming-*/plans/"${t##*/}"/progress.md "$legacy_root".reclaiming-*/plans/"${t##*/}"/progress.md "$legacy_root".gone-*/plans/"${t##*/}"/progress.md; do
            [ -f "$q" ] || continue
            quarantine=${q%/plans/*}
            # The repair is a move a human makes, and which move depends on
            # the workspace directory rather than on the root. A root that
            # is back cannot take the whole quarantine, because BSD mv
            # would nest it inside, so only the workspace moves; whether
            # that move needs the empty directory sdd-dir left removed
            # first, or plans/ created first, is what the root alone does
            # not say. The root can be there without plans/<ws>: the
            # no-argument form of sdd-dir creates it that way, so does the
            # plan form's pointer bookkeeping, and so does a human who
            # cleared the empty directory after an earlier refusal.
            if [ ! -e "$legacy_root" ]; then
              repair="mv $quarantine $legacy_root"
            elif [ -e "$t" ]; then
              repair="rmdir $t && mv $quarantine/plans/${t##*/} $t"
            else
              repair="mkdir -p ${t%/*} && mv $quarantine/plans/${t##*/} $t"
            fi
            hp_unlock
            echo "sdd-state: the legacy workspace for this plan sits in a cache root the plain-cache reclaim set aside at $quarantine; move it back ($repair) and run sdd-state import $plan again, or remove it (rm -rf \"$quarantine\") if you know that copy is stale" >&2
            echo "status=error"; return 2
          done
        fi
        ;;
    esac
    [ -e "$c" ] || continue
    ref=$(hp_physical_dir "$c") || continue
    [ "$ref" != "$dest_phys" ] || continue
    case " $seen " in *" $ref "*) continue ;; esac
    seen="$seen $ref"
    [ -f "$ref/progress.md" ] || continue
    if [ -f "$dest/progress.md" ]; then
      # A cutover interrupted after publication left the source (just put
      # back from its backup) beside a complete destination: finish it. The
      # baseline is taken before the comparison, so a write that lands
      # afterwards is reconciled, not blessed.
      if [ "$restored" -eq 1 ]; then
        src_ledger_size=$(wc -c < "$ref/progress.md" | tr -d ' ')
        src_manifest_rest=$(tree_manifest "$ref" | grep -v ' \./progress\.md$')
        if import_published "$ref" "$dest"; then
          # The destination already holds this prefix of the source ledger;
          # import_finish reconciles whatever the source gained after it.
          src_ledger_size=$published_prefix_size
          backup="$ref.importing-$$"
          # The source's root is touched before anything is renamed aside, so the
          # 14-day reclaim of plain-cache roots does not take the backup with it.
          # A finished import leaves <ref>.imported-<UTC>-<pid>, which the
          # reclaim does take.
          touch "$(dirname "$(dirname "$ref")")" 2>/dev/null || true
          mv "$ref" "$backup" 2>/dev/null || { hp_unlock; echo "status=import-failed from=$(enc "$c")"; return 2; }
          import_finish "$c" "$backup" "$ref"; return $?
        fi
      fi
      # The source can have outgrown the published copy by more than its
      # ledger: an older controller still holding the legacy path writes a
      # report too, and import_published's subset check then fails. While
      # the destination's ledger is still a prefix of the source's, that is
      # the same interrupted cutover, so it falls through to the cutover
      # below, whose rc=4 branch installs the extra entries with the ledger
      # last. Anything else is a destination this import must not touch.
      if [ "$restored" -ne 1 ] || ! ledger_body_prefix "$dest/progress.md" "$ref/progress.md"; then
        hp_unlock; echo "status=skipped reason=ledger-exists path=$(enc "$c")"; return 0
      fi
    fi
    # The cutover is a transaction: the source is renamed aside first, so
    # no new opener can write to it; the staged copy is verified against
    # that quiesced tree; the installed tree is verified; then a late
    # ledger append is reconciled, the backup is set aside as the kept
    # copy, and the relink of the legacy path goes last. Any failure
    # removes the installed ledger and puts the source back.
    backup="$ref.importing-$$"
    # The source's root is touched before anything is renamed aside, so the
    # 14-day reclaim of plain-cache roots does not take the backup with it.
    # A finished import leaves <ref>.imported-<UTC>-<pid>, which the reclaim
    # does take.
    touch "$(dirname "$(dirname "$ref")")" 2>/dev/null || true
    mv "$ref" "$backup" 2>/dev/null || { hp_unlock; echo "status=import-failed from=$(enc "$c")"; return 2; }
    stage="$dest.import-$$"
    rm -rf "$stage"; mkdir -p "$stage"
    if ! cp -a "$backup/." "$stage/" 2>/dev/null || [ "$(tree_manifest "$backup")" != "$(tree_manifest "$stage")" ]; then
      import_abort "$c" "$backup" "$ref" "$stage" ""; return 2
    fi
    # The baseline comes from the staged copy, frozen at cp: every byte the
    # source gains after the copy is outside it and gets reconciled.
    src_ledger_size=$(wc -c < "$stage/progress.md" | tr -d ' ')
    src_manifest_rest=$(tree_manifest "$stage" | grep -v ' \./progress\.md$')
    if [ -n "${HYPERPOWERS_TEST_LATE_APPEND:-}" ]; then printf '%s\n' "$HYPERPOWERS_TEST_LATE_APPEND" >> "$backup/progress.md"; fi
    if [ -n "${HYPERPOWERS_TEST_LATE_REPLACE:-}" ]; then printf '%s\n' "$HYPERPOWERS_TEST_LATE_REPLACE" > "$backup/progress.md"; fi
    # The identity is rewritten in the stage, and the installed tree is
    # verified against the stage's manifest, so the rewrite never reads as a
    # size mismatch.
    if ! rewrite_identity_line "$stage/progress.md" "$rel"; then import_abort "$c" "$backup" "$ref" "$stage" ""; return 2; fi
    stage_manifest=$(tree_manifest "$stage")
    installed=ledger
    # Publish by rename(2): it replaces an absent or empty destination
    # atomically and refuses a non-empty one, so the stage can never land
    # inside a destination that filled up meanwhile (a shell mv would move
    # it in); a refusal takes the per-entry path.
    node -e 'const fs=require("fs");try{fs.renameSync(process.argv[1],process.argv[2]);}catch(e){process.exit(e.code==="ENOTEMPTY"||e.code==="EEXIST"?4:2);}' "$stage" "$dest"; rc=$?
    if [ "$rc" -eq 0 ]; then
      [ -f "$dest/progress.md" ] || { import_abort "$c" "$backup" "$ref" "" whole; return 2; }
    elif [ "$rc" -eq 4 ]; then
      # The destination already holds files, and a controller may be working
      # in it: only entries it does not have are installed, the ledger last
      # and by appending, so a failure leaves no ledger this import brought
      # and never takes the destination's own.
      [ ! -f "$dest/progress.md" ] || installed=""
      for e in "$stage"/* "$stage"/.[!.]*; do
        [ -e "$e" ] || [ -L "$e" ] || continue
        name=${e##*/}
        [ "$name" != progress.md ] || continue
        { [ -e "$dest/$name" ] || [ -L "$dest/$name" ]; } || continue
        if [ -L "$e" ] || [ -L "$dest/$name" ]; then
          if [ -L "$e" ] && [ -L "$dest/$name" ] && [ "$(readlink "$e")" = "$(readlink "$dest/$name")" ]; then rm -rf "$e"; continue; fi
        elif diff -r -q "$e" "$dest/$name" >/dev/null 2>&1; then
          rm -rf "$e"; continue
        fi
        # The destination's entry was written after the copy this import is
        # recovering: it stays, and the legacy one lands beside it, unless
        # the branch ignores the name. A brief or a review package
        # regenerates on any host and never travels, so no copy is kept.
        conflicts=$((conflicts + 1))
        if git -C "$CO" check-ignore -q "plans/$WS/$name" 2>/dev/null; then
          rm -rf "$e"
          echo "sdd-state: $dest/$name differs from the legacy copy, which is regenerable, not copied" >&2
          continue
        fi
        rm -rf "$dest/$name.from-import"
        if ! mv -f "$e" "$dest/$name.from-import" 2>/dev/null; then
          cp -a "$e" "$dest/$name.from-import" || { import_abort "$c" "$backup" "$ref" "$stage" "$installed"; return 2; }
          rm -rf "$e"
        fi
        echo "sdd-state: $dest/$name differs from the legacy copy and was kept; the legacy one is beside it at $dest/$name.from-import" >&2
      done
      # What is left in the stage is what this import installs, and what the
      # destination is verified against; the ledger is checked by body.
      stage_manifest=$(tree_manifest "$stage" | grep -v ' \./progress\.md$')
      for e in "$stage"/* "$stage"/.[!.]*; do
        [ -e "$e" ] || [ -L "$e" ] || continue
        [ "${e##*/}" != progress.md ] || continue
        if ! mv -f "$e" "$dest/" 2>/dev/null; then cp -a "$e" "$dest/" || { import_abort "$c" "$backup" "$ref" "$stage" "$installed"; return 2; }; fi
      done
      if [ -n "${HYPERPOWERS_TEST_DEST_APPEND:-}" ]; then printf '%s\n' "$HYPERPOWERS_TEST_DEST_APPEND" >> "$dest/progress.md"; fi
      if [ -z "$installed" ]; then
        # The destination's ledger is the live one: only the bytes the
        # legacy ledger holds beyond it are appended.
        dbody=$(tail -n +2 "$dest/progress.md" | wc -c | tr -d ' ')
        if ! ledger_body_prefix "$dest/progress.md" "$stage/progress.md"; then
          echo "sdd-state: $dest/progress.md was written to while the import ran and is no longer a prefix of the legacy ledger; the files only the legacy workspace held were moved into $dest, which kept its own ledger, and the legacy ledger is still at $ref/progress.md for a human to merge" >&2
          import_abort "$c" "$backup" "$ref" "$stage" ""; return 2
        fi
        if [ "$(tail -n +2 "$stage/progress.md" | wc -c | tr -d ' ')" -gt "$dbody" ]; then
          tail -n +2 "$stage/progress.md" | tail -c +"$((dbody + 1))" >> "$dest/progress.md" || { import_abort "$c" "$backup" "$ref" "$stage" ""; return 2; }
        fi
        rm -f "$stage/progress.md"
      else
        mv -f "$stage/progress.md" "$dest/progress.md" || { import_abort "$c" "$backup" "$ref" "$stage" "$installed"; return 2; }
      fi
      rm -rf "$stage"
      if ! verify_subset "$stage_manifest" "$dest"; then import_abort "$c" "$backup" "$ref" "" "$installed"; return 2; fi
    else
      import_abort "$c" "$backup" "$ref" "$stage" ""; return 2
    fi
    import_finish "$c" "$backup" "$ref"; return $?
  done < <(printf '%s\n' "$candidates")
  hp_unlock
  echo "status=none"
}

# --- finish ------------------------------------------------------------------
# Task numbers that hold a claim but have no completion line in the ledger.
open_claims() {
  local d n open=""
  for d in "$WSDIR"/claims/task-*/; do
    [ -d "$d" ] || continue
    n=${d%/}; n=${n##*/task-}
    if ! ledger_task_complete "$WSDIR/progress.md" "$n"; then open="$open,$n"; fi
  done
  printf '%s' "${open#,}"
}
# <dir> <tomb>: put a renamed-aside copy back. An unlocked writer may have
# recreated the path meanwhile (the Write tool and mkdir -p create missing
# parents), and mv onto an existing directory nests the copy inside it, so
# whatever appeared is moved beside the restored copy first and named. The
# path can also be recreated between that check and the mv; a nested copy
# is then lifted back out.
restore_tomb() {
  local dir=$1 tomb=$2 aside="$1.reappeared-$$"
  if [ -e "$dir" ] || [ -L "$dir" ]; then
    mv "$dir" "$aside" 2>/dev/null && echo "sdd-state: $dir was recreated during its removal; the new files are at $aside" >&2
  fi
  # Still occupied: the copy stays at its tomb rather than nesting.
  if [ -e "$dir" ] || [ -L "$dir" ]; then echo "sdd-state: $dir is occupied; the removed copy is at $tomb" >&2; return 1; fi
  mv "$tomb" "$dir" || return 1
  if [ -e "$dir/${tomb##*/}" ]; then
    [ ! -e "$aside" ] || aside="$aside-2"
    mv "$dir" "$aside" 2>/dev/null || return 1
    mv "$aside/${tomb##*/}" "$dir" || return 1
    echo "sdd-state: $dir was recreated during its removal; the new files are at $aside" >&2
  fi
  return 0
}
# <tomb>: delete a verified copy. A copy that survives the deletion is named;
# the caller decides whether what remains goes back.
discard_tomb() {
  rm -rf "$1" 2>/dev/null
  [ ! -e "$1" ] || { echo "sdd-state: could not delete the removed copy at $1" >&2; return 2; }
  TOMB=""
  return 0
}
# <dir> <tree-prefix> [keep]: remove a workspace directory only if it still
# equals the committed tip. The directory is renamed aside first (atomic),
# so a writer that opens the old path afterwards fails with ENOENT instead
# of writing into a directory about to vanish; then every tracked entry is
# compared by object id with the renamed copy (a symlink by its link text),
# and any extra file or symlink that is not ignored counts as a change.
# <tree-prefix> is "<tip>:plans/<ws>"; an empty prefix (plain backend)
# compares the ledger's size with SIZE_BEFORE. Returns 0 when the copy was
# verified: deleted, or with `keep` left at the tomb named in TOMB for the
# caller to commit against and then discard_tomb. Returns 1 when the copy
# changed or the path was recreated (the copy is restored, the caller is
# busy) and 2 when the deletion itself failed (what remains is restored).
remove_verified() {
  local dir=$1 prefix=$2 keep=${3:-} tomb f committed live
  TOMB=""
  tomb="$(dirname "$dir")/.removing-$(basename "$dir")-$$"
  # A tomb left by a killed run plus pid reuse would make mv nest the live
  # workspace inside it: refuse instead.
  [ ! -e "$tomb" ] || { echo "sdd-state: a copy from an earlier removal is in the way at $tomb" >&2; return 1; }
  mv "$dir" "$tomb" 2>/dev/null || return 1
  if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = remove-after-rename ]; then hp_unlock; exit 99; fi
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in
    remove-after-rename:*|remove-after-rename-changed:*)
      # Test hook: an unlocked writer recreates the path after the rename;
      # the -changed form had also appended to the ledger after the snapshot.
      mkdir -p "$dir"; printf 'written after rename\n' > "$dir/${HYPERPOWERS_TEST_WRITER_AT#*:}"
      case "$HYPERPOWERS_TEST_WRITER_AT" in remove-after-rename-changed:*) printf 'concurrent write\n' >> "$tomb/progress.md" ;; esac ;;
  esac
  if [ -z "$prefix" ]; then
    if [ "$(wc -c < "$tomb/progress.md" 2>/dev/null | tr -d ' ')" != "${SIZE_BEFORE:-}" ]; then restore_tomb "$dir" "$tomb"; return 1; fi
  else
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      committed=$(git -C "$CO" rev-parse "$prefix/$f" 2>/dev/null)
      if [ -L "$tomb/$f" ]; then
        live=$(printf '%s' "$(readlink "$tomb/$f")" | git -C "$CO" hash-object --stdin 2>/dev/null)
      else
        live=$(git -C "$CO" hash-object "$tomb/$f" 2>/dev/null)
      fi
      if [ "$committed" != "$live" ]; then restore_tomb "$dir" "$tomb"; return 1; fi
    done < <(git -C "$CO" ls-tree -r --name-only "$prefix" 2>/dev/null)
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      git -C "$CO" cat-file -e "$prefix/$f" 2>/dev/null && continue
      if ! git -C "$CO" check-ignore -q "plans/x/$f" 2>/dev/null; then restore_tomb "$dir" "$tomb"; return 1; fi
    done < <(cd "$tomb" && find . \( -type f -o -type l \) | sed 's|^\./||')
  fi
  # Something recreated the path while the copy was verified: busy.
  if [ -e "$dir" ] || [ -L "$dir" ]; then restore_tomb "$dir" "$tomb"; return 1; fi
  TOMB=$tomb
  [ -z "$keep" ] || return 0
  discard_tomb "$tomb" || { restore_tomb "$dir" "$tomb"; return 2; }
  return 0
}
cmd_finish() {
  local plan="" force=0 sid="" code="" open last commit rc t owner out line c lease lowner lplan
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) [ -z "$plan" ] || usage; plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] && [ -n "$sid" ] || usage
  resolve_plan "$plan"
  # The cwd's repository when no --code-repo is given. Only the path is
  # resolved here; the comparison with the plan line waits for the recovery.
  code=$(code_repo_arg "$code") || { rc=$?; [ -z "$code" ] || printf '%s\n' "$code"; return "$rc"; }
  hp_lock "$PLAN_DIR" || return 2
  recover_apply || { hp_unlock; echo "status=error"; return 2; }
  # A removal interrupted after its rename-aside left the dossier at
  # plans/.removing-<ws>-<pid>. With the path free the copy comes back and
  # finish proceeds; beside a new workspace it is named for a human to
  # merge or delete, and finish refuses.
  for t in "$(dirname "$WSDIR")/.removing-$(basename "$WSDIR")-"*; do
    [ -d "$t" ] || continue
    if [ -d "$WSDIR" ]; then
      echo "sdd-state: a copy from an interrupted removal remains at $t; move its files back into $WSDIR or delete it" >&2
      hp_unlock; echo "status=busy"; return 3
    fi
    restore_tomb "$WSDIR" "$t" || { hp_unlock; echo "status=error"; return 2; }
  done
  [ -d "$WSDIR" ] || { hp_unlock; echo "status=none"; return 0; }
  hp_contained "$ROOT" "plans/$WS" || { hp_unlock; echo "status=error"; return 2; }
  # A session working in the wrong repository must not delete this
  # workspace. The comparison reads the ledger as recovery and the restore
  # above left it, so a plan line that only they brought in still counts.
  out=$(code_repo_arg "$code" "$(ledger_path)") || { rc=$?; hp_unlock; [ -z "$out" ] || printf '%s\n' "$out"; return "$rc"; }
  # Only the session holding claims/final removes the dossier, and --force
  # never bypasses that. The claim is read here, under the lock and after a
  # copy an interrupted removal left has been put back, so the restored
  # copy's own claim counts and a finish that has nothing left says none.
  if [ ! -d "$WSDIR/claims/final" ]; then hp_unlock; echo "status=no-final-claim"; return 11; fi
  owner=$(sed -n 's/^session=//p' "$WSDIR/claims/final/owner" 2>/dev/null | head -n 1)
  if [ -z "$owner" ]; then hp_unlock; echo "sdd-state: claim owner unreadable or without a session: $WSDIR/claims/final/owner" >&2; echo "status=error"; return 2; fi
  if [ "$owner" != "$sid" ]; then hp_unlock; echo "status=not-holder owner=$owner"; return 11; fi
  # A registered plan's final train runs under its branch lease, so the
  # claim alone does not make a holder: a claimant still waiting for another
  # plan's lease, or one whose lease is gone, has not reached the train, and
  # removing its dossier would lose the plan it still has to finish.
  line=$(plan_line_of "$(ledger_path)")
  if [ -n "$line" ]; then
    c=$(hp_checkout_path "$PLAN_DIR") || { hp_unlock; echo "status=error"; return 2; }
    { lease=$(hp_lease_key "$PLAN_DIR" "$(plan_field "$line" integration)") && lease_path_ok "$c" "$lease"; } || { hp_unlock; echo "status=error"; return 2; }
    if [ ! -f "$lease" ]; then hp_unlock; echo "status=not-holder owner=none"; return 11; fi
    lowner=$(sed -n 's/^session=//p' "$lease" | head -n 1); lplan=$(sed -n 's/^plan=//p' "$lease" | head -n 1)
    if [ -z "$lowner" ] || [ -z "$lplan" ]; then hp_unlock; echo "sdd-state: lease unreadable or without session= or plan=: $lease" >&2; echo "status=error"; return 2; fi
    if [ "$lowner" != "$sid" ] || [ "$lplan" != "$WS" ]; then hp_unlock; echo "status=not-holder owner=$lowner"; return 11; fi
  fi
  # The claims are read under the lock, so a claim published after a first
  # look, or a takeover in flight, is seen before anything is removed.
  open=$(open_claims)
  if [ -n "$open" ] && [ "$force" -eq 0 ]; then hp_unlock; echo "status=open-claims tasks=$open"; return 6; fi
  if [ "$BACKEND" != branch ]; then
    SIZE_BEFORE=$(wc -c < "$WSDIR/progress.md" 2>/dev/null | tr -d ' ')
    remove_verified "$WSDIR" ""; rc=$?
    hp_unlock
    case "$rc" in 0) echo "status=finished backend=plain"; return 0 ;; 1) echo "status=busy"; return 3 ;; *) echo "status=error"; return 2 ;; esac
  fi
  hp_commit_paths "$CO" "$BRANCH" "sdd $SLUG: snapshot before finish" "plans/$WS" >/dev/null || { hp_unlock; echo "status=error"; return 2; }
  last=$(git -C "$CO" rev-parse "refs/heads/$BRANCH")
  # Controllers append without the lock: the removal renames the directory
  # aside and verifies it against the snapshot before deleting it.
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in
    finish-before-remove:*) printf 'concurrent write\n' >> "$CO/${HYPERPOWERS_TEST_WRITER_AT#finish-before-remove:}" ;;
    finish-before-remove-link:*) ln -s progress.md "$CO/${HYPERPOWERS_TEST_WRITER_AT#finish-before-remove-link:}" ;;
  esac
  remove_verified "$WSDIR" "$last:plans/$WS" keep; rc=$?
  case "$rc" in 0) ;; 1) hp_unlock; echo "status=busy"; return 3 ;; *) hp_unlock; echo "status=error"; return 2 ;; esac
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in finish-after-verify:*) mkdir -p "$WSDIR"; printf 'late\n' > "$WSDIR/${HYPERPOWERS_TEST_WRITER_AT#finish-after-verify:}" ;; esac
  # The removal is committed from the tip's tree, never from the live path,
  # so a workspace recreated after the verification neither enters the
  # commit nor blocks it: it stays on disk, uncommitted, and is named. A
  # commit that fails puts the verified copy back; only a committed removal
  # deletes it, and a copy that survives the deletion is named on stderr.
  commit=$(hp_commit_paths --remove "$CO" "$BRANCH" "sdd $SLUG: finish" "plans/$WS"); rc=$?
  if [ "$rc" -ne 0 ]; then restore_tomb "$WSDIR" "$TOMB"; hp_unlock; echo "status=error"; return 2; fi
  discard_tomb "$TOMB" || true
  hp_unlock
  if [ -d "$WSDIR" ]; then
    echo "sdd-state: $WSDIR was recreated during finish; the removal is committed (last=$last) and the new files remain there, uncommitted" >&2
    echo "status=error"; return 2
  fi
  echo "status=finished sha=${commit:0:7} last=$last push=$REMOTE/$BRANCH"
}

# --- lease -------------------------------------------------------------------
# <checkout path> <lease path>: 0 when the path has the shape hp_lease_key
# gives it, <checkout>.final-<12 hex>, and is no link and, when present, a
# regular file. The lease sits beside the lock, outside plans/, where
# hp_contained does not reach.
lease_path_ok() {
  local s=${2#"$1".final-}
  if [ "$s" = "$2" ] || [ "${#s}" -ne 12 ]; then echo "sdd-state: $2 is not a lease path" >&2; return 1; fi
  case "$s" in *[!0-9a-f]*) echo "sdd-state: $2 is not a lease path" >&2; return 1 ;; esac
  if [ -L "$2" ] || { [ -e "$2" ] && [ ! -f "$2" ]; }; then echo "sdd-state: $2 is not a regular file; refusing to use it as a lease" >&2; return 1; fi
}
# <checkout path> <lease path> <record>: written to an exclusively created
# temporary file beside the lease and renamed over it, so no reader sees half
# a record. The temporary name stays outside the .final-* names lease_find
# reads, so one a crash leaves behind is never taken for a lease.
lease_write() {
  local t
  lease_path_ok "$1" "$2" || return 1
  t=$(mktemp "$1.lease-tmp.XXXXXX") || return 1
  { printf '%s\n' "$3" > "$t" && mv -f "$t" "$2"; } || { rm -f "$t"; return 1; }
}
# <checkout path> <lease path> <record>: a takeover's replacement of another
# session's lease. The prior record goes to <lease>.history first, as a
# claim's takeover keeps owner.history, so the session that held the branch
# stays on record; a history that cannot be written refuses the takeover.
# The suffix keeps the history outside the names lease_find reads.
lease_supersede() {
  local h="$2.history"
  lease_path_ok "$1" "$2" || return 1
  if [ -L "$h" ] || { [ -e "$h" ] && [ ! -f "$h" ]; }; then echo "sdd-state: $h is not a regular file; refusing to use it as a lease history" >&2; return 1; fi
  printf -- '--- superseded at %s\n%s\n' "$(hp_utc_now)" "$(cat "$2" 2>/dev/null)" >> "$h" || return 1
  lease_write "$1" "$2" "$3"
}
# <ws> [<sid>] -> the lease file whose record names this workspace and, when
# given, this session, found without a workspace on disk: a release after
# finish needs only the plan path's repository key, and a takeover after
# finish knows only the workspace. Two matches is a state nothing produces.
lease_find() {
  local c f s hit="" n=0 all="" who
  c=$(hp_checkout_path "$PLAN_DIR") || return 1
  who="workspace $1"; [ -z "${2:-}" ] || who="$who and session $2"
  for f in "$c".final-*; do
    s=${f#"$c".final-}
    [ "${#s}" -eq 12 ] || continue
    case "$s" in *[!0-9a-f]*) continue ;; esac
    [ -e "$f" ] || [ -L "$f" ] || continue
    lease_path_ok "$c" "$f" || return 2
    [ "$(sed -n 's/^plan=//p' "$f" | head -n 1)" = "$1" ] || continue
    [ -z "${2:-}" ] || [ "$(sed -n 's/^session=//p' "$f" | head -n 1)" = "$2" ] || continue
    n=$((n + 1)); hit=$f; all="$all $f"
  done
  if [ "$n" -gt 1 ]; then echo "sdd-state: more than one lease names $who:$all" >&2; return 2; fi
  [ -z "$hit" ] || printf '%s\n' "$hit"
}
cmd_lease() {
  local plan="" sid="" code="" op="" c lease integ d other rc rec out t
  while [ $# -gt 0 ]; do
    case "$1" in
      --release|--closing) [ -z "$op" ] || usage; op=${1#--}; shift ;;
      --session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) [ -z "$plan" ] || usage; plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] && [ -n "$sid" ] && [ -n "$op" ] || usage
  resolve_plan "$plan"
  # The lock pair needs the code repository's path; its comparison with the
  # plan line waits for the recovery below.
  code=$(code_repo_arg "$code") || { rc=$?; [ -z "$code" ] || printf '%s\n' "$code"; return "$rc"; }
  hp_lock_pair "$PLAN_DIR" "$code" || { echo "status=error"; return 2; }
  # Recovery first: an interrupted sync may be what brings in this plan's
  # line or a sibling's ledger, and the comparison and the sibling check
  # below must both read the recovered state.
  recover_apply || { hp_unlock; echo "status=error"; return 2; }
  # After finish there is no ledger, so the comparison has nothing to compare
  # and the lease is found by identity alone.
  out=$(code_repo_arg "$code" "$WSDIR/progress.md") || { rc=$?; hp_unlock; [ -z "$out" ] || printf '%s\n' "$out"; return "$rc"; }
  c=$(hp_checkout_path "$PLAN_DIR") || { hp_unlock; echo "status=error"; return 2; }
  lease=$(lease_find "$WS" "$sid") || { hp_unlock; echo "status=error"; return 2; }
  if [ -z "$lease" ]; then
    hp_unlock; echo "status=no-lease"
    [ "$op" = release ] && return 0
    return 4
  fi
  if [ "$op" = release ]; then
    rm -f "$lease" || { hp_unlock; echo "status=error"; return 2; }
    hp_unlock; echo "status=released"; return 0
  fi
  integ=$(sed -n 's/^branch=//p' "$lease" | head -n 1)
  [ -n "$integ" ] || { hp_unlock; echo "sdd-state: the lease $lease names no branch" >&2; echo "status=error"; return 2; }
  # Checked at this moment under the locks, never from an earlier board: once
  # closing=1 is written, register and a task claim refuse the branch, so
  # nothing opens between this check and the branch's deletion.
  for d in "$ROOT"/plans/*/; do
    [ -f "$d/progress.md" ] || continue
    [ "${d%/}" != "$WSDIR" ] || continue
    other=$(plan_line_of "$d/progress.md"); [ -n "$other" ] || continue
    if [ "$(plan_field "$other" integration)" = "$integ" ]; then hp_unlock; echo "status=sibling-open plan=$(enc "$(basename "${d%/}")")"; return 15; fi
  done
  # A sibling's dossier that an interrupted finish or prune renamed aside to
  # plans/.removing-<ws>-<pid> is still an open plan: its next finish puts it
  # back. The glob above skips dotted names, so those copies are read here,
  # and the branch is never deleted under a plan that may return.
  for d in "$ROOT"/plans/.removing-*/; do
    [ -f "$d/progress.md" ] || continue
    t=$(basename "${d%/}"); t=${t#.removing-}; t=${t%-*}
    [ "$t" != "$WS" ] || continue
    other=$(plan_line_of "$d/progress.md"); [ -n "$other" ] || continue
    if [ "$(plan_field "$other" integration)" = "$integ" ]; then hp_unlock; echo "status=sibling-open plan=$(enc "$t")"; return 15; fi
  done
  # Test seam: a pause between the sibling check and the write, so a fixture
  # can prove the locks keep a sibling's registration out of that window.
  if [ "${HYPERPOWERS_TEST_PAUSE_AT:-}" = lease-before-close ]; then
    : > "$CO/.lease-before-close-paused"
    while [ -e "$CO/.lease-before-close-pause" ]; do sleep 0.1; done
    rm -f "$CO/.lease-before-close-paused"
  fi
  # A lease that cannot be read must not be replaced by a bare closing line.
  rec=$(sed '/^closing=/d' "$lease") || { hp_unlock; echo "status=error"; return 2; }
  lease_write "$c" "$lease" "$(printf '%s\nclosing=1' "$rec")" || { hp_unlock; echo "status=error"; return 2; }
  hp_unlock; echo "status=closing"
}

# --- prune -------------------------------------------------------------------
# Lists, and with --apply removes, plan directories idle for N days (last
# commit and newest file both older) and checkouts whose clone is gone. Never
# runs implicitly.
cmd_prune() {
  local repo="" days=30 apply=0 repo_dir co br d name now cutoff c key list="" dead_list="" i tip gd ck
  local tomb_list="" quar_list="" tomb_name tomb_pid tomb_ws tracked t q quar stage s q_pid
  local plans=() dead=() tombs=() tomb_dead=() quar_idle=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) [ $# -ge 2 ] || usage; days=$2; shift 2 ;;
      --apply) apply=1; shift ;;
      --repo) [ $# -ge 2 ] || usage; repo=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$repo" ] || usage
  case "$days" in ''|*[!0-9]*) usage ;; esac
  days=$((10#$days))
  repo_dir=$(hp_physical_dir "$repo") || usage
  git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1 || { echo "sdd-state: not a git repository: $repo" >&2; exit 2; }
  if [ "$(hp_backend "$repo_dir")" = plain ]; then echo "status=plain"; return 0; fi
  co=$(hp_checkout_path "$repo_dir"); br=$(hp_state_branch "$repo_dir")
  now=$(date +%s); cutoff=$((now - days * 86400))
  # <name> -> 0 when the plan directory is idle: last commit and newest
  # file both older than N days. A traversal that fails (not an empty
  # answer) keeps the workspace, as it keeps a tomb and a quarantine: a
  # find that cannot walk a subdirectory prints nothing and exits
  # non-zero, and reading that as silence would list a dossier nobody
  # could read, and then delete it.
  idle() {
    local lc newer
    lc=$(git -C "$co" log -1 --format=%ct -- "plans/$1" 2>/dev/null)
    [ -n "$lc" ] && [ "$lc" -lt "$cutoff" ] || return 1
    # Said out loud, in the reclaim's words: a workspace kept because
    # nobody could walk it looks the same in the output as one that is
    # simply active.
    newer=$(find "$co/plans/$1" -type f -mtime -"$days" 2>/dev/null) || {
      echo "sdd-state: the freshness of the workspace at $co/plans/$1 could not be read; it was left alone" >&2
      return 1
    }
    [ -z "$newer" ]
  }
  # <tomb dir> <pid> <ws> -> 0 when the copy may be quarantined: its
  # process is gone, nothing in it is newer than N days, and the branch does
  # not track its workspace. A traversal or a tracking lookup that fails
  # (not an empty answer) keeps it.
  tomb_qualifies() {
    local newer
    hp_pid_gone "$2" || return 1
    newer=$(find "$1" -mtime -"$days" 2>/dev/null) || return 1
    [ -z "$newer" ] || return 1
    tracked=$(git -C "$co" ls-tree -d "refs/heads/$br" -- "plans/$3" 2>/dev/null) || return 1
    [ -z "$tracked" ]
  }
  # <quarantined dir> -> 0 when nothing in it is newer than N days: the
  # quarantine touched it when it was made, and a late writer refreshes it,
  # so the clock measures silence since the last of those.
  quarantine_idle() {
    local newer
    newer=$(find "$1" -mtime -"$days" 2>/dev/null) || return 1
    [ -z "$newer" ]
  }
  # With --apply the selection itself runs under the lock, and each candidate
  # is revalidated right before its removal; a workspace that became active
  # in between is kept and reported.
  if [ "$apply" -eq 1 ]; then hp_lock "$repo_dir" || return 2; fi
  if [ "$apply" -eq 1 ]; then CO=$co; BRANCH=$br; recover_apply || { hp_unlock; echo "status=error"; return 2; }; fi
  # A copy a killed --apply left staged at plans/.quarantining-<ws>-<pid>
  # goes back to its tomb name before anything is listed: the lock is held,
  # so no other prune owns it, and neither phase lists the staging name.
  if [ "$apply" -eq 1 ] && [ -e "$co/.git" ]; then
    for s in "$co"/plans/.quarantining-*; do
      [ -d "$s" ] && [ ! -L "$s" ] || continue
      tracked=$(git -C "$co" ls-tree -d "refs/heads/$br" -- "plans/${s##*/}" 2>/dev/null) || continue
      [ -z "$tracked" ] || continue
      t="$co/plans/.removing-${s##*/.quarantining-}"
      if [ -e "$t" ] || [ -L "$t" ]; then echo "sdd-state: a staged copy from an interrupted prune is at $s and its tomb name $t is taken; move it back or delete it by hand" >&2; continue; fi
      mv "$s" "$t" 2>/dev/null || echo "sdd-state: the staged copy at $s could not be put back at $t; move it back by hand" >&2
    done
  fi
  if [ -e "$co/.git" ]; then
    for d in "$co"/plans/*/; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      idle "$name" || continue
      plans[${#plans[@]}]=$name
      list="$list,$(enc "$name")"
    done
  fi
  # Copies killed removals left at plans/.removing-<ws>-<pid>, and the ones
  # an earlier --apply quarantined at plans/.pruned-<ws>-<pid>. A tracked
  # workspace's copy comes back through sync's restore and is never listed.
  if [ -e "$co/.git" ]; then
    for t in "$co"/plans/.removing-*; do
      [ -d "$t" ] && [ ! -L "$t" ] || continue
      tomb_name=${t##*/}; tomb_pid=${tomb_name##*-}; tomb_ws=${tomb_name#.removing-}; tomb_ws=${tomb_ws%-*}
      case "$tomb_pid" in ''|*[!0-9]*) continue ;; esac
      # A tracked path under plans/ is a workspace whatever its name: a
      # checkout from before this release may hold one named like a tomb.
      tracked=$(git -C "$co" ls-tree -d "refs/heads/$br" -- "plans/$tomb_name" 2>/dev/null) || continue
      [ -z "$tracked" ] || continue
      tomb_qualifies "$t" "$tomb_pid" "$tomb_ws" || continue
      tomb_dead[${#tomb_dead[@]}]=$t; tomb_list="$tomb_list,$(enc "$tomb_name")"
    done
    for q in "$co"/plans/.pruned-*; do
      [ -d "$q" ] && [ ! -L "$q" ] || continue
      # The name must parse as a quarantine (a numeric pid last), and a
      # path the branch tracks is a workspace, never a quarantine.
      q_pid=${q##*-}; case "$q_pid" in ''|*[!0-9]*) continue ;; esac
      tracked=$(git -C "$co" ls-tree -d "refs/heads/$br" -- "plans/${q##*/}" 2>/dev/null) || continue
      [ -z "$tracked" ] || continue
      quarantine_idle "$q" || continue
      quar_idle[${#quar_idle[@]}]=$q; quar_list="$quar_list,$(enc "${q##*/}")"
    done
  fi
  tomb_list=${tomb_list#,}; quar_list=${quar_list#,}
  # A checkout is dead when the directory its .git file names is gone. A
  # relative gitdir (worktree.useRelativePaths) resolves against the
  # checkout; an unparsable .git file is not evidence that the clone is gone.
  for c in "$(hp_cache_root)"/state/*/; do
    [ -f "$c.git" ] || continue
    gd=$(sed -n 's/^gitdir: //p' "$c.git" 2>/dev/null)
    [ -n "$gd" ] || continue
    case "$gd" in /*) ;; *) gd="$c$gd" ;; esac
    if [ ! -d "$gd" ]; then dead[${#dead[@]}]=$(basename "$c"); dead_list="$dead_list,$(basename "$c")"; fi
  done
  list=${list#,}; dead_list=${dead_list#,}
  if [ "$apply" -eq 0 ]; then echo "status=listed plans=$list checkouts=$dead_list tombs=$tomb_list quarantined=$quar_list"; return 0; fi
  local removed=() removed_paths=() kept_list="" removed_list=""
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in prune-before-remove:*) printf 'concurrent write\n' >> "$co/${HYPERPOWERS_TEST_WRITER_AT#prune-before-remove:}" ;; esac
  CO=$co
  tip=$(git -C "$co" rev-parse "refs/heads/$br")
  i=0
  while [ "$i" -lt "${#plans[@]}" ]; do
    name=${plans[$i]}
    if idle "$name" && remove_verified "$co/plans/$name" "$tip:plans/$name" keep; then
      removed[${#removed[@]}]=$name; removed_paths[${#removed_paths[@]}]="plans/$name"; tombs[${#tombs[@]}]=$TOMB; removed_list="$removed_list,$(enc "$name")"
    else
      kept_list="$kept_list,$(enc "$name")"
    fi
    i=$((i + 1))
  done
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in prune-after-verify:*) mkdir -p "$(dirname "$co/plans/${HYPERPOWERS_TEST_WRITER_AT#prune-after-verify:}")"; printf 'late\n' > "$co/plans/${HYPERPOWERS_TEST_WRITER_AT#prune-after-verify:}" ;; esac
  # The copies outlive the commit: a commit that fails puts every one back.
  if [ "${#removed[@]}" -gt 0 ]; then
    if ! hp_commit_paths --remove "$co" "$br" "sdd: prune ${removed[*]}" "${removed_paths[@]}" >/dev/null; then
      i=0
      while [ "$i" -lt "${#tombs[@]}" ]; do restore_tomb "$co/plans/${removed[$i]}" "${tombs[$i]}"; i=$((i + 1)); done
      hp_unlock; echo "status=error"; return 2
    fi
    i=0
    while [ "$i" -lt "${#tombs[@]}" ]; do discard_tomb "${tombs[$i]}" || true; i=$((i + 1)); done
  fi
  # Phase one: a listed copy is staged under a name neither phase lists,
  # re-checked there (a writer with the directory open appends into it,
  # which the mtime check sees), touched so the clock starts again, and
  # only then renamed to its quarantine name; any doubt puts it back, and a
  # crash anywhere in between leaves a staged copy the next --apply puts
  # back. Nothing is deleted here, so a writer that still holds the copy
  # open loses no byte.
  tomb_list=""
  i=0
  while [ "$i" -lt "${#tomb_dead[@]}" ]; do
    t=${tomb_dead[$i]}; i=$((i + 1))
    tomb_name=${t##*/}; tomb_pid=${tomb_name##*-}; tomb_ws=${tomb_name#.removing-}; tomb_ws=${tomb_ws%-*}
    [ -d "$t" ] && [ ! -L "$t" ] || continue
    stage="$co/plans/.quarantining-${tomb_name#.removing-}"; quar="$co/plans/.pruned-${tomb_name#.removing-}"
    [ ! -e "$stage" ] && [ ! -L "$stage" ] && [ ! -e "$quar" ] && [ ! -L "$quar" ] || continue
    mv "$t" "$stage" 2>/dev/null || continue
    if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = prune-after-stage ]; then hp_unlock; exit 99; fi
    case "${HYPERPOWERS_TEST_WRITER_AT:-}" in
      prune-after-tomb-rename:*) [ "${HYPERPOWERS_TEST_WRITER_AT#prune-after-tomb-rename:}" != "$tomb_name" ] || touch "$stage/progress.md" ;;
      prune-reoccupy-tomb:*) [ "${HYPERPOWERS_TEST_WRITER_AT#prune-reoccupy-tomb:}" != "$tomb_name" ] || { touch "$stage/progress.md"; mkdir -p "$t"; } ;;
    esac
    # A re-check that fails, or a clock that cannot be restarted, is doubt:
    # the copy goes back under its old name, after the same destination
    # check every rename here makes (BSD mv nests into an occupied one).
    if ! tomb_qualifies "$stage" "$tomb_pid" "$tomb_ws" || ! touch "$stage"; then
      if [ -e "$t" ] || [ -L "$t" ]; then echo "sdd-state: the copy renamed to $stage could not be put back at $t, which is occupied again; move it back by hand" >&2; continue; fi
      mv "$stage" "$t" 2>/dev/null || echo "sdd-state: the copy renamed to $stage could not be put back at $t; move it back by hand" >&2
      continue
    fi
    # The clock started on the staged copy, and rename keeps it. The
    # destination is checked here, at the rename, like every other.
    [ ! -e "$quar" ] && [ ! -L "$quar" ] || { echo "sdd-state: $quar appeared while $stage was staged; the next prune puts it back" >&2; continue; }
    mv "$stage" "$quar" 2>/dev/null || { echo "sdd-state: the staged copy at $stage could not be published at $quar; the next prune puts it back" >&2; continue; }
    tomb_list="$tomb_list,$(enc "$tomb_name")"
  done
  tomb_list=${tomb_list#,}
  # Phase two: a quarantined copy that has been silent for N days is
  # renamed aside once more, re-checked, deleted, and verified gone.
  quar_list=""
  i=0
  while [ "$i" -lt "${#quar_idle[@]}" ]; do
    q=${quar_idle[$i]}; i=$((i + 1))
    [ -d "$q" ] && [ ! -L "$q" ] || continue
    [ ! -e "$q.pruning-$$" ] && [ ! -L "$q.pruning-$$" ] || continue
    mv "$q" "$q.pruning-$$" 2>/dev/null || continue
    if ! quarantine_idle "$q.pruning-$$"; then
      if [ -e "$q" ] || [ -L "$q" ]; then echo "sdd-state: the copy renamed aside at $q.pruning-$$ could not be put back at $q, which is occupied again; move it back by hand" >&2; continue; fi
      mv "$q.pruning-$$" "$q" 2>/dev/null || echo "sdd-state: the copy renamed aside at $q.pruning-$$ could not be put back at $q; move it back by hand" >&2
      continue
    fi
    rm -rf "$q.pruning-$$" 2>/dev/null
    if [ -e "$q.pruning-$$" ] || [ -L "$q.pruning-$$" ]; then echo "sdd-state: the copy at $q.pruning-$$ could not be removed; remove it by hand" >&2; continue; fi
    quar_list="$quar_list,$(enc "${q##*/}")"
  done
  quar_list=${quar_list#,}
  hp_unlock
  list=${removed_list#,}; kept_list=${kept_list#,}
  # Each dead checkout goes under its own key's lock: the gitdir is re-read
  # there (a clone restored since the scan keeps its checkout; a creator
  # that arrived first is waited for and then seen), the checkout is renamed
  # aside atomically and deleted with its sidecars, and the lock itself is
  # the last thing to go. A lock that cannot be taken keeps the candidate.
  dead_list=""
  i=0
  while [ "$i" -lt "${#dead[@]}" ]; do
    key=${dead[$i]}; ck="$(hp_cache_root)/state/$key"; i=$((i + 1))
    hp_lock_at "$ck.lock" || continue
    gd=$(sed -n 's/^gitdir: //p' "$ck/.git" 2>/dev/null)
    case "$gd" in ''|/*) ;; *) gd="$ck/$gd" ;; esac
    if [ -z "$gd" ] || [ -d "$gd" ] || ! mv "$ck" "$ck.pruning-$$" 2>/dev/null; then hp_unlock; continue; fi
    rm -rf "$ck.pruning-$$" "$ck.backend" "$ck.lock-history" "$ck.fetched" "$ck.lock.takeover" "$ck".tmp-*
    hp_unlock
    dead_list="$dead_list,$key"
  done
  dead_list=${dead_list#,}
  echo "status=pruned plans=$list kept=$kept_list checkouts=$dead_list tombs=$tomb_list quarantined=$quar_list"
}

# --- sync --------------------------------------------------------------------
tip_of() { git -C "$1" rev-parse -q --verify "$2^{commit}" 2>/dev/null || true; }
short() { if [ -n "$1" ]; then printf '%s' "${1:0:7}"; else printf 'none'; fi; }
age_of() { # <checkout> <sha>... -> seconds since the newest of them
  local co=$1 newest=0 t s
  shift
  for s in "$@"; do
    [ -n "$s" ] || continue
    t=$(git -C "$co" log -1 --format=%ct "$s" 2>/dev/null || echo 0)
    [ "$t" -gt "$newest" ] && newest=$t
  done
  if [ "$newest" -gt 0 ]; then echo $(( $(date +%s) - newest )); else echo 0; fi
}
# Commit every plan directory with pending tracked changes, so the working
# tree equals the local tip and nothing local can be lost.
snapshot_pending() {
  local d name
  for d in "$CO"/plans/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    [ -n "$(git -C "$CO" status --porcelain -- "plans/$name" 2>/dev/null)" ] || continue
    hp_commit_paths "$CO" "$BRANCH" "sdd $name: snapshot $(hp_utc_now)" "plans/$name" >/dev/null || return 2
  done
}
# blob_prefix_id <file|-> <n>: the blob id of the first <n> bytes of a file
# or of stdin. Callers never pass 0 (BSD head rejects it).
blob_prefix_id() {
  if [ "$1" = - ]; then head -c "$2" | git -C "$CO" hash-object --stdin; else head -c "$2" "$1" | git -C "$CO" hash-object --stdin; fi
}
# extension_present <file> <staged> <live-size>: 0 when the staged
# extension (the bytes beyond <live-size>) already sits in the file
# somewhere past <live-size>, 1 when it does not, 3 when it cannot be read.
# An unlocked writer's line can land at that offset between a crash and the
# recovery, so a test pinned to the offset would append the extension a
# second time. node reads both files whole; it is already required by this
# helper's claim and import paths.
extension_present() {
  command -v node >/dev/null 2>&1 || { echo "sdd-state: node not found" >&2; return 3; }
  node -e 'const fs=require("fs");try{const l=Number(process.argv[3]);process.exit(fs.readFileSync(process.argv[1]).subarray(l).includes(fs.readFileSync(process.argv[2]).subarray(l))?0:1);}catch(e){process.exit(3);}' "$1" "$2" "$3"
}
# rewrite_finish <journal-base>: complete a journaled ledger rewrite from
# whatever point it reached. The staged content and the original length are
# on disk, so every step repeats safely: the extension (the staged bytes
# beyond the original length) is appended unless the file already carries
# it beyond that offset, then the original length is overwritten in place.
# Neither step truncates, and a racing append always lands beyond the
# region being written, so it survives, at worst between the two parts.
rewrite_finish() {
  local jbase=$1 path live_size new_size file ext_size present
  read -r live_size new_size path < "$jbase.journal" || return 2
  hp_contained "$CO" "$path" || return 2
  file="$CO/$path"
  [ -f "$jbase.staged" ] && [ -f "$file" ] || return 2
  ext_size=$((new_size - live_size))
  if [ "$ext_size" -gt 0 ]; then
    extension_present "$file" "$jbase.staged" "$live_size"; present=$?
    case "$present" in
      0) ;;
      1) tail -c +"$((live_size + 1))" "$jbase.staged" >> "$file" || return 2 ;;
      *) return 2 ;;
    esac
  fi
  if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = rewrite-after-extend ]; then hp_unlock; exit 99; fi
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in ledger-apply-before-overwrite) printf 'raced the overwrite\n' >> "$file" ;; esac
  head -c "$live_size" "$jbase.staged" | dd of="$file" bs=65536 conv=notrunc 2>/dev/null || return 2
  rm -f "$jbase.journal" "$jbase.staged"
  return 0
}
# ledger_apply <path> <S> <target>: bring one ledger from S to target
# without replacing its inode or dropping a line a live writer appended.
# When the target's blob extends S's, the new tail is appended, and skipped
# when the file already ends with it, so a recovery never appends twice.
# Otherwise (a merge, or a fast-forward onto another host's merge, reordered
# lines) the file is rewritten in place to the target's content followed by
# whatever it held beyond S's blob; the rewrite is journaled under .rewrite/
# before its first write and finished by rewrite_finish, which appends the new
# bytes and then overwrites the old length in place, so it never truncates,
# repeats safely after a crash, and a racing append survives, at worst between
# the two parts. A file that already starts with the target's content is
# left alone. Returns 0; 5 when the file does not start with what S
# committed (a local rewrite: the caller retries and ends busy); 2 on error.
ledger_apply() {
  local path=$1 S=$2 target=$3 file t_blob t_size s_blob s_size live_size suffix_size new_size jbase
  file="$CO/$path"
  jbase="$CO/.rewrite/$(basename "$(dirname "$file")")"
  # A rewrite of this ledger interrupted earlier is finished before anything
  # is judged about the file.
  if [ -f "$jbase.journal" ]; then rewrite_finish "$jbase" || return 2; fi
  t_blob=$(git -C "$CO" rev-parse -q --verify "$target:$path" 2>/dev/null) || return 2
  t_size=$(git -C "$CO" cat-file -s "$t_blob" 2>/dev/null) || return 2
  [ "$t_size" -gt 0 ] || return 0
  s_blob=$(git -C "$CO" rev-parse -q --verify "$S:$path" 2>/dev/null || true)
  s_size=0
  if [ -n "$s_blob" ]; then s_size=$(git -C "$CO" cat-file -s "$s_blob" 2>/dev/null) || return 2; fi
  live_size=$(wc -c < "$file" | tr -d ' ')
  if [ "$live_size" -ge "$t_size" ] && [ "$(blob_prefix_id "$file" "$t_size")" = "$t_blob" ]; then return 0; fi
  if [ "$live_size" -lt "$s_size" ]; then return 5; fi
  if [ "$s_size" -gt 0 ] && [ "$(blob_prefix_id "$file" "$s_size")" != "$s_blob" ]; then return 5; fi
  if [ "$t_size" -ge "$s_size" ] && { [ "$s_size" -eq 0 ] || [ "$(git -C "$CO" cat-file blob "$t_blob" | blob_prefix_id - "$s_size")" = "$s_blob" ]; }; then
    suffix_size=$((t_size - s_size))
    [ "$suffix_size" -gt 0 ] || return 0
    if [ "$live_size" -ge "$t_size" ] && [ "$(tail -c "$suffix_size" "$file" | git -C "$CO" hash-object --stdin)" = "$(git -C "$CO" cat-file blob "$t_blob" | tail -c "$suffix_size" | git -C "$CO" hash-object --stdin)" ]; then return 0; fi
    git -C "$CO" cat-file blob "$t_blob" | tail -c "$suffix_size" >> "$file" || return 2
    return 0
  fi
  if [ -L "$CO/.rewrite" ]; then
    echo "sdd-state: $CO/.rewrite is a symbolic link; refusing to journal a ledger rewrite through it" >&2
    return 2
  fi
  mkdir -p "$CO/.rewrite" || return 2
  { git -C "$CO" cat-file blob "$t_blob" && tail -c +"$((s_size + 1))" "$file"; } > "$jbase.staged.tmp" || { rm -f "$jbase.staged.tmp"; return 2; }
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in ledger-apply-before-rewrite) printf 'raced the rewrite\n' >> "$file" ;; esac
  [ "$(wc -c < "$file" | tr -d ' ')" -eq "$live_size" ] || { rm -f "$jbase.staged.tmp"; return 5; }
  new_size=$(wc -c < "$jbase.staged.tmp" | tr -d ' ')
  if [ "$new_size" -lt "$live_size" ]; then
    # A target shorter than the live file: the ledger shrank, which an
    # append-only ledger never does; the truncating write is the fallback.
    cat "$jbase.staged.tmp" > "$file" || { rm -f "$jbase.staged.tmp"; return 2; }
    rm -f "$jbase.staged.tmp"
    return 0
  fi
  # The rewrite is journaled before its first write (sizes first, the path
  # last so a name with spaces reads back whole); a crash at any later point
  # is finished by rewrite_finish from the staged content.
  mv -f "$jbase.staged.tmp" "$jbase.staged" || { rm -f "$jbase.staged.tmp"; return 2; }
  printf '%s %s %s\n' "$live_size" "$new_size" "$path" > "$jbase.journal.tmp" || { rm -f "$jbase.journal.tmp" "$jbase.staged"; return 2; }
  mv -f "$jbase.journal.tmp" "$jbase.journal" || { rm -f "$jbase.journal.tmp" "$jbase.staged"; return 2; }
  if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = rewrite-after-journal ]; then hp_unlock; exit 99; fi
  rewrite_finish "$jbase"
}
# apply_files <S> <target>: bring the working tree from S to target without
# replacing a ledger. Added or modified ledgers go through ledger_apply; other
# files are checked out; files the target deletes are removed, a ledger among
# them through remove_verified. Any failure returns 2; a ledger rewritten
# locally returns 5 (from ledger_apply); a changed ledger the target deletes
# returns 6. Returns 4 when a path it must write or remove sits under a
# symbolic link; the callers turn that into a repair the human can act on.
# Every workspace the apply writes into or removes from comes back whole:
# every path the target tracks under it that is still missing afterwards
# is published from the target.
apply_files() {
  local S=$1 target=$2 path dir tmp half ws i meta n=0 last_ws="" touched_ws=()
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    hp_contained "$CO" "$path" || return 4
    # Every workspace this walk writes into is remembered: the diff names
    # only what changed between S and the target, and a directory an
    # interrupted apply left holding those files alone would have the next
    # snapshot record its unchanged siblings as deletions. git lists paths
    # sorted, so one workspace's paths are contiguous.
    case "$path" in plans/*/*) ws=${path#plans/}; ws=${ws%%/*}; [ "$ws" = "$last_ws" ] || touched_ws[${#touched_ws[@]}]=$ws; last_ws=$ws ;; esac
    mkdir -p "$(dirname "$CO/$path")" || return 2
    case "$path" in
      plans/*/progress.md)
        if [ -f "$CO/$path" ]; then
          ledger_apply "$path" "$S" "$target" || return $?
          if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = sync-after-ledger-apply ]; then hp_unlock; exit 99; fi
        else
          # A ledger absent at S is materialized through a temporary file
          # beside it and published with one link(2), never appended to in
          # place: an interrupted append leaves a prefix that the next
          # apply's ledger_apply extends with the whole blob (S has no blob
          # to subtract), and the result reads as a valid ledger.
          tmp="$CO/$path.new.$$"
          rm -f "$tmp"
          git -C "$CO" show "$target:$path" > "$tmp" || { rm -f "$tmp"; return 2; }
          if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = sync-mid-ledger-create ]; then
            # Test hook: half the blob written, the publish never reached.
            half=$(( $(wc -c < "$tmp" | tr -d ' ') / 2 ))
            head -c "$half" "$tmp" > "$tmp.half" && mv -f "$tmp.half" "$tmp"
            hp_unlock; exit 99
          fi
          if ln "$tmp" "$CO/$path" 2>/dev/null; then
            rm -f "$tmp"
          else
            # A writer created the ledger between the check and the
            # publish: reconcile with it instead of replacing it.
            rm -f "$tmp"
            [ -f "$CO/$path" ] || return 2
            ledger_apply "$path" "$S" "$target" || return $?
          fi
        fi ;;
      *) git -C "$CO" checkout -q "$target" -- "$path" || return 2 ;;
    esac
  done < <(git -C "$CO" diff --name-only --diff-filter=AM "$S" "$target")
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    hp_contained "$CO" "$path" || return 4
    # The delete walk records the workspace too: a deletion-only apply met
    # by a link at the directory must bring the rest back after the repair.
    # A workspace the target empties (a remote finish) tracks nothing
    # afterwards, so the pass below restores nothing there.
    case "$path" in plans/*/*) ws=${path#plans/}; ws=${ws%%/*}; [ "$ws" = "$last_ws" ] || touched_ws[${#touched_ws[@]}]=$ws; last_ws=$ws ;; esac
    case "$path" in
      plans/*/progress.md)
        dir=$(dirname "$CO/$path")
        if [ -d "$dir" ]; then remove_verified "$dir" "$S:plans/$(basename "$dir")" || return 6; fi ;;
      *) rm -f "$CO/$path" 2>/dev/null; [ ! -e "$CO/$path" ] || return 2 ;;
    esac
  done < <(git -C "$CO" diff --name-only --diff-filter=D "$S" "$target")
  # Each workspace this apply wrote into or removed from comes back whole:
  # every path the target tracks under it that is still missing is
  # published from the target, with its tracked mode. A link at such a
  # path is refused and named, never skipped: skipped, the next snapshot
  # would commit it onto the branch. The publish is one link(2) from a
  # temporary copy in the .restore sidecar at the checkout root (never
  # inside a workspace, where a crash would leave it for a snapshot to
  # commit), so a file a writer creates between the check and the publish
  # is theirs; a ledger a writer creates there, before the check or after
  # it, is reconciled, never adopted.
  i=0
  while [ "$i" -lt "${#touched_ws[@]}" ]; do
    ws=${touched_ws[$i]}; i=$((i + 1))
    while IFS=$'\t' read -r meta path; do
      [ -n "$path" ] || continue
      hp_contained "$CO" "$path" || return 4
      if [ -e "$CO/$path" ]; then
        # A ledger that is already there is one a writer recreated while
        # the marker was down: reconciled against the branch's, never left
        # for the next snapshot to publish over it.
        case "$path" in plans/*/progress.md) [ -f "$CO/$path" ] || return 2; ledger_apply "$path" "$S" "$target" || return $? ;; esac
        continue
      fi
      # recover_apply checked the sidecar at the top of the locked section,
      # with the whole apply between that check and this write; mkdir -p on
      # a link to a directory keeps the link, so the copy would land
      # outside the checkout.
      # Test hook: a writer replaces the sidecar with a link in that window.
      case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-link-restore:*) rm -rf "$CO/.restore"; ln -s "${HYPERPOWERS_TEST_WRITER_AT#sync-link-restore:}" "$CO/.restore" ;; esac
      if [ -L "$CO/.restore" ]; then
        echo "sdd-state: $CO/.restore is a symbolic link; refusing to stage a restore copy through it" >&2
        return 2
      fi
      mkdir -p "$(dirname "$CO/$path")" "$CO/.restore" || return 2
      n=$((n + 1)); tmp="$CO/.restore/$$.$n"; rm -f "$tmp"
      git -C "$CO" show "$target:$path" > "$tmp" || { rm -f "$tmp"; return 2; }
      case "$meta" in 100755*) chmod 755 "$tmp" || { rm -f "$tmp"; return 2; } ;; esac
      if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = restore-after-copy ]; then hp_unlock; exit 99; fi
      # Test hook: a writer creates the file right before the publish.
      case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-before-restore:*) [ "${HYPERPOWERS_TEST_WRITER_AT#sync-before-restore:}" != "$path" ] || printf 'concurrent write\n' > "$CO/$path" ;; esac
      if ! ln "$tmp" "$CO/$path" 2>/dev/null; then
        rm -f "$tmp"
        [ -e "$CO/$path" ] || return 2
        case "$path" in plans/*/progress.md) [ -f "$CO/$path" ] || return 2; ledger_apply "$path" "$S" "$target" || return $? ;; esac
        continue
      fi
      rm -f "$tmp"
    done < <(git -C "$CO" ls-tree -r "$target" -- "plans/$ws")
  done
  # Emptied, the sidecar goes with the apply that emptied it; a copy a
  # crash left behind keeps it until the next recovery sweeps it.
  rmdir "$CO/.restore" 2>/dev/null
  return 0
}
# One sentence for the one failure a human clears by hand without reading
# code: a link where the apply writes or removes a regular file.
# hp_contained has just named the path.
say_link_repair() {
  echo "sdd-state: a symbolic link sits where sync writes or removes a regular file (named above); remove the link, leave $CO/.sync-applying in place, and run sdd-state sync again: the apply finishes from the branch" >&2
}
# recover_apply: finish a sync that was interrupted after its marker went
# down. A journaled ledger rewrite is finished first (it is self-contained).
# With the branch still at the marker's S, the irreversible pre-ref steps
# may already have run (the verified copies of ledgers the target deletes),
# so the apply is completed, never undone: the ref moves to the target
# (guarded), any copy still renamed aside goes, and the post-ref apply
# follows. ledger_apply is idempotent, so a half-applied ledger is completed,
# never appended to twice. The marker is a barrier: a malformed marker, a
# branch that has left both S and the target, or a recovery that fails all
# leave it in place and say so, and every publishing subcommand refuses
# until the tree is repaired.
recover_apply() {
  local S="" target="" rc head j path dir tracked
  # Four paths at the checkout root are checked for a link before anything
  # uses them: .rewrite, .sync-applying and .restore, which this helper or
  # its callers write, and plans, which it only reads. The journals come
  # before anything else, and a link at any of the four would have the
  # recovery walk, and finish, whatever it points at.
  if [ -L "$CO/.rewrite" ]; then
    echo "sdd-state: $CO/.rewrite is a symbolic link; refusing to journal a ledger rewrite through it" >&2
    return 2
  fi
  if [ -L "$CO/.sync-applying" ]; then
    echo "sdd-state: $CO/.sync-applying is a symbolic link; refusing to write the sync marker through it" >&2
    return 2
  fi
  if [ -L "$CO/.restore" ]; then
    echo "sdd-state: $CO/.restore is a symbolic link; refusing to sweep restore copies through it" >&2
    return 2
  fi
  # The sweep below and every apply walk under plans/: a link there would
  # take both out of the checkout.
  if [ -L "$CO/plans" ]; then
    echo "sdd-state: $CO/plans is a symbolic link; refusing to run recovery through it" >&2
    return 2
  fi
  # Defence in depth for a checkout created before the tree validation: the
  # sidecars are this host's own interrupted state, so a branch that tracks
  # one is carrying somebody else's, and the loop below would run it.
  tracked=$(git -C "$CO" ls-tree --full-tree HEAD -- .sync-applying .rewrite .restore 2>/dev/null) || tracked=""
  if [ -n "$tracked" ]; then
    echo "sdd-state: the state branch tracks a recovery sidecar at ${tracked#*$'\t'}; refusing to run recovery from committed files. Remove it from the branch on the host that committed it, push, then sync again" >&2
    return 2
  fi
  # A new ledger interrupted between its temporary copy and its publish
  # leaves that copy inside a workspace, where a snapshot would commit it;
  # only real workspace directories are swept, never a link at plans/<ws>.
  # A restored file's copy lives in the .restore sidecar, swept whole.
  for dir in "$CO"/plans/*/; do
    [ -d "$dir" ] && [ ! -L "${dir%/}" ] || continue
    rm -f "$dir"progress.md.new.* 2>/dev/null
  done
  rm -rf "$CO/.restore" 2>/dev/null
  for j in "$CO"/.rewrite/*.journal; do
    [ -f "$j" ] || continue
    rewrite_finish "${j%.journal}" || { echo "sdd-state: an interrupted ledger rewrite left $j and finishing it failed; check the ledger it names, then remove it and its .staged file" >&2; return 2; }
  done
  [ -f "$CO/.sync-applying" ] || return 0
  read -r S target < "$CO/.sync-applying" 2>/dev/null || true
  # Validated as commits this checkout knows, not by length: a repository
  # with extensions.objectFormat = sha256 writes 64-character ids.
  if ! git -C "$CO" cat-file -e "$S^{commit}" 2>/dev/null || ! git -C "$CO" cat-file -e "$target^{commit}" 2>/dev/null; then
    echo "sdd-state: $CO/.sync-applying is not a valid sync marker; check the working tree under $CO, then remove the marker" >&2
    return 2
  fi
  head=$(tip_of "$CO" "refs/heads/$BRANCH")
  if [ "$head" = "$S" ] && [ "$S" != "$target" ]; then
    hp_has_sentinel "$CO" "$target" || { echo "sdd-state: $CO/.sync-applying names a target without the state sentinel; check the working tree under $CO, then remove the marker" >&2; return 2; }
    # The verified copies go before the ref moves, the order apply_target
    # itself follows: a crash between the two would otherwise leave a tomb
    # under plans/ that no later call for this plan revisits.
    while IFS= read -r path; do
      case "$path" in plans/*/progress.md) rm -rf "$CO/plans/.removing-$(basename "$(dirname "$path")")"-* ;; esac
    done < <(git -C "$CO" diff --name-only --diff-filter=D "$S" "$target")
    git -C "$CO" update-ref -m "sdd sync (recovered)" "refs/heads/$BRANCH" "$target" "$S" 2>/dev/null || { echo "sdd-state: an interrupted sync left $CO/.sync-applying and the branch could not be moved to its target; check the working tree under $CO, then remove the marker" >&2; return 2; }
    if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = recover-after-update-ref ]; then hp_unlock; exit 99; fi
    head=$target
  fi
  if [ "$head" != "$target" ]; then
    echo "sdd-state: an interrupted sync left $CO/.sync-applying but the branch has moved from its target ($(short "$target") to $(short "$head")); check the working tree under $CO, then remove the marker" >&2
    return 2
  fi
  git -C "$CO" reset -q 2>/dev/null
  apply_files "$S" "$target"; rc=$?
  if [ "$rc" -eq 4 ]; then say_link_repair; return 2; fi
  if [ "$rc" -ne 0 ]; then
    echo "sdd-state: an interrupted sync left $CO/.sync-applying and finishing it failed (rc=$rc); repair the working tree under $CO and run sdd-state sync again" >&2
    return 2
  fi
  rm -f "$CO/.sync-applying"
}
# restore_tombs: put back every copy an interrupted removal renamed aside
# whose workspace path is free again. finish and sdd-dir restore such a copy
# for their own plan and nothing revisits one for another plan, so without
# this the deleted tracked rows it leaves would hold every later sync on the
# repository. A copy stranded beside a workspace that is occupied again is a
# human's to merge: it stays, named once.
restore_tombs() {
  local t name
  for t in "$CO"/plans/.removing-*; do
    [ -d "$t" ] || continue
    name=${t##*/}; name=${name#.removing-}; name=${name%-*}
    if [ -e "$CO/plans/$name" ] || [ -L "$CO/plans/$name" ]; then
      if [ "$NAMED_TOMB" -eq 0 ]; then
        echo "sdd-state: a copy from an interrupted removal is at $t beside $CO/plans/$name; move its files back into $CO/plans/$name or delete the copy, then run sdd-state sync again" >&2
        NAMED_TOMB=1
      fi
      continue
    fi
    # Only a workspace the branch still tracks comes back: its deleted
    # rows are what would hold the apply. A copy left for a plan the branch
    # does not know is a human's leftover and stays where it is.
    git -C "$CO" cat-file -e "refs/heads/$BRANCH:plans/$name" 2>/dev/null || continue
    restore_tomb "$CO/plans/$name" "$t" || {
      if [ "$NAMED_TOMB" -eq 0 ]; then
        echo "sdd-state: the copy an interrupted removal left at $t could not be put back at $CO/plans/$name; move its files back or delete the copy, then run sdd-state sync again" >&2
        NAMED_TOMB=1
      fi
    }
  done
}
# apply_target <S> <target>: 0 applied, 5 retry (a non-ledger file changed
# before the ref moved, or the ref moved under us), 6 remote-finished (a
# ledger the target deletes changed here; nothing moved), 7 apply incomplete
# after the ref moved (the marker stays; the next call finishes it), 2 error.
# Controllers write without the lock, so the working tree is live.
apply_target() {
  local S=$1 target=$2 line status path top tracked incoming left refusal rest res dir rc i refused tombs=() dirs=()
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-before-apply:*) printf 'concurrent write\n' >> "$CO/${HYPERPOWERS_TEST_WRITER_AT#sync-before-apply:}" ;; esac
  if [ "${HYPERPOWERS_TEST_PAUSE_AT:-}" = sync-before-apply ]; then
    : > "$CO/.sync-paused"
    while [ -e "$CO/.sync-pause" ]; do sleep 0.1; done
    rm -f "$CO/.sync-paused"
  fi
  restore_tombs
  # Rows are read NUL-delimited: the porcelain format C-quotes a path with
  # a space or an unusual byte, and a quoted row would match none of the
  # exemptions below. A rename row carries a second field, consumed here.
  # -uall lists untracked files one by one: with no tracked entry under
  # plans/, git would otherwise collapse the directory to a single
  # "?? plans/" row, which no exemption names, so one leftover there would
  # hold every sync and the advice would name the dossier root.
  # snapshot_pending runs before this scan in cmd_sync, so a workspace not
  # yet snapshotted is tracked by the time the scan runs and -uall cannot
  # refuse it.
  refused=0
  while IFS= read -r -d '' line; do
    [ -n "$line" ] || continue
    status=${line:0:2}; path=${line:3}
    case "$status" in R*|C*) IFS= read -r -d '' _ ;; esac
    case "$status|$path" in
      " M|plans/"*"/progress.md") continue ;;
    esac
    # A copy a killed removal left aside is not a concurrent write: it is
    # cleared by finish, by sdd-dir and by the restore above, and
    # treating it as one would wedge every later sync on this repository.
    # A copy prune quarantined at plans/.pruned-*, or one staged on its way
    # there at plans/.quarantining-*, is as much a removal's leftover as a
    # tomb, and waits there for a later prune; holding the apply on it
    # would wedge every sync for as long as it sits.
    case "$path" in
      "plans/.removing-"*|"plans/.pruned-"*|"plans/.quarantining-"*)
        # Only an entry neither side of the apply tracks is a leftover: a
        # workspace from before this release may carry such a name, and
        # its dirty rows hold the apply like any other's (snapshot_pending
        # skips dotted directories, so nothing else would publish them).
        # The lookup asks for any entry, not -d: a tracked file directly
        # under plans/ is no more a leftover than a tracked directory, and
        # -d would answer nothing for it and exempt its dirty row.
        # A lookup that fails counts as tracked.
        top=${path#plans/}; top=${top%%/*}
        tracked=$(git -C "$CO" ls-tree "$S" -- "plans/$top" 2>/dev/null) || tracked=x
        incoming=$(git -C "$CO" ls-tree "$target" -- "plans/$top" 2>/dev/null) || incoming=unreadable
        if [ -z "$tracked" ] && [ "$incoming" = unreadable ]; then
          # Fail closed, but say what actually happened: a human told a
          # copy collides would go looking for an incoming workspace that
          # may not be there.
          echo "sdd-state: the incoming commit could not be read at plans/$top, where an untracked copy sits; nothing was applied. Run sdd-state sync again, and if it persists the repository needs repair" >&2
          return 2
        fi
        if [ -z "$tracked" ] && [ -z "$incoming" ]; then continue; fi
        if [ -z "$tracked" ]; then
          # The target adds this name for the first time while a local
          # removal or prune copy holds it. Exempting the row here would
          # have the apply write the incoming files into that copy, which
          # may be the only one of its dossier. The helper never makes a
          # dotted workspace name (hp_plan_ws_name strips leading dots),
          # so the incoming entry was committed by hand on some host; the
          # human decides which of the two survives.
          #
          # The destination the line names is at the checkout root, not
          # under plans/: a copy left there whose name still ends in a pid
          # parses as a tomb or a quarantine, and a later prune --apply
          # would delete the very copy this refusal protects. Nothing
          # reaches a root .aside-*: snapshot_pending and recover_apply
          # walk plans/*/, prune lists plans/.removing-*, .pruned-* and
          # .quarantining-*, and this scan is pathspec-limited to plans/.
          echo "sdd-state: the state branch adds plans/$top, and an untracked copy of that name is already at $CO/plans/$top; nothing was applied, because a removal or prune copy is never written into. Move the local copy out of plans/ (mv '$CO/plans/$top' '$CO/.aside-$top-$$') and run sdd-state sync again" >&2
          return 2
        fi ;;
    esac
    # A tracked file missing from a workspace: the restore above left the
    # copy that holds it only when the workspace is occupied again, and
    # named it there, so nothing more is said about this row; telling a
    # human to move or delete a file that is gone would be wrong.
    case "$status|$path" in
      " D|plans/"*)
        left=${path#plans/}; left=${left%%/*}
        if ! ls -d "$CO/plans/.removing-$left-"* >/dev/null 2>&1; then
          [ "$NAMED_LEFTOVER" -eq 1 ] || echo "sdd-state: $CO/$path is committed on the state branch but missing from the checkout and holds the apply; put it back or finish its plan, then run sdd-state sync again" >&2
        fi
        refused=1; continue ;;
    esac
    [ "$NAMED_LEFTOVER" -eq 1 ] || echo "sdd-state: $CO/$path is not part of a plan workspace and holds the apply; inspect it, move or delete it, then run sdd-state sync again" >&2
    refused=1
  done < <(git -C "$CO" status --porcelain -z -uall -- plans/ 2>/dev/null)
  if [ "$refused" -eq 1 ]; then NAMED_LEFTOVER=1; return 5; fi
  # The incoming tree is inspected whole before the checkout materializes
  # any of it: the same validation the creation of a checkout runs, so a
  # commit carrying a symbolic link, a submodule entry or a recovery sidecar
  # is refused by either route. The refusal comes before anything is renamed
  # or moved, so nothing is left half-applied.
  rc=0; refusal=$(hp_tree_refusal "$CO" "$target") || rc=$?
  # A tree that could not be read at all names no kind and no path, so it
  # gets its own sentence rather than the refusal's two-word parse.
  if [ "$rc" -eq 2 ]; then
    echo "sdd-state: $target could not be read as a tree; refusing to apply it. Fetch the state branch again and retry; if it persists, the repository needs repair" >&2
    return 2
  fi
  if [ "$rc" -ne 0 ]; then
    rest=${refusal#* }
    echo "sdd-state: $target carries a ${refusal%% *} ${rest%% *} at ${rest#* }; refusing to apply it. Remove it on the host that committed it and commit the removal on the state branch (snapshot does that for a path under plans/; a root-level one needs a commit on the branch itself), push, then sync again" >&2
    return 2
  fi
  # Every path this apply touches must also be a real entry on disk: a link
  # already there would take the writes below out of the cache.
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    hp_contained "$CO" "$path" || return 2
  done < <(git -C "$CO" diff --name-only "$S" "$target")
  # Ledgers the target deletes are a remote finish: every one is renamed
  # aside and verified first, before the ref moves, so a line written up to
  # the rename is caught; one refusal puts them all back and nothing has
  # changed; only when every one verified are the copies discarded.
  REMOTE_FINISHED=""
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-before-delete:*) printf 'concurrent write\n' >> "$CO/${HYPERPOWERS_TEST_WRITER_AT#sync-before-delete:}" ;; esac
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in plans/*/progress.md) ;; *) continue ;; esac
    dir=$(dirname "$CO/$path")
    [ -d "$dir" ] || continue
    remove_verified "$dir" "$S:plans/$(basename "$dir")" keep; rc=$?
    case "$rc" in
      0) dirs[${#dirs[@]}]=$dir; tombs[${#tombs[@]}]=$TOMB ;;
      1) REMOTE_FINISHED="$REMOTE_FINISHED,$(enc "$(basename "$dir")")" ;;
      *) i=0; while [ "$i" -lt "${#tombs[@]}" ]; do restore_tomb "${dirs[$i]}" "${tombs[$i]}"; i=$((i + 1)); done; return 2 ;;
    esac
  done < <(git -C "$CO" diff --name-only --diff-filter=D "$S" "$target")
  restore_all() { local k=0; while [ "$k" -lt "${#tombs[@]}" ]; do restore_tomb "${dirs[$k]}" "${tombs[$k]}"; k=$((k + 1)); done; }
  if [ -n "$REMOTE_FINISHED" ]; then
    restore_all
    REMOTE_FINISHED=${REMOTE_FINISHED#,}; return 6
  fi
  hp_has_sentinel "$CO" "$target" || { restore_all; return 2; }
  # The marker goes down before anything irreversible: the verified copies
  # are discarded only once it is on disk and read back, and the ref moves
  # after that. A crash anywhere from here on is finished by recover_apply.
  if [ -L "$CO/.sync-applying" ]; then
    echo "sdd-state: $CO/.sync-applying is a symbolic link; refusing to write the sync marker through it" >&2
    restore_all; return 2
  fi
  printf '%s %s\n' "$S" "$target" > "$CO/.sync-applying" || { rm -f "$CO/.sync-applying"; restore_all; return 2; }
  [ "$(cat "$CO/.sync-applying" 2>/dev/null)" = "$S $target" ] || { rm -f "$CO/.sync-applying"; restore_all; return 2; }
  if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = sync-after-marker ]; then hp_unlock; exit 99; fi
  i=0; while [ "$i" -lt "${#tombs[@]}" ]; do discard_tomb "${tombs[$i]}" || true; i=$((i + 1)); done
  if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = sync-after-discard ]; then hp_unlock; exit 99; fi
  git -C "$CO" update-ref -m "sdd sync" "refs/heads/$BRANCH" "$target" "$S" 2>/dev/null || { rm -f "$CO/.sync-applying"; return 5; }
  if [ "${HYPERPOWERS_TEST_CRASH_AT:-}" = sync-after-update-ref ]; then hp_unlock; exit 99; fi
  git -C "$CO" reset -q 2>/dev/null
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-after-ref-link:*) rm -f "$CO/${HYPERPOWERS_TEST_WRITER_AT#sync-after-ref-link:}"; ln -s /dev/null "$CO/${HYPERPOWERS_TEST_WRITER_AT#sync-after-ref-link:}" ;; esac
  # The ref has moved: an attempt a live writer defeats is retried here,
  # never by the caller's loop, whose snapshot would publish the
  # half-applied tree over the target. Three defeats, or a ledger the
  # target deletes reappearing, leave the marker for the next call to
  # finish through recover_apply.
  for _ in 1 2 3; do
    apply_files "$S" "$target"; res=$?
    [ "$res" -eq 5 ] || break
  done
  case "$res" in
    0)
      # Test hook: a link planted after the apply and before the re-walk.
      case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-after-apply-link:*) rm -f "$CO/${HYPERPOWERS_TEST_WRITER_AT#sync-after-apply-link:}"; ln -s /dev/null "$CO/${HYPERPOWERS_TEST_WRITER_AT#sync-after-apply-link:}" ;; esac
      # A link that appeared under a path this apply touched (a writer
      # between the checks above and the writes) fails it closed: the marker
      # stays, and every later call refuses until the link is gone.
      while IFS= read -r path; do
        [ -n "$path" ] || continue
        hp_contained "$CO" "$path" || { say_link_repair; return 2; }
      done < <(git -C "$CO" diff --name-only "$S" "$target")
      rm -f "$CO/.sync-applying"; return 0 ;;
    4) say_link_repair; return 2 ;;
    5|6) return 7 ;;
    *) return "$res" ;;
  esac
}
cmd_sync() {
  local plan="" repo="" assume=0 stamp err rc S R target kind mt tree res had_co created="" ensure url_before url_pin fp_before fp_after n nonce pin_count fetch_ref stale_ref old_remote
  REMOTE_FINISHED=""
  # remove_verified (Task 6) and recover_apply live in this file; sync, finish, handoff and snapshot share them.
  while [ $# -gt 0 ]; do
    case "$1" in
      --assume-absent) assume=1; shift ;;
      --repo) [ $# -ge 2 ] || usage; repo=$2; shift 2 ;;
      -*) usage ;;
      *) plan=$1; shift ;;
    esac
  done
  if [ -n "$plan" ]; then
    resolve_plan_basic "$plan"
  elif [ -n "$repo" ]; then
    PLAN_DIR=$(hp_physical_dir "$repo") || usage
    git -C "$PLAN_DIR" rev-parse --git-dir >/dev/null 2>&1 || { echo "sdd-state: not a git repository: $repo" >&2; exit 2; }
    BRANCH=$(hp_state_branch "$PLAN_DIR"); REMOTE=$(hp_state_remote "$PLAN_DIR"); CO=$(hp_checkout_path "$PLAN_DIR")
  else
    usage
  fi
  if [ "$(hp_backend "$PLAN_DIR")" = plain ]; then echo "status=plain"; return 0; fi
  stamp=$(hp_stamp_path "$PLAN_DIR")
  mkdir -p "$(dirname "$stamp")"
  # Outcomes that end before reconciliation still ensure the checkout.
  settle() { # <status> <exit>
    # A refused tip (hostile tree) or a checkout this host cannot have is an
    # error with a status line, not a silent exit: every subcommand prints
    # exactly one.
    ensure=$(hp_ensure_checkout "$PLAN_DIR") || { echo "status=error"; return 2; }
    if [ "${ensure%% *}" != branch ]; then echo "status=plain"; return 0; fi
    S=$(tip_of "$CO" "refs/heads/$BRANCH")
    echo "status=$1 local=$(short "$S") remote=none age=$(age_of "$CO" "$S")"
    return "$2"
  }
  # Removes this process's private fetch ref, on every exit from the fetch.
  drop_fetch_ref() { git -C "$PLAN_DIR" update-ref -d "$fetch_ref" 2>/dev/null || true; }
  # Writes the stamp for the endpoint the fetch contacted, or refuses.
  stamp_fetched() {
    # The alias check runs again here: a remote named like the alias and
    # configured during the fetch could have shadowed the pin.
    if git -C "$PLAN_DIR" config --get-regexp "^remote\.hp-fetch-$$\." >/dev/null 2>&1; then
      rm -f "$stamp"
      echo "sdd-state: the repository configured a remote named hp-fetch-$$ during the sync; nothing was stamped. Remove that section from its git config and run sdd-state sync again" >&2
      return 1
    fi
    fp_after=$(hp_remote_fingerprint "$PLAN_DIR") || fp_after=unavailable
    if [ "$fp_after" != "$fp_before" ] || [ "$(hp_state_remote "$PLAN_DIR") $(hp_state_branch "$PLAN_DIR")" != "$REMOTE $BRANCH" ]; then
      rm -f "$stamp"
      echo "sdd-state: the remote changed during the sync (remote, branch or URL); nothing was stamped. Run sdd-state sync again" >&2
      return 1
    fi
    printf '%s %s %s\n' "$REMOTE" "$BRANCH" "$fp_before" > "$stamp"
  }
  if [ "$assume" -eq 1 ]; then
    fp_before=$(hp_remote_fingerprint "$PLAN_DIR") || { echo "sdd-state: the remote's URL could not be fingerprinted (node is required); nothing was stamped. Run sdd-state sync again" >&2; echo "status=error"; return 2; }
    printf '%s %s %s\n' "$REMOTE" "$BRANCH" "$fp_before" > "$stamp"; settle assumed-absent 0; return $?
  fi
  # No remote to earn a stamp against: one written here would vouch for a
  # remote named later, so none is left and creation rests on hp_has_remote.
  if ! hp_has_remote "$PLAN_DIR"; then rm -f "$stamp"; settle no-remote 0; return $?; fi
  # The stamp names the endpoint that was fetched. The remote alias is
  # mutable, so its URL is read exactly once, here, and both the pin and
  # the fingerprint come from that one captured string: a repoint anywhere
  # after this line reaches neither, and the remote, branch and URL are
  # read again after the fetch, so one that is not undone is caught there
  # and nothing is stamped.
  #
  # The read takes the URL as written. git applies url.<base>.insteadOf
  # once to whatever a remote carries, so a pin on the already-rewritten
  # form would be rewritten a second time, to an endpoint the fingerprint
  # never named. A remote with no url entry has nothing written, so the
  # rewritten form, which is all get-url can give, stands in; that read is
  # then the single one.
  #
  # remote.<name>.url is multi-valued, and the value wanted is the first:
  # git fetches from a remote's first URL and get-url reports that one, so
  # a stamp taken from any other would name an endpoint the fetch never
  # contacts. config --get returns the last value, hence --get-all and the
  # first record of it; -z, because a value may hold a newline and a
  # line-oriented read would truncate it.
  url_pin=""
  IFS= read -r -d '' url_pin < <(git -C "$PLAN_DIR" config -z --get-all "remote.$REMOTE.url" 2>/dev/null) || url_pin=""
  if [ -z "$url_pin" ]; then
    url_pin=$(git -C "$PLAN_DIR" remote get-url "$REMOTE" 2>/dev/null) || url_pin=""
  fi
  # Test hook: a repoint in the interval a second read would have been
  # exposed to, undone right after the fetch so the stamp check passes.
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-after-url-read:*) git -C "$PLAN_DIR" remote set-url "$REMOTE" "${HYPERPOWERS_TEST_WRITER_AT#sync-after-url-read:}" ;; esac
  # Environment configuration needs git 2.31; an older git ignores it and
  # would fetch nothing, diagnosed as offline, so it is refused by name.
  # The probe below reads the alias from that configuration too.
  hp_git_version_at_least 2 31 || { echo "sdd-state: git 2.31 or newer is required to pin the fetch to the fingerprinted URL (found $(git --version)); nothing was stamped" >&2; echo "status=error"; return 2; }
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in
    sync-shadow-alias:*) git -C "$PLAN_DIR" config "remote.hp-fetch-$$.url" "${HYPERPOWERS_TEST_WRITER_AT#sync-shadow-alias:}" ;;
  esac
  # remote.<name>.url is multi-valued and git takes the first value, so a
  # repository that configures the alias's name would shadow the pin, and
  # the probe below with it.
  if git -C "$PLAN_DIR" config --get-regexp "^remote\.hp-fetch-$$\." >/dev/null 2>&1; then
    echo "sdd-state: the repository configures a remote named hp-fetch-$$, which the pinned fetch needs for itself; remove that section from its git config and run sdd-state sync again" >&2
    echo "status=error"; return 2
  fi
  # The pin is appended to whatever GIT_CONFIG_* the caller supplied, never
  # substituted for it, and the URL travels in the environment, not argv.
  n=${GIT_CONFIG_COUNT:-0}; case "$n" in ''|*[!0-9]*) n=0 ;; esac
  printf -v "GIT_CONFIG_KEY_$n" '%s' "remote.hp-fetch-$$.url"; printf -v "GIT_CONFIG_VALUE_$n" '%s' "$url_pin"
  export "GIT_CONFIG_KEY_$n" "GIT_CONFIG_VALUE_$n"
  # The endpoint the fetch will contact, derived from the captured string
  # and nothing else: the alias the fetch will use is asked to expand it,
  # which applies insteadOf exactly once, as the fetch does. ls-remote
  # --get-url, not remote get-url, which refuses a remote that only
  # environment configuration defines; neither contacts the endpoint, and
  # the URL stays out of argv either way.
  if [ -n "$url_pin" ]; then
    url_before=$(GIT_CONFIG_COUNT=$((n + 1)) git -C "$PLAN_DIR" ls-remote --get-url "hp-fetch-$$" 2>/dev/null) || url_before=""
    if [ -z "$url_before" ]; then
      unset "GIT_CONFIG_KEY_$n" "GIT_CONFIG_VALUE_$n"
      echo "sdd-state: the remote's URL could not be expanded to the endpoint the fetch would contact; nothing was stamped. Run sdd-state sync again" >&2
      echo "status=error"; return 2
    fi
    fp_before=$(hp_url_fingerprint "$url_before") || { unset "GIT_CONFIG_KEY_$n" "GIT_CONFIG_VALUE_$n"; echo "sdd-state: the remote's URL could not be fingerprinted (node is required); nothing was stamped. Run sdd-state sync again" >&2; echo "status=error"; return 2; }
  else
    url_before=""; fp_before=none
  fi
  # Test hook: a rewrite rule for the probed endpoint, added in the window
  # between the probe and the fetch and removed right after it.
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-aba-rewrite:*) git -C "$PLAN_DIR" config "url.${HYPERPOWERS_TEST_WRITER_AT#sync-aba-rewrite:}.insteadOf" "$url_before" ;; esac
  # The probe and the fetch are separate git invocations, each applying the
  # rewrite rules it finds, so a rule added between them would send the
  # fetch somewhere the fingerprint never named. The fetch therefore does
  # not carry the captured URL at all: the alias is repinned to a one-time
  # name, and a second environment entry maps that name to the endpoint the
  # probe returned. git rewrites a URL once and prefers the strictly
  # longest matching insteadOf, so the only rule that could compete is one
  # whose insteadOf is this exact name, and the name is 128 bits this sync
  # invented a moment ago: no config file can hold a rule for it, and a
  # repository rule for the endpoint itself never applies, because what is
  # matched is the one-time name and not the endpoint. That is why the
  # uniqueness check above covers the alias and not url.<endpoint>. Should
  # the mapping somehow fail to apply, the fetch is handed the hp-pin://
  # URL itself, which no git transport serves, so it fails and reads as
  # offline instead of contacting anything.
  pin_count=$((n + 1))
  if [ -n "$url_before" ]; then
    nonce=$(node -e 'process.stdout.write(require("crypto").randomBytes(16).toString("hex"))' 2>/dev/null) || nonce=""
    case "$nonce" in ????????????????????????????????) ;; *) nonce="" ;; esac
    case "$nonce" in *[!0-9a-f]*) nonce="" ;; esac
    if [ -z "$nonce" ]; then
      unset "GIT_CONFIG_KEY_$n" "GIT_CONFIG_VALUE_$n"
      echo "sdd-state: the one-time name the pinned fetch is addressed by could not be generated (node is required); nothing was stamped. Run sdd-state sync again" >&2
      echo "status=error"; return 2
    fi
    printf -v "GIT_CONFIG_VALUE_$n" '%s' "hp-pin://$nonce/"
    printf -v "GIT_CONFIG_KEY_$((n + 1))" '%s' "url.$url_before.insteadOf"
    printf -v "GIT_CONFIG_VALUE_$((n + 1))" '%s' "hp-pin://$nonce/"
    export "GIT_CONFIG_KEY_$((n + 1))" "GIT_CONFIG_VALUE_$((n + 1))"
    pin_count=$((n + 2))
  fi
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in
    sync-aba-fetch:*) git -C "$PLAN_DIR" remote set-url "$REMOTE" "${HYPERPOWERS_TEST_WRITER_AT#sync-aba-fetch:}" ;;
  esac
  # The fetch lands in a ref of this process's own, never straight in the
  # shared remote-tracking ref: the tip is read from the private ref, so a
  # fetch another process finishes in between cannot hand this sync a
  # commit the pinned endpoint never served. A ref whose owner is gone is
  # a crashed sync's leftover and is swept first; one whose owner is alive
  # belongs to a sync still running.
  fetch_ref="refs/hp-fetch/$$"
  for stale_ref in $(git -C "$PLAN_DIR" for-each-ref --format='%(refname)' refs/hp-fetch 2>/dev/null); do
    case "${stale_ref##*/}" in ''|*[!0-9]*) continue ;; esac
    hp_pid_gone "${stale_ref##*/}" && git -C "$PLAN_DIR" update-ref -d "$stale_ref" 2>/dev/null
  done
  old_remote=$(tip_of "$PLAN_DIR" "refs/remotes/$REMOTE/$BRANCH")
  err=$(GIT_HTTP_LOW_SPEED_LIMIT=1 GIT_HTTP_LOW_SPEED_TIME=30 GIT_CONFIG_COUNT=$pin_count git -C "$PLAN_DIR" fetch -q "hp-fetch-$$" "+refs/heads/$BRANCH:$fetch_ref" 2>&1); rc=$?
  unset "GIT_CONFIG_KEY_$n" "GIT_CONFIG_VALUE_$n" "GIT_CONFIG_KEY_$((n + 1))" "GIT_CONFIG_VALUE_$((n + 1))"
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in
    # Both repoint seams put the captured URL back, so stamp_fetched's
    # re-read sees the remote the fingerprint named.
    sync-aba-fetch:*|sync-after-url-read:*) git -C "$PLAN_DIR" remote set-url "$REMOTE" "$url_pin" ;;
    sync-after-fetch-set-url:*) git -C "$PLAN_DIR" remote set-url "$REMOTE" "${HYPERPOWERS_TEST_WRITER_AT#sync-after-fetch-set-url:}" ;;
    sync-aba-rewrite:*) git -C "$PLAN_DIR" config --remove-section "url.${HYPERPOWERS_TEST_WRITER_AT#sync-aba-rewrite:}" ;;
    # Test hook: another process's fetch finishes between this one and the
    # read of its tip, leaving its own commit in the shared ref.
    sync-after-fetch:*) git -C "$PLAN_DIR" update-ref "refs/remotes/$REMOTE/$BRANCH" "${HYPERPOWERS_TEST_WRITER_AT#sync-after-fetch:}" 2>/dev/null ;;
  esac
  if [ "$rc" -ne 0 ]; then
    drop_fetch_ref
    case "$err" in
      *"couldn't find remote ref"*) stamp_fetched || { echo "status=error"; return 2; }; settle absent 0; return $? ;;
    esac
    S=$(tip_of "$PLAN_DIR" "refs/heads/$BRANCH")
    # A default clone has the branch as a remote-tracking ref only; the
    # checkout is built from it, which creates the local head.
    if [ -z "$S" ] && [ -n "$(tip_of "$PLAN_DIR" "refs/remotes/$REMOTE/$BRANCH")" ]; then
      hp_ensure_checkout "$PLAN_DIR" >/dev/null 2>&1 || true
      S=$(tip_of "$PLAN_DIR" "refs/heads/$BRANCH")
    fi
    if [ -n "$S" ]; then
      hp_ensure_checkout "$PLAN_DIR" >/dev/null 2>&1 || true
      echo "status=offline local=$(short "$S") remote=$(short "$(tip_of "$PLAN_DIR" "refs/remotes/$REMOTE/$BRANCH")") age=$(age_of "$PLAN_DIR" "$S")"
      return 1
    fi
    echo "status=offline-no-state local=none remote=none age=0"
    return 1
  fi
  stamp_fetched || { drop_fetch_ref; echo "status=error"; return 2; }
  # The remote tip is read once, here, from this process's own ref, and
  # that sha alone is reconciled.
  R=$(tip_of "$PLAN_DIR" "$fetch_ref")
  [ -n "$R" ] || { drop_fetch_ref; echo "status=error"; return 2; }
  # The shared remote-tracking ref is then published by compare-and-swap
  # against the value it held before the fetch (an empty one means it must
  # not exist yet). A swap this sync loses was won by another fetch of the
  # same branch, whose tip is as current as this one's, so it is left alone.
  if [ -n "$old_remote" ]; then
    git -C "$PLAN_DIR" update-ref "refs/remotes/$REMOTE/$BRANCH" "$R" "$old_remote" 2>/dev/null || true
  else
    git -C "$PLAN_DIR" update-ref "refs/remotes/$REMOTE/$BRANCH" "$R" "$(hp_zero_oid "$PLAN_DIR")" 2>/dev/null || true
  fi
  case "${HYPERPOWERS_TEST_WRITER_AT:-}" in sync-after-pin:*) git -C "$PLAN_DIR" update-ref "refs/remotes/$REMOTE/$BRANCH" "${HYPERPOWERS_TEST_WRITER_AT#sync-after-pin:}" 2>/dev/null ;; esac
  # A branch at the state name whose root lacks the exact sentinel belongs
  # to someone else: it is never reconciled or written, and refs and files
  # stay as they are.
  if ! hp_has_sentinel "$PLAN_DIR" "$R"; then
    S=$(tip_of "$PLAN_DIR" "refs/heads/$BRANCH")
    drop_fetch_ref
    echo "sdd-state: $REMOTE/$BRANCH exists but is not a hyperpowers state branch; set git config hyperpowers.stateBranch to another name" >&2
    echo "status=foreign local=$(short "$S") remote=$(short "$R") age=$(age_of "$PLAN_DIR" "$R")"
    return 2
  fi
  # The first local branch is created here, from R, and never left to
  # hp_ensure_checkout: with no local branch it builds one from the shared
  # remote-tracking ref, which a lost compare-and-swap above leaves at
  # another fetch's tip, and the branch would then hold a commit this sync
  # neither fingerprinted nor reconciled while the stamp named its own
  # endpoint. The tree is refused first, exactly as the checkout creation
  # would refuse it, so a hostile tip never becomes a branch. The swap must
  # find no branch; losing it means another process created one first, and
  # hp_ensure_checkout continues from that as it always has.
  if [ -z "$(tip_of "$PLAN_DIR" "refs/heads/$BRANCH")" ]; then
    hp_refuse_tip "$PLAN_DIR" "$R" || { drop_fetch_ref; echo "status=error"; return 2; }
    if git -C "$PLAN_DIR" update-ref "refs/heads/$BRANCH" "$R" "$(hp_zero_oid "$PLAN_DIR")" 2>/dev/null; then
      # The tracking hp_ensure_checkout's remote mode would have recorded:
      # it adds from the branch name now, so nothing else would.
      git -C "$PLAN_DIR" config "branch.$BRANCH.remote" "$REMOTE" >/dev/null 2>&1 || true
      git -C "$PLAN_DIR" config "branch.$BRANCH.merge" "refs/heads/$BRANCH" >/dev/null 2>&1 || true
    fi
  fi
  had_co=0; [ -e "$CO/.git" ] && had_co=1
  ensure=$(hp_ensure_checkout "$PLAN_DIR") || { drop_fetch_ref; echo "status=error"; return 2; }
  # R is reachable from the branch or the checkout by now, so the private
  # ref that kept it alive can go.
  drop_fetch_ref
  if [ "${ensure%% *}" != branch ]; then echo "status=plain"; return 0; fi
  [ "$had_co" -eq 1 ] || created=created
  hp_lock "$PLAN_DIR" || return 2
  for _ in 1 2 3; do
    recover_apply || { hp_unlock; echo "status=error"; return 2; }
    snapshot_pending || { hp_unlock; echo "status=error"; return 2; }
    S=$(tip_of "$CO" "refs/heads/$BRANCH")
    if [ "$S" = "$R" ]; then
      hp_unlock; echo "status=${created:-up-to-date} local=$(short "$S") remote=$(short "$R") age=$(age_of "$CO" "$S")"; return 0
    fi
    if git -C "$CO" merge-base --is-ancestor "$S" "$R" 2>/dev/null; then
      target=$R; kind=fast-forwarded
    elif git -C "$CO" merge-base --is-ancestor "$R" "$S" 2>/dev/null; then
      hp_unlock; echo "status=ahead local=$(short "$S") remote=$(short "$R") age=$(age_of "$CO" "$S" "$R")"; return 0
    else
      if hp_git_version_at_least 2 38 && mt=$(git -C "$CO" merge-tree --write-tree "$S" "$R" 2>/dev/null); then
        tree=$(printf '%s\n' "$mt" | head -n 1)
        target=$(printf 'sdd: merge %s into %s\n' "$(short "$R")" "$(short "$S")" | hp_git_id "$CO" commit-tree "$tree" -p "$S" -p "$R") || { hp_unlock; echo "status=error"; return 2; }
        hp_has_sentinel "$CO" "$target" || { hp_unlock; echo "status=error"; return 2; }
        kind=merged
      else
        hp_unlock
        echo "status=diverged local=$(short "$S") remote=$(short "$R") age=$(age_of "$CO" "$S" "$R")"
        echo "merge=git -C $CO merge $REMOTE/$BRANCH"
        return 3
      fi
    fi
    apply_target "$S" "$target"; res=$?
    if [ "$res" -eq 0 ]; then
      hp_unlock; echo "status=$kind local=$(short "$target") remote=$(short "$R") age=$(age_of "$CO" "$target")"; return 0
    fi
    if [ "$res" -eq 6 ]; then
      hp_unlock; echo "status=remote-finished plans=$REMOTE_FINISHED local=$(short "$S") remote=$(short "$R") age=$(age_of "$CO" "$S" "$R")"; return 3
    fi
    if [ "$res" -eq 7 ]; then
      hp_unlock; echo "status=busy local=$(short "$target") remote=$(short "$R") age=$(age_of "$CO" "$target")"; return 3
    fi
    [ "$res" -eq 5 ] || { hp_unlock; echo "status=error"; return 2; }
  done
  hp_unlock
  echo "status=busy local=$(short "$S") remote=$(short "$R") age=$(age_of "$CO" "$S" "$R")"
  return 3
}

# --- verify ------------------------------------------------------------------
# The repository identity recorded at hand-off: the lexicographically
# smallest root commit of HEAD, stable across clones and hosts.
root_of() { git -C "$1" rev-list --max-parents=0 HEAD 2>/dev/null | sort | head -n 1; }
# <repo> <sha>: the commit exists, is unambiguous, and is reachable from HEAD.
commit_present() {
  git -C "$1" cat-file -e "$2^{commit}" 2>/dev/null && git -C "$1" merge-base --is-ancestor "$2" HEAD 2>/dev/null
}
# verify_ledger <ledger-copy> <code-repo>: the checks of verify over a
# ledger already copied out from under the lock. Prints the status line and
# returns its exit code; the caller removes the copy.
verify_ledger() {
  local ledger=$1 code=$2 line rec_root rec_sha="" rec_branch="" shas sha missing="" tasks plan_line plan_root plan_sha plan_branch
  line=$(grep -E '^handoff: code root=' "$ledger" | tail -n 1)
  if [ -n "$line" ]; then
    rec_root=$(printf '%s' "$line" | sed -n 's/^handoff: code root=\([0-9a-f]*\) .*/\1/p')
    rec_branch=$(printf '%s' "$line" | sed -n 's/^handoff: code root=[0-9a-f]* \(.*\)@[0-9a-f]* at .*/\1/p')
    rec_sha=$(printf '%s' "$line" | sed -n 's/^handoff: code root=[0-9a-f]* .*@\([0-9a-f]*\) at .*/\1/p')
    # A shallow clone's boundary commits read as roots: skip the identity
    # comparison there and let commit presence speak.
    if [ "$(git -C "$code" rev-parse --is-shallow-repository 2>/dev/null)" != true ] && [ "$(root_of "$code")" != "$rec_root" ]; then
      echo "status=wrong-repo expected=${rec_root:0:7} repo=code"; return 9
    fi
  fi
  # Both endpoints of every completion range, then the hand-off head.
  shas=$(grep -Eo 'Task [0-9]+: complete \(commits [0-9a-f]+\.\.[0-9a-f]+' "$ledger" | sed 's/.*(commits //; s/\.\./ /')
  tasks=$(printf '%s\n' "$shas" | grep -c .)
  [ -n "$rec_sha" ] && shas="$shas $rec_sha"
  for sha in $shas; do
    case ",$missing," in *",${sha:0:7},"*) continue ;; esac
    commit_present "$code" "$sha" || missing="$missing,${sha:0:7}"
  done
  if [ -n "$missing" ]; then echo "status=code-missing missing=${missing#,} branch=${rec_branch:-unknown}"; return 9; fi
  plan_line=$(grep -E '^handoff: plan root=' "$ledger" | tail -n 1)
  if [ -n "$plan_line" ]; then
    plan_root=$(printf '%s' "$plan_line" | sed -n 's/^handoff: plan root=\([0-9a-f]*\) .*/\1/p')
    plan_branch=$(printf '%s' "$plan_line" | sed -n 's/^handoff: plan root=[0-9a-f]* \(.*\)@[0-9a-f]*$/\1/p')
    plan_sha=$(printf '%s' "$plan_line" | sed -n 's/^handoff: plan root=[0-9a-f]* .*@\([0-9a-f]*\)$/\1/p')
    if [ "$(git -C "$REPO" rev-parse --is-shallow-repository 2>/dev/null)" != true ] && [ "$(root_of "$REPO")" != "$plan_root" ]; then
      echo "status=wrong-repo expected=${plan_root:0:7} repo=plan"; return 9
    fi
    commit_present "$REPO" "$plan_sha" || { echo "status=plan-stale sha=${plan_sha:0:7} branch=$plan_branch"; return 9; }
  fi
  echo "status=ok tasks=$tasks"
}
cmd_verify() {
  local plan="" code="" ledger copy rc line cur integ
  while [ $# -gt 0 ]; do
    case "$1" in
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] || usage
  resolve_plan "$plan"
  if [ -z "$code" ]; then
    code=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "sdd-state: not inside a code repository; pass --code-repo DIR" >&2; exit 2; }
  fi
  code=$(hp_physical_dir "$code") || { echo "sdd-state: no such directory: $code" >&2; exit 2; }
  ledger=$(ledger_path)
  # The ledger is read under the repository lock, after an interrupted sync
  # has been finished, so a completion line that arrived with the last
  # fetch is seen; a copy is what gets parsed, so the lock is short.
  hp_lock "$PLAN_DIR" || exit 2
  recover_apply || { hp_unlock; echo "status=error"; return 2; }
  if [ ! -f "$ledger" ] && [ "$BACKEND" != branch ]; then
    # Under the plain backend the dossier may still be on the state branch
    # only: bring it into the plain cache before judging it absent.
    mkdir -p "$ROOT" 2>/dev/null || true; touch "$ROOT" 2>/dev/null || true
    hp_materialize_plain "$PLAN_DIR" "$WS" "$WSDIR" || { hp_unlock; echo "status=error"; return 2; }
  fi
  if [ ! -f "$ledger" ]; then hp_unlock; echo "status=ok tasks=0"; return 0; fi
  copy=$(mktemp "${TMPDIR:-/tmp}/sdd-verify.XXXXXX") || { hp_unlock; echo "status=error"; return 2; }
  cp "$ledger" "$copy" || { rm -f "$copy"; hp_unlock; echo "status=error"; return 2; }
  hp_unlock
  line=$(plan_line_of "$copy")
  if [ -n "$line" ]; then
    cur=$(git -C "$code" branch --show-current 2>/dev/null)
    integ=$(plan_field "$line" integration)
    case "$cur" in
      ""|"$integ"|"$integ.$(ws8_of "$WS").task-"*) ;;
      *) rm -f "$copy"; echo "status=wrong-branch expected=$integ"; return 9 ;;
    esac
  fi
  verify_ledger "$copy" "$code"; rc=$?
  rm -f "$copy"
  return "$rc"
}

# --- handoff -----------------------------------------------------------------
# Snapshot for another host. Refuses an uncommitted plan file (the
# destination could not start), a dirty code tree (work would stay behind
# unnoticed) and a shallow source (its oldest commit is a fetch boundary,
# not the identity a full clone would compute); records the code
# repository's identity, and the plan repository's when it differs, as one
# write under the repository lock; pushes only with --push, after the
# configured scan over every commit the push publishes, with a lease on the
# remote tip the scan was computed against.
cmd_handoff() {
  local plan="" push=0 plan_ok=0 dirty_ok=0 code="" rel status_out dirty line code_root code_branch code_sha plan_root plan_sha plan_branch extra="" record ledger out rc sha cmd range patch err pushto remote_line remote_tip
  while [ $# -gt 0 ]; do
    case "$1" in
      --push) push=1; shift ;;
      --plan-untracked-ok) plan_ok=1; shift ;;
      --code-dirty-ok) dirty_ok=1; shift ;;
      --code-repo) [ $# -ge 2 ] || usage; code=$2; shift 2 ;;
      -*) usage ;;
      *) plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] || usage
  resolve_plan "$plan"
  rel=$(hp_plan_rel "$plan")
  if [ "$plan_ok" -eq 0 ]; then
    if ! git -C "$REPO" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 || ! git -C "$REPO" diff --quiet HEAD -- "$rel" 2>/dev/null; then
      echo "status=plan-not-committed file=$(enc "$rel")"; return 8
    fi
  fi
  if [ -z "$code" ]; then
    code=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "sdd-state: not inside a code repository; pass --code-repo DIR" >&2; exit 2; }
  fi
  code=$(hp_physical_dir "$code") || { echo "sdd-state: no such directory: $code" >&2; exit 2; }
  if [ "$dirty_ok" -eq 0 ]; then
    # A cleanliness check that could not run is not a clean tree.
    status_out=$(git -C "$code" status --porcelain 2>/dev/null) || { echo "sdd-state: git status failed in $code; the code tree's cleanliness could not be established" >&2; echo "status=error"; return 2; }
    dirty=""
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      dirty="$dirty,$(enc "${line#???}")"
    done < <(printf '%s\n' "$status_out" | grep . | head -n 3)
    if [ -n "$dirty" ]; then echo "status=code-dirty paths=${dirty#,}"; return 10; fi
  fi
  if [ "$BACKEND" != branch ]; then echo "status=plain"; return 7; fi
  # A detached checkout has no branch the other host could pull.
  code_branch=$(git -C "$code" branch --show-current 2>/dev/null)
  [ -n "$code_branch" ] || { echo "status=detached-head repo=code"; return 11; }
  if [ "$code" != "$REPO" ]; then
    plan_branch=$(git -C "$REPO" branch --show-current 2>/dev/null)
    [ -n "$plan_branch" ] || { echo "status=detached-head repo=plan"; return 11; }
  fi
  # A shallow clone's oldest commits are a fetch boundary, not the root a
  # full clone computes; the identity it would record misleads verify there.
  if [ "$(git -C "$code" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then echo "status=shallow-source repo=code"; return 12; fi
  if [ "$code" != "$REPO" ] && [ "$(git -C "$REPO" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then echo "status=shallow-source repo=plan"; return 12; fi
  code_root=$(root_of "$code"); code_sha=$(git -C "$code" rev-parse HEAD 2>/dev/null)
  [ -n "$code_root" ] && [ -n "$code_sha" ] || { echo "status=error"; return 2; }
  record=$(printf 'handoff: code root=%s %s@%s at %s from %s' "$code_root" "$code_branch" "$code_sha" "$(hp_utc_now)" "$(hostname)")
  if [ "$code" != "$REPO" ]; then
    plan_root=$(root_of "$REPO"); plan_sha=$(git -C "$REPO" rev-parse HEAD 2>/dev/null)
    [ -n "$plan_root" ] && [ -n "$plan_sha" ] || { echo "status=error"; return 2; }
    record=$(printf '%s\nhandoff: plan root=%s %s@%s' "$record" "$plan_root" "$plan_branch" "$plan_sha")
    extra=" plan=$plan_branch@${plan_sha:0:7}"
  fi
  # Everything that touches the dossier runs under the lock: an interrupted
  # sync is finished first, the record goes in as one write, and the commit,
  # the scan and the push follow with nothing else interleaving.
  hp_lock "$PLAN_DIR" || return 2
  recover_apply || { hp_unlock; echo "status=error"; return 2; }
  # The dossier must be real files inside the checkout: a plans directory,
  # workspace or ledger that is a symbolic link (one a fetched branch could
  # carry) would send the writes below outside it. hp_contained is the one
  # rule every writer shares.
  hp_contained "$CO" "plans/$WS/progress.md" || { hp_unlock; echo "status=error"; return 2; }
  mkdir -p "$WSDIR" || { hp_unlock; echo "status=error"; return 2; }
  ledger=$(ledger_path)
  if [ ! -f "$ledger" ]; then printf '%s%s\n' "$IDENTITY_PREFIX" "$rel" > "$ledger" || { hp_unlock; echo "status=error"; return 2; }; fi
  printf '%s\n' "$record" >> "$ledger" || { hp_unlock; echo "status=error"; return 2; }
  out=$(hp_commit_paths "$CO" "$BRANCH" "sdd $SLUG: handoff $(hp_utc_now)" "plans/$WS"); rc=$?
  [ "$rc" -eq 0 ] || { hp_unlock; echo "status=error"; return 2; }
  sha=$(git -C "$CO" rev-parse "refs/heads/$BRANCH")
  if hp_has_remote "$PLAN_DIR"; then pushto="$REMOTE/$BRANCH"; else pushto=none; fi
  if [ "$push" -eq 0 ] || [ "$pushto" = none ]; then
    hp_unlock
    echo "status=snapshot sha=${sha:0:7} code=$code_branch@${code_sha:0:7}$extra push=$pushto"; return 0
  fi
  # The remote tip is read now, from the remote itself, so the scan covers
  # exactly the commits this push publishes, and the push carries a lease
  # on that tip: a remote that moves in between is refused, never
  # overwritten with history the scanner did not see.
  remote_line=$(git -C "$CO" ls-remote --exit-code "$REMOTE" "refs/heads/$BRANCH" 2>/dev/null); rc=$?
  case "$rc" in
    0) remote_tip=$(printf '%s\n' "$remote_line" | cut -f1) ;;
    2) remote_tip="" ;;
    *) hp_unlock; echo "sdd-state: could not read $REMOTE" >&2; echo "status=push-failed sha=${sha:0:7}"; return 1 ;;
  esac
  if [ -n "$remote_tip" ] && ! git -C "$CO" merge-base --is-ancestor "$remote_tip" "$sha" 2>/dev/null; then
    hp_unlock; echo "sdd-state: $REMOTE/$BRANCH has moved since the last sync; run sdd-state sync first" >&2; echo "status=push-failed sha=${sha:0:7}"; return 1
  fi
  cmd=$(git -C "$PLAN_DIR" config --get hyperpowers.prePushScan 2>/dev/null || true)
  if [ -n "$cmd" ]; then
    # Every commit the push publishes: the root commit's own patch, every
    # commit the range reaches on any parent line, a merge as its diff
    # against each parent, binary content as bytes.
    if [ -n "$remote_tip" ]; then range="$remote_tip..$sha"; else range=$sha; fi
    patch=$(mktemp "${TMPDIR:-/tmp}/sdd-scan.XXXXXX") || { hp_unlock; echo "status=error"; return 2; }
    if ! git -C "$CO" log --root -p --format= --no-color -m --text "$range" -- . > "$patch" 2>/dev/null; then rm -f "$patch"; hp_unlock; echo "status=scan-failed reason=git"; return 5; fi
    if ! (cd "$CO" && HYPERPOWERS_SCAN_RANGE="$range" sh -c "$cmd" < "$patch" >&2); then rm -f "$patch"; hp_unlock; echo "status=scan-failed reason=scanner"; return 5; fi
    rm -f "$patch"
  fi
  if [ "${HYPERPOWERS_TEST_PAUSE_AT:-}" = handoff-after-scan ]; then
    : > "$CO/.handoff-paused"
    while [ -e "$CO/.handoff-pause" ]; do sleep 0.1; done
    rm -f "$CO/.handoff-paused"
  fi
  if ! err=$(git -C "$CO" push -q --force-with-lease="refs/heads/$BRANCH:$remote_tip" "$REMOTE" "$sha:refs/heads/$BRANCH" 2>&1); then
    hp_unlock
    printf '%s\n' "$err" >&2
    echo "status=push-failed sha=${sha:0:7}"; return 1
  fi
  hp_unlock
  echo "status=pushed sha=${sha:0:7} code=$code_branch@${code_sha:0:7}$extra"
}

# --- dispatch ----------------------------------------------------------------
sub=${1:-}
[ -n "$sub" ] || usage
shift
case "$sub" in
  snapshot) cmd_snapshot "$@" ;;
  import) cmd_import "$@" ;;
  claim) cmd_claim "$@" ;;
  next) cmd_next "$@" ;;
  deps) cmd_deps "$@" ;;
  register) cmd_register "$@" ;;
  finish) cmd_finish "$@" ;;
  lease) cmd_lease "$@" ;;
  prune) cmd_prune "$@" ;;
  sync) cmd_sync "$@" ;;
  verify) cmd_verify "$@" ;;
  handoff) cmd_handoff "$@" ;;
  *) usage ;;
esac
